{
  "name": "agent-branches",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/claude/**",
        "refs/heads/issue-*",
        "refs/heads/[0-9]*-*",
        "refs/heads/epic-*"
      ],
      "exclude": []
    }
  },
  "rules": [
    { "type": "creation" },
    { "type": "update" }
  ]
}
