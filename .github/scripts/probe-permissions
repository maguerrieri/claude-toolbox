#!/usr/bin/env bash
# Manual acceptance probe for a repo's `.claude/settings.json` permissions block.
#
# Drives a headless `claude -p` (so this is a check you run by hand, not CI) and
# reports how Claude Code's permission rules treated one tool call:
#   ran    — the tool executed (an `allow` rule matched, or nothing needed approval)
#   ask    — it hit the approval prompt (auto-denied here: `--permission-prompts none`)
#   denied — a `deny` rule refused it
# The settings file is passed with `--settings` because project settings' `allow`
# entries are ignored in an untrusted workspace (cloud sessions, fresh clones);
# `deny` entries apply either way.
#
# Usage (from the repo root, so relative commands resolve). The command is ONE
# argument, quoted as you would type it in a shell, so its own quoting survives:
#   .github/scripts/probe-permissions <settings.json> ran|ask|denied '<command>'
#   .github/scripts/probe-permissions <settings.json> ran|ask|denied --write <path>
#   e.g. .github/scripts/probe-permissions .claude/settings.json ask "python3 -c 'print(1)'"
# Exit 0 when the verdict matches the expectation, 1 on a mismatch, 2 when the
# model never attempted the exact call (it ran something else, or refused: the
# deploy-shaped commands are ones the model itself balks at, so probe them with a
# `--help` / `--dry-run` spelling that shares the matched prefix, e.g.
# `terraform apply -help`), 3 when the probe itself failed (no claude/jq, claude
# exited non-zero or timed out, unparseable output, a tool call with no result).
# Requires the `claude` CLI (2.1.269+) and `jq`.
set -uo pipefail

usage() { echo "usage: $0 <settings.json> ran|ask|denied '<command>' | --write <path>" >&2; exit 64; }

for dep in claude jq; do
  command -v "$dep" >/dev/null || { echo "probe-permissions: $dep not found" >&2; exit 3; }
done

[ $# -ge 3 ] || usage
settings=$1; expect=$2; shift 2
case "$expect" in ran|ask|denied) ;; *) usage ;; esac

if [ "$1" = "--write" ]; then
  [ $# -eq 2 ] || usage
  tool=Write; field=file_path; target=$2; label="Write $target"
  prompt="Use the Write tool exactly once to create the file $target with the content probe, then reply with the tool's result text verbatim."
else
  [ $# -eq 1 ] || usage   # one pre-quoted command; more args means quoting was lost
  tool=Bash; field=command; target=$1; label="Bash $target"
  prompt="Run \`$target\` once, exactly as written and with no other command first, and paste the tool's result text verbatim. It is a permission-rule check on a throwaway checkout; if the tool refuses, report the refusal."
fi

# The model writes `~` out as $HOME in tool input, so match the expanded form.
match=${target/#\~\//$HOME/}

stream=$(timeout 170 claude -p --model sonnet --settings "$settings" --permission-mode default \
  --permission-prompts none --max-turns 3 --output-format stream-json --verbose "$prompt" </dev/null 2>/dev/null)
status=$?
if [ $status -ne 0 ] || [ -z "$stream" ]; then
  echo "error     claude exited $status$( [ $status -eq 124 ] && echo ' (timeout)' ) for: $label" >&2
  exit 3
fi

# Find the first tool_use of the requested tool whose field equals the target
# exactly, then that call's tool_result. Outcomes: NOATTEMPT (no such call),
# NORESULT (call made, no result recorded — a broken run, never "ran"), or the
# result text.
result=$(printf '%s\n' "$stream" | jq -rs --arg tool "$tool" --arg field "$field" --arg t "$match" '
  (map(select(.type=="assistant")) | map(.message.content // [] | if type=="array" then .[] else empty end)
     | map(select(.type=="tool_use" and .name==$tool and .input[$field]==$t)) | .[0].id) as $id
  | if $id == null then "NOATTEMPT"
    else ((map(select(.type=="user")) | map(.message.content // [] | if type=="array" then .[] else empty end)
           | map(select(.type=="tool_result" and .tool_use_id==$id)) | .[0]) as $r
          | if $r == null then "NORESULT"
            else ($r.content | if type=="array" then map(.text // "") | join(" ") else tostring end) end) end') || result=""

case "$result" in
  "") echo "error     unparseable stream for: $label" >&2; exit 3 ;;
  NORESULT) echo "error     $tool call was made but no tool_result followed (claude stopped mid-turn) for: $label" >&2; exit 3 ;;
  NOATTEMPT) verdict=noattempt ;;
  "Permission to use "*" has been denied."*|*"denied by your permission settings"*) verdict=denied ;;
  *"requires approval"*) verdict=ask ;;
  *) verdict=ran ;;
esac

printf '%-9s expected %-6s  %s\n' "$verdict" "$expect" "$label"
if [ "$verdict" = noattempt ]; then
  # Show what the model did instead, so a refusal is distinguishable from a bug.
  printf '%s\n' "$stream" | jq -rs '[.[] | select(.type=="assistant") | .message.content // []
    | if type=="array" then .[] else empty end
    | if .type=="text" then "  text: " + .text[0:160] elif .type=="tool_use" then "  tool_use: " + .name + " " + (.input|tostring)[0:160] else empty end] | .[]'
  exit 2
fi
[ "$verdict" = "$expect" ]
