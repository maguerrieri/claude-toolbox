#!/usr/bin/env python3
"""Fail when a plugin changed in a PR without its version rising above the base.

Installs are version-gated (AGENTS.md -> Releasing): a plugin's new files reach
installs only when `version` in `plugins/<name>/.claude-plugin/plugin.json`
increases. This check enforces that for every plugin with any file differing
between BASE and HEAD: head's version must be a strictly greater valid semver
than base's. It catches a missing bump, a bump that now merely equals the base
branch's (the silent collision from #58), a bump rebased below the base branch,
and an unparseable version. New plugins only need a valid version. Stdlib only,
no dependencies.

External entries get the same rule. A marketplace entry whose `source` is an
object (provenance: a `github` source pinned to a release by `ref` and `sha`)
has no files under ./plugins/ to diff; its version lives in the other repo's
plugin.json. So for each entry whose source changes between BASE and HEAD
(added, re-pinned, or moved into or out of ./plugins/), the check reads the
version the entry installs at each side, from ./plugins/ here or by fetching
the pinned commit, and compares them as above:
- a re-pin that still installs the same commit (a `ref` label fixed, a `sha`
  added for the same commit) passes without a bump;
- when a head pin sets both `sha` and `ref`, `ref` must name that commit;
- a base pin it can't fetch (the repo gone, the commit collected) is reported
  and head is checked alone, since the PR can't fix its base.
Fetching needs network access to github.com, and a head pin it can't fetch
fails. Other source types get a `skip` line, since only `github` is fetched,
and a removed entry needs no gate. An entry or a marketplace.json it can't
parse is left to `claude plugin validate`.

Usage (from the repo root; CI passes the PR's base SHA and the merge commit):
  python3 .github/scripts/check-plugin-versions <base-ref> <head-ref>
Exit 0 if every touched plugin bumped; 1 (with FAIL lines) otherwise.
"""
import json
import os
import re
import subprocess
import sys
import tempfile

LOCAL = "./plugins/"

# The official grammar from semver.org: no leading zeros in numeric identifiers,
# no empty prerelease/build identifiers.
SEMVER = re.compile(
    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
    r"(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?"
    r"(?:\+[0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*)?$"
)


class Unchecked(Exception):
    """A source type this check can't read a version from."""


def parse(version):
    """Return a sortable tuple for a semver string, or None if unparseable."""
    match = SEMVER.match(version or "")
    if not match:
        return None
    major, minor, patch, pre = match.groups()
    # A release sorts above any prerelease of the same core; identifiers compare
    # numerically when all-digit, else as strings (numeric < alphanumeric).
    pre_key = (
        (1,)
        if pre is None
        else (0,) + tuple((0, int(p)) if p.isdigit() else (1, p) for p in pre.split("."))
    )
    return (int(major), int(minor), int(patch), pre_key)


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def show_at(ref, file_path):
    """Text of <file_path> at <ref>; None if it doesn't exist there."""
    result = subprocess.run(["git", "show", f"{ref}:{file_path}"], capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else None


def manifest_version(text):
    """Version string from plugin.json text.

    Malformed JSON, a top level that isn't an object, or a missing `version` key
    comes back as a non-semver string so the caller reports it as unparseable
    rather than skipping the plugin.
    """
    try:
        manifest = json.loads(text)
    except ValueError as exc:
        return f"<malformed plugin.json: {exc}>"
    if not isinstance(manifest, dict):
        return "<malformed plugin.json: top level is not an object>"
    return str(manifest.get("version"))


def version_at(ref, plugin):
    """Version string from plugins/<plugin>'s plugin.json at <ref>; None if it isn't there."""
    text = show_at(ref, f"plugins/{plugin}/.claude-plugin/plugin.json")
    return None if text is None else manifest_version(text)


def exists_at(ref, plugin):
    """True if plugins/<plugin>/ has any tracked file at <ref>."""
    return bool(git("ls-tree", "-r", "--name-only", ref, "--", f"plugins/{plugin}/").strip())


def marketplace_sources(ref):
    """{name: source} for the marketplace entries at <ref>: a string or an object.

    Skips any entry it can't read, and returns {} for a missing or malformed
    marketplace.json: validating those is `claude plugin validate`'s job.
    """
    try:
        entries = json.loads(show_at(ref, ".claude-plugin/marketplace.json") or "").get("plugins")
    except (ValueError, AttributeError):
        return {}
    if not isinstance(entries, list):
        return {}
    return {e["name"]: e["source"] for e in entries
            if isinstance(e, dict) and isinstance(e.get("name"), str)
            and isinstance(e.get("source"), (str, dict))}


def local_dir(source):
    """The plugins/ directory a local source names; None for any other source."""
    if isinstance(source, str) and source.startswith(LOCAL):
        return source[len(LOCAL):].strip("/") or None
    return None


def fetch_pin(source, check_ref):
    """(commit, version) for the plugin.json a `github` source pins.

    Fetches only the pinned commit (`sha`, else `ref`, else the default branch)
    into a throwaway bare repo. With <check_ref>, a `ref` set beside `sha` must
    name that same commit. Raises LookupError when it can't read the pin, or
    the `ref` disagrees.
    """
    sha, ref = source.get("sha"), source.get("ref")
    rev = sha or ref or "HEAD"
    url = f"https://github.com/{source.get('repo')}.git"
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    with tempfile.TemporaryDirectory() as scratch:
        def run(*args):
            return subprocess.run(["git", "-C", scratch, *args], capture_output=True,
                                  text=True, env=env, timeout=120)
        try:
            run("init", "-q", "--bare")
            fetched = run("fetch", "-q", "--depth", "1", url, rev)
            commit = run("rev-parse", "FETCH_HEAD").stdout.strip()
            shown = run("show", "FETCH_HEAD:.claude-plugin/plugin.json")
            # A tag's peeled line (`^{}`) carries the commit an annotated tag points at.
            listed = run("ls-remote", url, ref, f"{ref}^{{}}") if check_ref and sha and ref else None
        except subprocess.TimeoutExpired:
            raise LookupError(f"timed out reading {rev} from {url}") from None
    if fetched.returncode != 0:
        raise LookupError(f"could not fetch {rev} from {url}: {fetched.stderr.strip()}")
    if shown.returncode != 0:
        raise LookupError(f"no .claude-plugin/plugin.json at {rev} in {url}")
    if listed is not None and sha not in listed.stdout.split():
        raise LookupError(f"ref {ref} in {url} doesn't point at the pinned sha {sha}")
    return commit, manifest_version(shown.stdout)


def pinned(ref, source, check_ref=False):
    """(commit, version) that <source> installs at <ref>.

    A local source reads ./plugins/ here (commit None, version None if absent);
    a `github` source is fetched (fetch_pin). Raises Unchecked for any other
    source type.
    """
    directory = local_dir(source)
    if directory:
        return None, version_at(ref, directory)
    if isinstance(source, dict) and source.get("source") == "github":
        return fetch_pin(source, check_ref)
    raise Unchecked(json.dumps(source, sort_keys=True))


def gate(name, old, new, failures, unread=None):
    """Require head version <new> to be valid semver above base's <old>.

    <old> None means there's no base version to compare, and <new> only has to
    be valid: a new plugin, or a base this check couldn't read (<unread> says
    why, on a `skip` line).
    """
    new_key = parse(new)
    if new_key is None:
        failures.append(f"{name}: head version {new!r} is not valid semver")
    elif old is None and unread:
        print(f"skip {name}: {unread}; head checked alone at {new}")
    elif old is None:
        print(f"ok   {name}: new plugin at {new}")
    elif parse(old) is None:
        failures.append(f"{name}: base version {old!r} is not valid semver")
    elif new_key == parse(old):
        failures.append(f"{name}: head version {new} equals base's"
                        " -- missing bump, or the base branch already landed that number")
    elif new_key < parse(old):
        failures.append(f"{name}: head version {new} is below base's {old}"
                        " -- rebased over a newer base without re-bumping?")
    else:
        print(f"ok   {name}: {old} -> {new}")


def main(argv):
    if len(argv) != 3:
        sys.exit(__doc__)
    base, head = argv[1], argv[2]
    changed = git("diff", "--name-only", base, head, "--", "plugins/").split()
    old_sources, new_sources = marketplace_sources(base), marketplace_sources(head)
    # What to gate, as {label: (base source, head source)}. Every changed
    # directory under plugins/ reads its own plugin.json on both sides. An entry
    # whose source changed with an object on either side is gated from wherever
    # it pointed at base; a move into plugins/ takes the directory's label, so
    # its base is the external pin even if no file here changed.
    items = {d: (f"{LOCAL}{d}", f"{LOCAL}{d}")
             for d in {f.split("/")[1] for f in changed if f.count("/") >= 2}}
    for name, source in new_sources.items():
        old_source = old_sources.get(name)
        if old_source != source and (isinstance(source, dict) or isinstance(old_source, dict)):
            items[local_dir(source) or name] = (old_source, source)
    removed = sorted(name for name, source in old_sources.items()
                     if isinstance(source, dict) and name not in new_sources)
    failures = []
    for label in sorted(items):
        old_source, new_source = items[label]
        try:
            new_commit, new = pinned(head, new_source, check_ref=True)
        except Unchecked as exc:
            print(f"skip {label}: only github sources are version-checked, not {exc}")
            continue
        except LookupError as exc:
            failures.append(f"{label}: {exc}")
            continue
        if new is None:
            if exists_at(head, local_dir(new_source)):
                failures.append(f"{label}: plugin files changed but"
                                " .claude-plugin/plugin.json is missing on head")
            continue  # whole plugin removed on head: nothing to gate
        old_commit, old, unread = None, None, None
        if old_source is not None:
            try:
                old_commit, old = pinned(base, old_source)
            except Unchecked as exc:
                unread = f"base source {exc} isn't version-checked"
            except LookupError as exc:
                unread = f"base pin unreadable ({exc})"
        if new_commit and new_commit == old_commit:
            print(f"ok   {label}: still installs {new_commit[:12]} ({new})")
            continue
        gate(label, old, new, failures, unread)
    for name in removed:
        print(f"ok   {name}: external entry removed")
    if not items and not removed:
        print("ok   no plugin touched")
    for failure in failures:
        print(f"FAIL {failure}")
    if failures:
        print("Installs are version-gated: bump `version` in plugins/<name>/.claude-plugin/plugin.json"
              " above the base branch's, and move an external entry's pin only to a release whose"
              " plugin.json version rose (see AGENTS.md -> Releasing).")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
