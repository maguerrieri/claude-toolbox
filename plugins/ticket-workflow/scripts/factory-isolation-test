#!/usr/bin/env bash
# factory-isolation-test — the cross-repo isolation test from spec 2d / item 8b.
#
# Run it from inside a `factory-implementer-<A>` cloud session (or anywhere the
# broker is reachable). It tries every path a compromised branch has to obtain a
# token for a repository B other than the one this environment is bound to (A),
# and asserts each yields only an A-scoped token or nothing:
#
#   1. the broker called directly with `repository: B`      → a 403 refusal, or an A token
#   2. the broker called directly with no repository at all → an A token, or a 403 refusal
#      (any token these two return is checked against GitHub in step 5 — the
#      broker's own `repository` label is a claim, not proof of scope)
#   3. the helper replayed with --repo B                     → refuses with exit 4, exports nothing
#   4. the environment read for credential material         → no broker bearer, no App key
#   5. (with GitHub) the A token, minted the normal way:
#        GET  /installation/repositories  lists only A
#        GET  /repos/A                    200 (positive control)
#        GET  /repos/B                    informational only: a public B is readable by
#                                         anyone, so this proves nothing either way
#        POST /repos/B/git/blobs          401/403/404 (a write to B is rejected). A blob
#                                         create needs only contents: write and has no
#                                         input that can fail validation, so a 422 or a
#                                         2xx is a real answer, not a false negative; a
#                                         2xx would leave one dangling, unreferenced blob.
#
# Only an expected refusal passes a negative path. A transport failure, a 5xx, a
# 401 (no bearer reached the broker: the API credential is not configured), or any
# other status is reported as inconclusive and FAILS: a broker that is down or
# misconfigured must not read as isolated. --broker must be https:// (http:// on
# loopback only), the same rule the helper enforces.
#
# Usage:
#   factory-isolation-test --bound OWNER/A --foreign OWNER/B [--broker URL] [--skip-github]
#
# The foreign repo must be one the App is installed on (otherwise a 404 proves
# nothing about the token); pick the other factory repo. Output is TAP-like; exit
# 0 only when every path passes. No token or bearer is ever printed.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd -P)
helper="$here/factory-token"

BOUND=""; FOREIGN=""; BROKER="${FACTORY_BROKER_URL:-}"; SKIP_GITHUB=0
while [ $# -gt 0 ]; do
	case "$1" in
	--bound) BOUND=$2; shift 2 ;;
	--foreign) FOREIGN=$2; shift 2 ;;
	--broker) BROKER=$2; shift 2 ;;
	--skip-github) SKIP_GITHUB=1; shift ;;
	-h | --help) sed -n '2,/^set -euo pipefail/{/^set -euo pipefail/d;s/^# \{0,1\}//;p;}' "$0" >&2; exit 2 ;;
	*) echo "unknown argument: $1" >&2; exit 2 ;;
	esac
done
[ -n "$BOUND" ] && [ -n "$FOREIGN" ] || { echo "--bound and --foreign are required" >&2; exit 2; }
[ -n "$BROKER" ] || { echo "--broker or FACTORY_BROKER_URL is required" >&2; exit 2; }
BROKER=${BROKER%/}
# Same transport rule as the helper: the API-credentials proxy attaches the bearer
# to requests for this host, so it must never be plaintext except on loopback.
case "$BROKER" in
https://*) ;;
http://localhost[:/]* | http://127.0.0.1[:/]* | http://\[::1\]*) ;;
*) echo "broker URL must be https:// (http:// only for loopback): $BROKER" >&2; exit 2 ;;
esac
for tool in curl jq; do command -v "$tool" >/dev/null || { echo "$tool is required" >&2; exit 2; }; done
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
[ "$(lc "$BOUND")" != "$(lc "$FOREIGN")" ] || { echo "--bound and --foreign must differ" >&2; exit 2; }

failures=0
ok() { printf 'ok   - %s\n' "$1"; }
fail() { printf 'FAIL - %s\n' "$1"; failures=$((failures + 1)); }

work=$(mktemp -d)
chmod 700 "$work"
trap 'rm -rf "$work"' EXIT

# broker_call <body-or-empty> <outfile> → prints HTTP status; body never printed.
broker_call() {
	local body=$1 out=$2 args=(-X POST -H 'Accept: application/json')
	[ -z "$body" ] || args+=(-H 'Content-Type: application/json' --data "$body")
	curl -sS --max-time 20 -o "$out" -w '%{http_code}' "${args[@]}" "$BROKER/token" 2>/dev/null || printf '000'
}
# token_repo <file> → the repository a 200 body names, or empty
token_repo() { jq -r '.repository // empty' "$1" 2>/dev/null || true; }
has_token() { jq -e '.token | type == "string" and length > 0' "$1" >/dev/null 2>&1; }

# classify <status> <file> → prints: refused | token:<repo> | nobearer | error
# Only 403 (repository_not_bound) is the broker refusing a bound bearer's request.
# 401 means no bearer reached the broker at all — the API credential is not
# configured — which proves nothing about isolation and must not pass.
classify() {
	local status=$1 file=$2
	case "$status" in
	200) if has_token "$file"; then printf 'token:%s' "$(token_repo "$file")"; else printf 'error'; fi ;;
	403) printf 'refused' ;;
	401) printf 'nobearer' ;;
	*) printf 'error' ;;
	esac
}
# Tokens the direct paths obtain are checked against GitHub later (path 5): the
# broker's own `repository` field is a claim, not proof of the token's scope.
direct_tokens=()

# --- 1. direct call asking for B -------------------------------------------------
status=$(broker_call "$(jq -cn --arg r "$FOREIGN" '{repository: $r}')" "$work/1.json")
case "$(classify "$status" "$work/1.json")" in
refused) ok "direct call for $FOREIGN refused (HTTP 403)" ;;
"token:"*)
	if [ "$(lc "$(token_repo "$work/1.json")")" = "$(lc "$BOUND")" ]; then
		ok "direct call for $FOREIGN answered with a token the broker labels $BOUND (scope verified against GitHub below)"
		direct_tokens+=("$work/1.json")
	else
		fail "direct call for $FOREIGN yielded a token for '$(token_repo "$work/1.json")' — broker leaks across repos"
	fi ;;
nobearer) fail "direct call for $FOREIGN: HTTP 401 — no bearer reached the broker (API credential not configured?) — inconclusive" ;;
*) fail "direct call for $FOREIGN: HTTP $status is neither a refusal nor a token (broker down or misconfigured — inconclusive)" ;;
esac

# --- 2. direct call with no repository --------------------------------------------
status=$(broker_call "" "$work/2.json")
case "$(classify "$status" "$work/2.json")" in
refused) ok "direct call with no repository refused (HTTP 403)" ;;
"token:"*)
	if [ "$(lc "$(token_repo "$work/2.json")")" = "$(lc "$BOUND")" ]; then
		ok "direct call with no repository mints a token the broker labels $BOUND (scope verified against GitHub below)"
		direct_tokens+=("$work/2.json")
	else
		fail "direct call with no repository minted for '$(token_repo "$work/2.json")'"
	fi ;;
nobearer) fail "direct call with no repository: HTTP 401 — no bearer reached the broker — inconclusive" ;;
*) fail "direct call with no repository: HTTP $status is neither a refusal nor a token (inconclusive)" ;;
esac

# --- 3. helper replay for B -----------------------------------------------------------
cache="$work/cache"
rc=0
out=$(FACTORY_TOKEN_CACHE_DIR="$cache" FACTORY_BROKER_URL="$BROKER" "$helper" --repo "$FOREIGN" env 2>"$work/3.err") || rc=$?
if [ "$rc" -eq 4 ] && [ -z "$out" ] && ! ls "$cache"/*.json >/dev/null 2>&1; then
	ok "helper replayed with --repo $FOREIGN refuses (exit 4: repository not bound), exports and caches nothing"
elif [ "$rc" -eq 3 ]; then
	fail "helper replayed with --repo $FOREIGN stopped on proxy-injected mode (exit 3): M1 is not in effect here, so the replay path was not exercised"
elif [ "$rc" -eq 0 ]; then
	fail "helper replayed with --repo $FOREIGN obtained a token"
else
	fail "helper replayed with --repo $FOREIGN exited $rc ($(tr -d '\n' <"$work/3.err" | cut -c1-160)) — not the fail-closed refusal, inconclusive"
fi

# --- 4. environment read ------------------------------------------------------------------
# Broker bearers are `fb_` + 43 url-safe chars; App keys are PEM blocks. Neither may
# be in the VM: the API-credentials proxy holds the bearer, Secret Manager the key.
envdump=$(env)
if printf '%s' "$envdump" | grep -Eq '(^|=)fb_[A-Za-z0-9_-]{43}($|[^A-Za-z0-9_-])'; then
	fail "environment holds a broker-bearer-shaped value"
else
	ok "environment holds no broker-bearer-shaped value"
fi
if printf '%s' "$envdump" | grep -Eq 'BEGIN (RSA )?PRIVATE KEY'; then
	fail "environment holds a PEM private key"
else
	ok "environment holds no PEM private key"
fi
if printf '%s' "$envdump" | grep -Eq '^(FACTORY_BROKER_(BEARER|TOKEN|KEY|SECRET)|GITHUB_APP_PRIVATE_KEY|GITHUB_APP_ID)='; then
	fail "environment names a broker/App credential variable"
else
	ok "environment names no broker/App credential variable"
fi
case "${GH_TOKEN:-}" in
factory-token-required) ok "GH_TOKEN is the pass-through sentinel" ;;
proxy-injected) fail "GH_TOKEN is proxy-injected: the environment is not in pass-through mode (M1)" ;;
'') echo "# note: GH_TOKEN unset (not a cloud environment)" ;;
*) echo "# note: GH_TOKEN is set to a real value (pass-through with a preconfigured token)" ;;
esac

# --- 5. GitHub: an A token is A-only -----------------------------------------------------------
if [ "$SKIP_GITHUB" = 1 ]; then
	echo "# skipped: GitHub checks (--skip-github)"
else
	rc=0
	envline=$(FACTORY_TOKEN_CACHE_DIR="$cache" FACTORY_BROKER_URL="$BROKER" "$helper" --repo "$BOUND" env 2>"$work/5.err") || rc=$?
	if [ "$rc" -ne 0 ]; then
		fail "could not obtain an $BOUND token through the helper (exit $rc): $(tr -d '\n' <"$work/5.err" | cut -c1-200)"
	else
		# The token goes into a 0600 curl config file, never onto a command line
		# (other processes in the VM can read argv).
		cfg="$work/curl.cfg"
		(umask 077 && jq -r '"header = \"Authorization: Bearer \(.token)\""' "$cache"/*.json >"$cfg")
		gh_api() { # <method> <path> [data] → prints status; body to $work/gh.json
			local method=$1 api_path=$2 data=${3:-}
			local args=(-X "$method" -K "$cfg" -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28')
			[ -z "$data" ] || args+=(-H 'Content-Type: application/json' --data "$data")
			curl -sS --max-time 30 -o "$work/gh.json" -w '%{http_code}' "${args[@]}" "https://api.github.com$api_path" 2>/dev/null || printf '000'
		}
		s=$(gh_api GET /installation/repositories)
		if [ "$s" = 200 ]; then
			listed=$(jq -r '[.repositories[].full_name | ascii_downcase] | sort | join(",")' "$work/gh.json")
			if [ "$listed" = "$(lc "$BOUND")" ]; then ok "helper token lists exactly one repository: $BOUND"; else fail "helper token lists repositories: $listed"; fi
		else
			fail "GET /installation/repositories → HTTP $s"
		fi
		# The tokens the direct broker calls returned (paths 1–2): their real scope.
		for tf in "${direct_tokens[@]:-}"; do
			[ -n "$tf" ] || continue
			(umask 077 && jq -r '"header = \"Authorization: Bearer \(.token)\""' "$tf" >"$cfg")
			s=$(gh_api GET /installation/repositories)
			if [ "$s" = 200 ]; then
				listed=$(jq -r '[.repositories[].full_name | ascii_downcase] | sort | join(",")' "$work/gh.json")
				if [ "$listed" = "$(lc "$BOUND")" ]; then ok "direct-call token ($(basename "$tf" .json)) lists exactly one repository: $BOUND"; else fail "direct-call token ($(basename "$tf" .json)) lists repositories: $listed — the broker's repository label lied"; fi
			else
				fail "direct-call token ($(basename "$tf" .json)): GET /installation/repositories → HTTP $s"
			fi
		done
		(umask 077 && jq -r '"header = \"Authorization: Bearer \(.token)\""' "$cache"/*.json >"$cfg")
		s=$(gh_api GET "/repos/$BOUND")
		[ "$s" = 200 ] && ok "GET /repos/$BOUND → 200 (positive control)" || fail "GET /repos/$BOUND → HTTP $s (positive control failed)"
		s=$(gh_api GET "/repos/$FOREIGN")
		echo "# note: GET /repos/$FOREIGN → HTTP $s (informational: 200 is expected when $FOREIGN is public; not an isolation signal)"
		# Authorization-sensitive write: a blob create needs contents: write on B and
		# has no input that can fail validation before the permission check.
		s=$(gh_api POST "/repos/$FOREIGN/git/blobs" '{"content":"factory-isolation-test probe","encoding":"utf-8"}')
		case "$s" in
		401 | 403 | 404) ok "POST /repos/$FOREIGN/git/blobs → $s (write rejected)" ;;
		2*) fail "POST /repos/$FOREIGN/git/blobs → HTTP $s (write ACCEPTED: an $BOUND token can write to $FOREIGN; one dangling blob was created there)" ;;
		*) fail "POST /repos/$FOREIGN/git/blobs → HTTP $s (neither rejected nor accepted — inconclusive)" ;;
		esac
		rm -f "$cfg"
	fi
fi

if [ "$failures" -eq 0 ]; then
	printf '\nisolation: PASS (%s is isolated from %s)\n' "$BOUND" "$FOREIGN"
	exit 0
fi
printf '\nisolation: FAIL (%s failing path(s))\n' "$failures"
exit 1
