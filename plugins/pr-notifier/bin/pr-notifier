#!/usr/bin/env bash
# pr-notifier: wake the local Claude Code session that owns a PR when the
# owner or a configured review bot acts on it, or when it merges or closes.
# The plugin's README has the design; skills/pr-notifier/SKILL.md has the
# contract sessions rely on (the stable path and the wake prompt).
#
#   pr-notifier subscribe <owner>/<repo>#<n> [--session <id>] [--name <name>]
#   pr-notifier unsubscribe <owner>/<repo>#<n> [--session <id>]
#   pr-notifier status [--json]
#   pr-notifier check
#
# State lives in $PR_NOTIFIER_HOME (default ~/.local/state/pr-notifier), for
# the one macOS user the notifier serves: registry.json (subscriptions),
# state.json (cursors and held events), config.json (optional settings),
# notifier.log (append-only), and lock/ (held by any command that writes).
#
# Test seams: PR_NOTIFIER_GH, PR_NOTIFIER_CLAUDE, PR_NOTIFIER_PS and
# PR_NOTIFIER_OWNER_CHECK replace gh, claude, ps and owner-check.sh;
# PR_NOTIFIER_NOW fixes the clock
# (epoch seconds); PR_NOTIFIER_SOCK_DIRS (colon-separated) replaces the
# directories a live session's messaging socket is looked for in.
set -uo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd) || exit 1

home=${PR_NOTIFIER_HOME:-$HOME/.local/state/pr-notifier}
registry=$home/registry.json
state_file=$home/state.json
config_file=$home/config.json
log_file=$home/notifier.log
lock_dir=$home/lock
examine_jq=$root/lib/examine.jq
wake_jq=$root/lib/wake.jq

gh_bin=${PR_NOTIFIER_GH:-gh}
claude_bin=${PR_NOTIFIER_CLAUDE:-claude}
ps_bin=${PR_NOTIFIER_PS:-ps}
owner_check=${PR_NOTIFIER_OWNER_CHECK:-$root/scripts/owner-check.sh}

now=${PR_NOTIFIER_NOW:-$(date -u +%s)}
case $now in '' | *[!0-9]*) echo "pr-notifier: PR_NOTIFIER_NOW must be epoch seconds" >&2 && exit 2 ;; esac

usage() {
	cat >&2 <<'USAGE_EOF'
usage: pr-notifier subscribe <owner>/<repo>#<n> [--session <id>] [--name <name>]
       pr-notifier unsubscribe <owner>/<repo>#<n> [--session <id>]
       pr-notifier status [--json]
       pr-notifier check
USAGE_EOF
	exit 2
}

die() {
	echo "pr-notifier: $*" >&2
	exit 1
}

command -v jq >/dev/null 2>&1 || die "jq not found on PATH"

iso() { jq -nr --argjson t "$1" '$t | todate'; }
now_iso=$(iso "$now")
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

log() { # log <word> [k=v ...]: one line in notifier.log
	printf '%s %s\n' "$now_iso" "$*" >>"$log_file"
}

# --- settings -------------------------------------------------------------

default_bots='["copilot-pull-request-reviewer[bot]","Copilot","chatgpt-codex-connector[bot]"]'

# What one check was before checks ran every 15 seconds (#349), for the two
# waits that were one check long: a PR whose read failed is retried no sooner,
# and an unconfirmed relay's fallback waits this long. Both take five seconds
# of slack, so a check that launchd starts a moment early still counts.
slow_retry=60

setting() { # setting <key> <default>: config.json's value, else the default
	local v=
	[ -f "$config_file" ] &&
		v=$(jq -r --arg k "$1" '.[$k] | select(. != null) | if type == "array" then tojson else tostring end' "$config_file" 2>/dev/null)
	printf '%s' "${v:-$2}"
}

number_setting() { # number_setting <key> <default>: a whole number of seconds
	local v
	v=$(setting "$1" "$2")
	case $v in '' | *[!0-9]*) v=$2 ;; esac
	# Decimal, however many leading zeros: shell arithmetic reads 0500 as
	# octal, and 08 as an error.
	v=${v#"${v%%[!0]*}"}
	printf '%s' "${v:-0}"
}

load_settings() {
	review_bots=$(setting review_bots "$default_bots")
	jq -e 'type == "array" and all(.[]; type == "string")' >/dev/null 2>&1 <<<"$review_bots" ||
		review_bots=$default_bots
	sweep_interval=$(number_setting sweep_interval 300)
	hold_bound=$(number_setting hold_bound 1800)
	idle_grace=$(number_setting idle_grace 600)
	working_grace=$(number_setting working_grace 120)
	retry_window=$(number_setting retry_window 1800)
	owner_ttl=$(number_setting owner_ttl 3600)
	relay_wait=$(number_setting relay_wait 30)
	relay_model=$(setting relay_model haiku)
	local model_re='^[]A-Za-z0-9._[-]+$' # "]" first: inside brackets, a backslash doesn't escape it
	[[ $relay_model =~ $model_re ]] || relay_model=haiku
	case $(lc "$(setting relay true)") in false | 0 | no | off) relay_on=false ;; *) relay_on=true ;; esac
	# The owner's own comment text in the wake (#353): each item's at most
	# owner_text_cap characters, and the wake's at most owner_text_budget.
	case $(lc "$(setting owner_text true)") in false | 0 | no | off) owner_text=false ;; *) owner_text=true ;; esac
	owner_text_cap=$(number_setting owner_text_cap 500)
	[ "$owner_text_cap" -ge 20 ] || owner_text_cap=20
	owner_text_budget=$(number_setting owner_text_budget 4000)
	case $(lc "$(setting drop_comment true)") in false | 0 | no | off) drop_comment=false ;; *) drop_comment=true ;; esac
	case $(lc "$(setting pr_poll true)") in false | 0 | no | off) pr_poll_on=false ;; *) pr_poll_on=true ;; esac
	pr_poll_interval=$(number_setting pr_poll_interval 15)
	[ "$pr_poll_interval" -ge 5 ] || pr_poll_interval=5
	graphql_reserve=$(number_setting graphql_reserve 1000)
	rest_reserve=$(number_setting rest_reserve 1000)
	# The PATH every claude the notifier runs gets. A resumed session keeps
	# its waker's PATH as its tool PATH (the spike's Trap 2), so a resume
	# passes the session's own recorded PATH in front of this one
	# (resume_path); everything else runs under this alone.
	wake_path=$(setting wake_path "$PATH")
}

# --- files and the lock ---------------------------------------------------

run_tmp=
cleanup() {
	[ -z "$run_tmp" ] || rm -rf "$run_tmp"
	[ "${have_lock:-}" != 1 ] || rm -rf "$lock_dir"
}
trap cleanup EXIT

older_than() { [ -n "$(find "$1" -maxdepth 0 -mmin +"$2" 2>/dev/null)" ]; } # older_than <path> <minutes>
older_than_a_minute() { older_than "$1" 1; }

take_over() { # take_over <the dead holder's pid, or "" for none>: removes a dead holder's lock
	# Takeovers run one at a time, and each re-reads the holder inside its own
	# turn, so two contenders that both saw the dead holder can't both remove
	# the lock: the second sees the first's live pid and leaves it.
	if ! mkdir "$lock_dir.takeover" 2>/dev/null; then
		! older_than_a_minute "$lock_dir.takeover" || rmdir "$lock_dir.takeover" 2>/dev/null
		return
	fi
	if [ "$(cat "$lock_dir/pid" 2>/dev/null)" = "$1" ]; then
		if [ -n "$1" ] || older_than_a_minute "$lock_dir"; then
			rm -rf "$lock_dir"
		fi
	fi
	rmdir "$lock_dir.takeover"
}

have_lock=
lock() { # lock <seconds to wait>: 0 once held, 1 if another command holds it
	local waited=0 holder
	mkdir -p "$home" || die "can't create $home"
	while ! mkdir "$lock_dir" 2>/dev/null; do
		holder=$(cat "$lock_dir/pid" 2>/dev/null)
		if [ -n "$holder" ] && { ! kill -0 "$holder" 2>/dev/null || older_than "$lock_dir" 30; }; then
			# Its holder died, or held it far longer than any command runs: a
			# dead holder whose pid another process now has.
			take_over "$holder"
			! mkdir "$lock_dir" 2>/dev/null || break
		elif [ -z "$holder" ] && older_than_a_minute "$lock_dir"; then
			take_over "" # a holder that died between mkdir and writing its pid
			! mkdir "$lock_dir" 2>/dev/null || break
		fi
		[ "$waited" -lt "$1" ] || return 1
		sleep 1
		waited=$((waited + 1))
	done
	have_lock=1
	echo $$ >"$lock_dir/pid"
}

load_files() { # copies registry and state into run_tmp, creating them when missing
	run_tmp=$(mktemp -d "${TMPDIR:-/tmp}/pr-notifier.XXXXXX") || die "can't make a temp dir"
	work_registry=$run_tmp/registry.json
	work_state=$run_tmp/state.json
	if [ -f "$registry" ]; then
		jq -e '.subscriptions | type == "array"' "$registry" >/dev/null 2>&1 ||
			die "$registry isn't a registry; fix or remove it"
		cp "$registry" "$work_registry"
	else
		printf '%s\n' '{"version":1,"subscriptions":[]}' >"$work_registry"
	fi
	if [ -f "$state_file" ]; then
		jq -e 'type == "object"' "$state_file" >/dev/null 2>&1 ||
			die "$state_file isn't a state file; fix or remove it"
		cp "$state_file" "$work_state"
	else
		printf '%s\n' '{"version":1,"feed":{},"prs":{},"pending":{},"owners":{}}' >"$work_state"
	fi
}

save() { # save <work file> <destination>: atomic replace
	cp "$1" "$2.new.$$" && mv -f "$2.new.$$" "$2" || die "can't write $2"
}

save_files() {
	save "$work_registry" "$registry"
	save "$work_state" "$state_file"
}

edit() { # edit <file> <jq args...>: rewrites the file through jq
	local f=$1
	shift
	jq "$@" "$f" >"$f.new" && mv -f "$f.new" "$f"
}

# --- references -----------------------------------------------------------

ref_re='^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+#[0-9]+$'
session_re='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

parse_ref() { # parse_ref <ref>: prints the lowercased ref, or fails
	[[ $1 =~ $ref_re ]] || return 1
	case ${1%#*} in */*/* | */. | */..) return 1 ;; esac
	lc "$1"
}

short() { printf '%s' "${1:0:8}"; }

# --- subscribe / unsubscribe / status --------------------------------------

cmd_subscribe() {
	local ref= sid=${CLAUDE_CODE_SESSION_ID:-} name= have_name= cfg=${CLAUDE_CONFIG_DIR:-}
	while [ $# -gt 0 ]; do
		case $1 in
		--session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
		--name) [ $# -ge 2 ] || usage; name=$2; have_name=1; shift 2 ;;
		-*) usage ;;
		*) [ -z "$ref" ] || usage; ref=$1; shift ;;
		esac
	done
	[ -n "$ref" ] || usage
	ref=$(parse_ref "$ref") || die "'$ref' isn't <owner>/<repo>#<n>"
	[ -n "$sid" ] || die "no session id: run this from a Claude Code session (CLAUDE_CODE_SESSION_ID) or pass --session"
	[[ $sid =~ $session_re ]] || die "'$sid' isn't a full session id"
	sid=$(lc "$sid")
	# Setting CLAUDE_CONFIG_DIR to the default root explicitly isn't the
	# default root (the spike's Trap 3), so that value is recorded as unset.
	cfg=${cfg%/}
	[ "$cfg" != "$HOME/.claude" ] || cfg=
	if [ -z "$have_name" ]; then
		# Best-effort: the name is for the log and status only.
		name=$("$claude_bin" agents --json --all 2>/dev/null </dev/null |
			jq -r --arg s "$sid" '[.[]? | select(.sessionId == $s) | .name // empty] | last // empty' 2>/dev/null)
	fi
	load_settings
	lock 300 || die "another pr-notifier command has held $lock_dir for five minutes; try again"
	load_files
	# Two minutes of slack, so clock skew can't put a reply just after the
	# subscribe before it; a repeated event is harmless (the wake prompt).
	# The caller's PATH is the session's own tool PATH when the session runs
	# subscribe itself, from its Bash tool, and a resume carries it back in
	# (the spike's Trap 2). It is the session's, so every one of its
	# subscriptions gets the latest. A subscribe for another session (--session
	# from a shell or another session) records no PATH: the caller's isn't the
	# session's, so the one already recorded stays.
	local own_path=
	[ "$sid" != "$(lc "${CLAUDE_CODE_SESSION_ID:-}")" ] || own_path=${PATH:-}
	edit "$work_registry" --arg pr "$ref" --arg sid "$sid" --arg name "$name" --arg cfg "$cfg" \
		--arg at "$(iso $((now - 120)))" --arg path "$own_path" '
		(.subscriptions | map(select(.pr == $pr and .session_id == $sid)) | first) as $old
		| (if $path == "" then ([.subscriptions[] | select(.session_id == $sid) | .path | strings] | last)
		   else $path end) as $p
		| .subscriptions = [.subscriptions[] | select((.pr == $pr and .session_id == $sid) | not)
		                    | if .session_id == $sid then .path = $p else . end]
			+ [{pr: $pr, session_id: $sid, name: $name,
			    config_dir: (if $cfg == "" then null else $cfg end),
			    path: $p,
			    subscribed_at: ($old.subscribed_at // $at)}]' || die "can't update the registry"
	save "$work_registry" "$registry"
	log "subscribe pr=$ref session=$(short "$sid") name=$(jq -rn --arg n "$name" '$n | @json') root=${cfg:-default} path=$(if [ -n "$own_path" ]; then printf '%s' "$own_path" | awk -F: '{ print NF " entries" }' | tr ' ' _; else echo kept; fi)"
	echo "pr-notifier: subscribed $(short "$sid") to $ref"
}

cmd_unsubscribe() {
	local ref= sid=${CLAUDE_CODE_SESSION_ID:-}
	while [ $# -gt 0 ]; do
		case $1 in
		--session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
		-*) usage ;;
		*) [ -z "$ref" ] || usage; ref=$1; shift ;;
		esac
	done
	[ -n "$ref" ] || usage
	ref=$(parse_ref "$ref") || die "'$ref' isn't <owner>/<repo>#<n>"
	[ -n "$sid" ] || die "no session id: run this from a Claude Code session (CLAUDE_CODE_SESSION_ID) or pass --session"
	[[ $sid =~ $session_re ]] || die "'$sid' isn't a full session id"
	sid=$(lc "$sid")
	lock 300 || die "another pr-notifier command has held $lock_dir for five minutes; try again"
	load_files
	unsubscribe "$ref" "$sid" requested
	save_files
	echo "pr-notifier: unsubscribed $(short "$sid") from $ref"
}

unsubscribe() { # unsubscribe <ref> <session id> <reason>: drops the subscription and its held events
	local ref=$1 sid=$2
	jq -e --arg pr "$ref" --arg sid "$sid" 'any(.subscriptions[]; .pr == $pr and .session_id == $sid)' \
		"$work_registry" >/dev/null || return 0
	edit "$work_registry" --arg pr "$ref" --arg sid "$sid" \
		'.subscriptions = [.subscriptions[] | select((.pr == $pr and .session_id == $sid) | not)]'
	edit "$work_state" --arg pr "$ref" --arg sid "$sid" --slurpfile reg "$work_registry" '
		if .pending[$sid] then
			.pending[$sid].events = [.pending[$sid].events[] | select(.pr != $pr)]
			| if (.pending[$sid].events | length) == 0 then .pending |= del(.[$sid]) else . end
		else . end
		| if any($reg[0].subscriptions[]; .pr == $pr) then . else .prs |= del(.[$pr]) end'
	log "unsubscribe pr=$ref session=$(short "$sid") reason=$3"
}

cmd_status() {
	local json=
	case ${1:-} in --json) json=1 ;; '') ;; *) usage ;; esac
	local reg='{"subscriptions":[]}' st='{}'
	[ ! -f "$registry" ] || reg=$(cat "$registry")
	[ ! -f "$state_file" ] || st=$(cat "$state_file")
	load_settings
	if [ -n "$json" ]; then
		jq -n --argjson reg "$reg" --argjson st "$st" \
			'{subscriptions: $reg.subscriptions, pending: ($st.pending // {}), feed: ($st.feed // {}), pr_poll: ($st.pr_poll // {})}'
		return
	fi
	jq -nr --argjson reg "$reg" --argjson st "$st" --argjson now "$now" --argjson bound "$hold_bound" --arg on "$pr_poll_on" '
		def ago($t): "\((($now - $t) / 60) | floor)m";
		($st.pending // {}) as $p
		| "pr-notifier: \($reg.subscriptions | length) subscription(s), \($p | length) session(s) with held events",
		  ($reg.subscriptions[] | "subscription \(.pr) session=\(.session_id[0:8]) name=\(.name | @json) root=\(.config_dir // "default") since=\(.subscribed_at) path=\(if (.path | type) == "string" then "recorded" else "none" end)"),
		  ($p | to_entries[] | "held session=\(.key[0:8]) events=\(.value.events | length) for=\(ago(.value.first_at)) last=\(.value.last_hold // "none")\(if $now - .value.first_at >= $bound then " STALE" else "" end)"),
		  (($st.feed // {}) | "feed last=\(.last_poll_iso // "never") status=\(.last_status // "none")"),
		  (($st.pr_poll // {}) | if $on != "true" then "pr-poll off"
		    else "pr-poll last=\(.last_iso // "never") status=\(.last_status // "none") mode=\(.mode // "normal") prs=\(.prs // 0) unread=\(.unread // 0) cost=\(.cost // "?") remaining=\(.remaining // "?")/\(.limit // "?") next=\(if (.next_at // 0) > 0 then (.next_at | todate) else "now" end)" end)'
}

# --- check: the feed --------------------------------------------------------

poll_feed() { # marks subscribed PRs whose notification thread moved as dirty
	local next lm since raw status interval body_start body
	next=$(jq -r '.feed.next_poll_at // 0' "$work_state")
	# Not logged: a check runs every 15 seconds, and this skip is most of them.
	[ "$now" -ge "$next" ] || return 0
	lm=$(jq -r '.feed.last_modified // empty' "$work_state")
	since=$(jq -r '.feed.since // empty' "$work_state")
	# The URL stays the same between 200s, so If-Modified-Since can answer 304.
	[ -n "$since" ] || since=$(iso $((now - 86400)))
	raw=$run_tmp/feed.raw
	if [ -n "$lm" ]; then
		"$gh_bin" api -i -H "If-Modified-Since: $lm" "notifications?all=true&per_page=50&since=$since" \
			</dev/null >"$raw" 2>"$run_tmp/feed.err"
	else
		"$gh_bin" api -i "notifications?all=true&per_page=50&since=$since" </dev/null >"$raw" 2>"$run_tmp/feed.err"
	fi
	tr -d '\r' <"$raw" >"$raw.lf"
	status=$(awk 'NR == 1 { print $2; exit }' "$raw.lf")
	interval=$(awk -F': *' 'tolower($1) == "x-poll-interval" { print $2; exit }' "$raw.lf")
	case $interval in '' | *[!0-9]*) interval=60 ;; esac
	edit "$work_state" --arg s "${status:-none}" --arg iso "$now_iso" --argjson next $((now + interval)) \
		'.feed += {last_status: $s, last_poll_iso: $iso, next_poll_at: $next}'
	case $status in
	304)
		log "poll status=304"
		return 0
		;;
	200) ;;
	*)
		log "poll error status=${status:-none} detail=$(head -c 200 "$run_tmp/feed.err" | jq -Rrs '@json')"
		return 1
		;;
	esac
	body_start=$(awk 'NF == 0 { print NR + 1; exit }' "$raw.lf")
	body=$run_tmp/feed.json
	tail -n +"${body_start:-1}" "$raw.lf" >"$body"
	if grep -qi '^link:.*rel="next"' "$raw.lf"; then
		# More than one page: read them all, unconditionally.
		"$gh_bin" api --paginate --slurp "notifications?all=true&per_page=50&since=$since" </dev/null \
			>"$body.all" 2>>"$run_tmp/feed.err" && jq 'flatten' "$body.all" >"$body.flat" && mv -f "$body.flat" "$body" ||
			log "poll error detail=\"later pages unreadable; first page only\""
	fi
	jq -e 'type == "array"' "$body" >/dev/null 2>&1 || {
		log "poll error detail=\"body isn't a thread list\""
		return 1
	}
	local lm_new matched
	lm_new=$(awk -F': *' 'tolower($1) == "last-modified" { sub(/^[^:]*: */, ""); print; exit }' "$raw.lf")
	# A subscribed PR's thread marks it to be read only when its updated_at
	# moved past the one last seen: since repeats for up to an hour, so the
	# same thread comes back on every 200 until then.
	jq -c --slurpfile reg "$work_registry" '
		($reg[0].subscriptions | map(.pr) | unique) as $subs
		| [ .[] | select(.subject.type? == "PullRequest")
			| (.updated_at // "") as $at
			| (.subject.url // "") | capture("/repos/(?<p>[^/]+/[^/]+)/pulls/(?<n>[0-9]+)$")?
			| {pr: "\(.p | ascii_downcase)#\(.n)", at: $at} | select(.pr as $r | $subs | index($r)) ]
		| group_by(.pr) | map(max_by(.at))' "$body" >"$run_tmp/threads.json"
	# since moves at most hourly, so the URL usually repeats and a quiet poll
	# can still be a 304; when it moves, it goes to a little before this poll,
	# since a thread's updated_at can trail its event.
	local since_epoch matched
	since_epoch=$(jq -nr --arg s "$since" '$s | try fromdateiso8601 catch 0')
	[ $((now - since_epoch)) -lt 3600 ] || since=$(iso $((now - 300)))
	# A thread that moved doesn't mark a PR that was read ten seconds or more
	# after the thread's updated_at (by the direct poll, usually): that read
	# already saw what moved it, so another would find nothing.
	local skipped
	read -r matched skipped <<<"$(jq -r --slurpfile st "$work_state" '
		[.[] | select(.at == "" or .at > ($st[0].prs[.pr].thread_at // ""))
		 | . + {skip: ((.at | try fromdateiso8601 catch null) as $e
		               | $e != null and (($st[0].prs[.pr].last_swept // 0) >= $e + 10))}]
		| "\(map(select(.skip | not)) | length) \(map(select(.skip)) | length)"' "$run_tmp/threads.json")"
	edit "$work_state" --arg lm "$lm_new" --arg since "$since" --slurpfile th "$run_tmp/threads.json" '
		.feed += {last_modified: (if $lm == "" then null else $lm end), since: $since}
		| reduce $th[0][] as $t (.;
			if $t.at == "" or $t.at > (.prs[$t.pr].thread_at // "") then
				($t.at | try fromdateiso8601 catch null) as $e
				| if $e != null and ((.prs[$t.pr].last_swept // 0) >= $e + 10) then .prs[$t.pr].thread_at = $t.at
				  else .prs[$t.pr] += {dirty: true, thread_at: $t.at} end
			else . end)'
	log "poll status=200 threads=$(jq length "$body") matched=$matched$([ "${skipped:-0}" = 0 ] || echo " read-already=$skipped")"
}

# --- check: the subscribed PRs, read directly ---------------------------------

# The notifications feed can't be read more often than once a minute
# (X-Poll-Interval), but a PR can. So every pass also reads a summary of each
# subscribed PR, all of them in one GraphQL query (one per hundred PRs), and
# marks a PR whose summary moved, as the feed does. The summary is the PR's
# state, its updatedAt, its comment count and newest comment update (which an
# edit moves too), and its review count and newest review: a reply in a review
# thread is a review of its own, so the count moves for line comments and
# replies as well. Reading the PR still decides what woke whom (examine): the
# summary only says which PRs to read now rather than at the feed's or the
# sweep's pace.
pr_poll_chunk=100

# The one grammar the direct poll reads a ref by, in pr_poll_refs and in the
# query it builds, so the query's aliases and the result's indexes line up.
# GraphQL's Int is 32 bits, so a PR number past 2147483647 (a typo subscribe
# accepted) would fail its whole query; pr_poll_refs leaves it out, to examine,
# whose REST read reports it.
summary_ref_re='^(?<o>[^/#\n]+)/(?<r>[^/#\n]+)#(?<n>[0-9]{1,10})$'

pr_poll_refs() { # the subscribed PRs the direct poll can ask for, one a line
	jq -r --arg re "$summary_ref_re" '.subscriptions | map(.pr) | unique | .[]
		| select(type == "string" and test($re)) | select((capture($re).n | tonumber) <= 2147483647)' "$work_registry"
}

pr_summary_query() { # pr_summary_query <refs file>: the GraphQL request body for those PRs
	jq -Rn --arg re "$summary_ref_re" '[inputs | select(length > 0) | capture($re)] as $refs
		| ($refs | length) as $k
		| {query: ("query(" + ([range(0; $k) | "$o\(.):String!,$r\(.):String!,$n\(.):Int!"] | join(","))
		     + "){rateLimit{cost remaining limit resetAt} "
		     + ([range(0; $k) | "p\(.):repository(owner:$o\(.),name:$r\(.)){pullRequest(number:$n\(.)){...s}}"] | join(" "))
		     + "} fragment s on PullRequest{state updatedAt mergedAt closedAt"
		     + " comments(first:1,orderBy:{field:UPDATED_AT,direction:DESC}){totalCount nodes{updatedAt}}"
		     + " reviews(last:1){totalCount nodes{id updatedAt}}}"),
		   variables: (reduce range(0; $k) as $i ({};
		     . + {"o\($i)": $refs[$i].o, "r\($i)": $refs[$i].r, "n\($i)": ($refs[$i].n | tonumber)}))}' "$1"
}

poll_prs() { # marks subscribed PRs whose summary moved as dirty, at most every pr_poll_interval
	[ "$pr_poll_on" = true ] || return 0
	local next f n=0 ok=0 bad=0 limited= detail= moved rechecks prev mode pace failures delay cost remaining limit reset unread
	local rest rest_reset rest_low=false was_low prev_reset part_at
	read -r next was_low prev failures prev_reset part_at <<<"$(jq -r '.pr_poll // {}
		| "\(.next_at // 0 | floor) \(.rest_low // false) \(.mode // "normal") \(.failures // 0 | floor) \(.reset_at // 0 | floor) \(.part_logged_at // 0 | floor)"' "$work_state")"
	[ "$now" -ge "$next" ] || return 0
	pr_poll_refs | awk -v n="$pr_poll_chunk" -v d="$run_tmp" '{ print > (d "/poll-chunk." int((NR - 1) / n)) }'
	: >"$run_tmp/poll-fps"
	: >"$run_tmp/poll-rates"
	for f in "$run_tmp"/poll-chunk.*; do
		[ -f "$f" ] || continue
		n=$((n + $(wc -l <"$f")))
		pr_summary_query "$f" >"$f.body"
		"$gh_bin" api graphql --input "$f.body" </dev/null >"$f.out" 2>"$f.err"
		# gh exits 1 when a PR can't be resolved (deleted, or out of reach) and
		# still prints the rest, so the data decides, not the exit code. A PR
		# that reads null is left to examine, which reports one that stays
		# unreadable.
		if jq -e '(.data | type) == "object" and (.data.rateLimit | type) == "object"' "$f.out" >/dev/null 2>&1; then
			ok=$((ok + 1))
			jq -c --arg refs "$(cat "$f")" '($refs | split("\n") | map(select(length > 0))) as $r | .data as $d
				| range(0; $r | length) as $i | ($d["p\($i)"].pullRequest? // null) as $p
				| {pr: $r[$i], fp: (if $p == null then null
				    else [$p.state, $p.updatedAt, $p.mergedAt, $p.closedAt,
				          $p.comments.totalCount, $p.comments.nodes[0].updatedAt?,
				          $p.reviews.totalCount, $p.reviews.nodes[0].id?, $p.reviews.nodes[0].updatedAt?] | tojson end)}' \
				"$f.out" >>"$run_tmp/poll-fps"
			jq -c '.data.rateLimit | {cost: (.cost // 1), remaining: (.remaining // 0), limit: (.limit // 0),
				reset: ((.resetAt // "") | try fromdateiso8601 catch 0)}' "$f.out" >>"$run_tmp/poll-rates"
		else
			bad=$((bad + $(wc -l <"$f")))
			detail=$(head -n 1 "$f.err")
			[ -n "$detail" ] || detail=$(jq -r '[.errors[]?.message] | first // empty' "$f.out" 2>/dev/null)
			# The hourly limit only. A secondary limit ("You have exceeded a
			# secondary rate limit") clears in about a minute, so it takes the
			# ordinary backoff, whatever error type it comes with.
			if { grep -i 'API rate limit exceeded' "$f.err" 2>/dev/null | grep -qvi secondary; } ||
				jq -e 'any(.errors[]?; .type == "RATE_LIMITED" and ((.message // "") | test("secondary"; "i") | not))' \
					"$f.out" >/dev/null 2>&1; then
				limited=1
			fi
		fi
	done
	[ "$n" -gt 0 ] || return 0
	# A summary that moved, or that wasn't recorded yet, marks the PR. A PR
	# marked so is marked once more on the next poll (rechecks): the summary
	# can show an item a moment before the REST timeline examine reads does,
	# and once recorded, an unchanged summary would mark it no more. A second
	# read 15 seconds on is long past that lag, and the feed then skips the
	# PR (poll_feed), so an event still costs two reads.
	read -r moved rechecks <<<"$(jq -r --slurpfile fps "$run_tmp/poll-fps" '. as $st
		| [$fps[] | select(.fp != null)] as $f
		| "\([$f[] | select($st.prs[.pr].fp != .fp) | .pr] | join(",")) \([$f[] | select($st.prs[.pr].fp == .fp and $st.prs[.pr].recheck == true) | .pr] | join(","))"' \
		"$work_state")"
	# Each PR it marks costs a REST read (the PR, its timeline, owner checks),
	# a budget of its own. The rate_limit endpoint costs none, so with
	# rest_reserve requests or fewer left, nothing is marked and nothing
	# recorded: the next poll marks them once the budget is back, and the feed
	# and the sweep carry on meanwhile. A budget it can't read keeps the state
	# it had.
	rest_low=$was_low
	if [ -n "$moved$rechecks" ] || [ "$was_low" = true ]; then
		read -r rest rest_reset <<<"$("$gh_bin" api rate_limit --jq '.resources.core | "\(.remaining) \(.reset)"' </dev/null 2>/dev/null)"
		if [[ $rest =~ ^[0-9]+$ ]]; then
			if [ "$rest" -le "$rest_reserve" ]; then
				rest_low=true
				[ "$was_low" = true ] ||
					log "poll-prs rest-low remaining=$rest reserve=$rest_reserve reset=$(if [[ $rest_reset =~ ^[0-9]+$ ]]; then iso "$rest_reset"; else echo unknown; fi) held=$moved"
			else
				rest_low=false
				[ "$was_low" != true ] || log "poll-prs rest-ok remaining=$rest"
			fi
		fi
	fi
	unread=$(jq -s '[.[] | select(.fp == null)] | length' "$run_tmp/poll-fps")
	[ "$rest_low" = true ] || edit "$work_state" --slurpfile fps "$run_tmp/poll-fps" '
		reduce ($fps[] | select(.fp != null)) as $x (.;
			if .prs[$x.pr].fp != $x.fp then .prs[$x.pr] += {fp: $x.fp, dirty: true, recheck: true}
			elif .prs[$x.pr].recheck == true then .prs[$x.pr] |= (.dirty = true | del(.recheck))
			else . end)'
	if [ "$ok" -eq 0 ]; then
		# The feed and the sweep still run, so a failed poll backs off: 30
		# seconds, then a minute, two and four, then every five (or every
		# pr_poll_interval, past five minutes, so a failing poll never runs
		# faster than a healthy one), and past the hour's reset when the
		# hourly rate limit is what failed it.
		failures=$((failures + 1))
		delay=$(jq -n --argjson e "$pr_poll_interval" --argjson k "$failures" '[$e * pow(2; $k), ([300, $e] | max)] | min | floor')
		next=$((now + delay))
		[ -z "$limited" ] || [ "$prev_reset" -le "$next" ] || next=$((prev_reset + 1))
		edit "$work_state" --argjson k "$failures" --argjson next "$next" --arg iso "$now_iso" --argjson low "$rest_low" \
			'.pr_poll += {mode: "failing", failures: $k, next_at: $next, last_iso: $iso, last_status: "error", rest_low: $low}'
		log "poll-prs error prs=$n failures=$failures${limited:+ rate-limited} next=$(iso "$next") detail=$(printf '%s' "$detail" | head -c 200 | jq -Rrs '@json')"
		return 1
	fi
	# Some of the queries read (past a hundred PRs): those set the pace, and a
	# failed one is logged at most every five minutes.
	if [ "$bad" -gt 0 ] && [ $((now - part_at)) -ge 300 ]; then
		log "poll-prs error prs=$bad of=$n detail=$(printf '%s' "$detail" | head -c 200 | jq -Rrs '@json')"
		part_at=$now
	fi
	read -r cost remaining limit reset <<<"$(jq -rs '"\(map(.cost) | add) \(map(.remaining) | min) \(map(.limit) | max) \(map(.reset) | max)"' "$run_tmp/poll-rates")"
	# Every request on the token, the sessions' own included, counts against
	# the one hourly budget, so the poll leaves graphql_reserve points to them:
	# it slows down to spread what's left above the reserve over the time to
	# the reset, and stops until the reset once nothing is left above it. A
	# reset it can't read, or one already past, counts as an hour away, the
	# window's length. The job fires every 15 seconds, so the pace rounds to
	# its firings: three seconds of slack keep a pace of 15 from skipping every
	# other one, so a pace up to 18 polls every 15 seconds, and one from 19 to
	# 33 every 30.
	[ "$reset" -gt "$now" ] || reset=$((now + 3600))
	read -r next mode pace <<<"$(jq -rn --argjson now "$now" --argjson every "$pr_poll_interval" --argjson reserve "$graphql_reserve" \
		--argjson cost "$cost" --argjson rem "$remaining" --argjson reset "$reset" '
		def slack($p): [3, ($p / 3 | floor)] | min;
		([$cost, 1] | max) as $c | ($rem - $reserve) as $spare
		| if $spare < $c then ([$reset + 1, $now + $every] | max) as $at | "\($at) paused \($at - $now)"
		  else ((($reset - $now) / (($spare / $c) | floor)) | ceil) as $need
		    | if $need > $every then "\($now + $need - slack($need)) stretched \($need)"
		      else "\($now + $every - slack($every)) normal \($every)" end
		  end')"
	edit "$work_state" --argjson next "$next" --arg mode "$mode" --arg iso "$now_iso" --argjson n "$n" \
		--argjson unread "$unread" --argjson cost "$cost" --argjson rem "$remaining" --argjson limit "$limit" --argjson reset "$reset" \
		--argjson low "$rest_low" --argjson part "$part_at" '.pr_poll = {mode: $mode, failures: 0, next_at: $next,
			last_iso: $iso, last_status: "ok", prs: $n, unread: $unread, cost: $cost, remaining: $rem, limit: $limit,
			reset_at: $reset, rest_low: $low, part_logged_at: $part}'
	# Logged only when it marks a PR or changes pace: a line every pass would
	# be 5,760 a day. A recheck isn't logged.
	[ -z "$moved" ] || [ "$rest_low" = true ] || log "poll-prs prs=$n moved=$moved cost=$cost remaining=$remaining"
	[ "$mode" = "$prev" ] || log "poll-prs mode=$mode was=$prev every=${pace}s remaining=$remaining reserve=$graphql_reserve reset=$(iso "$reset")"
}

# --- check: examining a PR ------------------------------------------------

my_login= # read once per run, never cached across runs: owner-check reads it
# live too, and the two must agree on who the sessions are
read_my_login() {
	[ -n "$my_login" ] && return 0
	my_login=$("$gh_bin" api user --jq .login </dev/null 2>/dev/null) || my_login=
	[ -n "$my_login" ]
}

owner_status() { # owner_status <owner>/<repo> <login>: owner-check's exit code
	local key code
	key="$1:$(lc "$2")"
	if [ $((now - $(jq -r --arg k "$key" '.owners[$k] // 0' "$work_state"))) -lt "$owner_ttl" ]; then
		echo 0
		return
	fi
	code=$(awk -v k="$key" '$1 == k { print $2; exit }' "$run_tmp/owner-memo" 2>/dev/null)
	if [ -z "$code" ]; then
		OWNER_CHECK_GH=$gh_bin bash "$owner_check" -R "$1" "$2" </dev/null >/dev/null 2>>"$run_tmp/owner-check.err"
		code=$?
		printf '%s %s\n' "$key" "$code" >>"$run_tmp/owner-memo"
		# Only a yes is cached: a no may be a failed read, retried next time.
		[ "$code" -ne 0 ] || edit "$work_state" --arg k "$key" --argjson t "$now" '.owners[$k] = $t'
	fi
	echo "$code"
}

check_owners() { # check_owners <owner>/<repo> <phase> <examine.jq args...>: owner checks for the logins that phase prints
	# Adds each result to the caller's owners ({lowercased login: exit code}).
	local repo=$1 phase=$2 login
	shift 2
	while IFS= read -r login; do
		[ -n "$login" ] || continue
		owners=$(jq -c --arg l "$(lc "$login")" --argjson c "$(owner_status "$repo" "$login")" '.[$l] = $c' <<<"$owners")
	done < <(jq -nr --arg phase "$phase" --argjson owners "$owners" "$@" -f "$examine_jq")
}

edit_authors() { # edit_authors <out file>, node ids on stdin: writes {node id: {edited_at, body, login, type}} for each node GraphQL returns
	# login and type are there only when GraphQL names an editor; edited_at
	# is null for an item never edited, and body is its text as that same
	# read found it. A node the read missed has no entry. GitHub takes at
	# most 100 ids a query, so they go a hundred at a time, and a query that
	# fails costs only its own hundred. The result goes to a file: bodies can
	# be too long for an argument.
	local out=$1 ids=() id i=0 k=0 args
	while IFS= read -r id; do
		[[ $id =~ ^[A-Za-z0-9_=-]+$ ]] && ids+=("$id")
	done
	while [ "$i" -lt "${#ids[@]}" ]; do
		args=()
		for id in "${ids[@]:$i:100}"; do args+=(-f "ids[]=$id"); done
		"$gh_bin" api graphql "${args[@]}" -f query='query($ids:[ID!]!){nodes(ids:$ids){
			... on IssueComment{id lastEditedAt body editor{login __typename}}
			... on PullRequestReview{id lastEditedAt body editor{login __typename}}
			... on PullRequestReviewComment{id lastEditedAt body editor{login __typename}}}}' \
			--jq '[.data.nodes[]? | select(type == "object" and (.id | type) == "string")
				| {(.id): ({edited_at: .lastEditedAt, body: .body}
					+ if .editor != null then {login: .editor.login, type: (if .editor.__typename == "Bot" then "Bot" else "User" end)} else {} end)}]
				| add // {}' \
			</dev/null >"$out.c$k" 2>/dev/null || : >"$out.c$k"
		i=$((i + 100))
		k=$((k + 1))
	done
	if [ "$k" -eq 0 ]; then
		echo '{}' >"$out"
		return
	fi
	# A chunk that failed or printed something else counts as {}.
	jq -cn '[inputs | if type == "object" then . else {} end] | add // {}' "$out".c* >"$out.merged" 2>/dev/null ||
		echo '{}' >"$out.merged"
	rm -f "$out".c*
	mv -f "$out.merged" "$out"
}

examine() { # examine <ref>: reads the PR and queues its new events; 1 if a read failed
	local ref=$1 repo_path=${1%#*} n=${1##*#} baseline login owners result edf=$run_tmp/editors.json
	baseline=$(jq -r --arg r "$ref" '[.subscriptions[] | select(.pr == $r) | .subscribed_at] | min // empty' "$work_registry")
	[ -n "$baseline" ] || return 0
	read_my_login || {
		log "examine pr=$ref error=\"can't read the sessions' own login\""
		return 1
	}
	"$gh_bin" api "repos/$repo_path/pulls/$n" </dev/null >"$run_tmp/pr.json" 2>"$run_tmp/err" &&
		jq -e 'type == "object" and has("state")' "$run_tmp/pr.json" >/dev/null 2>&1 || {
		log "examine pr=$ref error=\"PR unreadable\" detail=$(head -c 200 "$run_tmp/err" | jq -Rrs '@json')"
		return 1
	}
	"$gh_bin" api "repos/$repo_path/issues/$n/timeline?per_page=100" --paginate --slurp </dev/null \
		>"$run_tmp/tl.json" 2>"$run_tmp/err" &&
		jq -e 'type == "array"' "$run_tmp/tl.json" >/dev/null 2>&1 || {
		log "examine pr=$ref error=\"timeline unreadable\" detail=$(head -c 200 "$run_tmp/err" | jq -Rrs '@json')"
		return 1
	}
	jq --arg r "$ref" '.prs[$r] // {}' "$work_state" >"$run_tmp/ps.json"
	echo '{}' >"$edf"
	set -- --slurpfile tl "$run_tmp/tl.json" --slurpfile pr "$run_tmp/pr.json" --slurpfile psf "$run_tmp/ps.json" \
		--slurpfile edf "$edf" --arg me "$my_login" --argjson bots "$review_bots" --arg baseline "$baseline" \
		--argjson now "$now" --argjson retry_window "$retry_window" --argjson owner_text "$owner_text" \
		--argjson text_store $((owner_text_cap * 4))
	# Who edited each comment edited since it was last seen: the REST
	# timeline names only its author. An editor that can't be read is retried.
	edit_authors "$edf" < <(jq -nr --arg phase edits --argjson owners '{}' "$@" -f "$examine_jq")
	owners='{}'
	check_owners "$repo_path" need "$@"
	# The owner's new items: their text, last edit and editor in one read,
	# and an owner check for each editor it names. Nothing else is read for
	# text, so a stranger's items cost no query. One that can't be read is
	# quoted not at all.
	if [ "$owner_text" = true ]; then
		edit_authors "$edf.texts" < <(jq -nr --arg phase texts --argjson owners "$owners" "$@" -f "$examine_jq")
		jq -cs '(.[0] // {}) + (.[1] // {})' "$edf" "$edf.texts" >"$edf.new" 2>/dev/null && mv -f "$edf.new" "$edf"
		check_owners "$repo_path" texts_need "$@"
	fi
	result=$run_tmp/result.json
	jq -n --arg phase result --argjson owners "$owners" "$@" -f "$examine_jq" >"$result" || {
		log "examine pr=$ref error=\"filter failed\""
		return 1
	}
	jq -r --arg r "$ref" '.log[] | "event pr=\($r) key=\(.key) actor=\(.actor) verdict=\(.verdict) reason=\(.reason | @json)"' \
		"$result" | while IFS= read -r line; do log "$line"; done
	# The new cursor, then the events, fanned out to each subscription that
	# was in place when the event happened.
	edit "$work_state" --arg r "$ref" --slurpfile res "$result" --slurpfile reg "$work_registry" \
		--argjson now "$now" --arg pr_url "$(jq -r '.html_url // ""' "$run_tmp/pr.json")" '
		$res[0] as $x
		| .prs[$r] = ($x.ps + {last_swept: $now, dirty: false} | del(.failing_since, .failing_reported, .failed_at))
		| reduce ($reg[0].subscriptions[] | select(.pr == $r)) as $s (.;
			reduce ($x.events[] | select(.at >= $s.subscribed_at)) as $e (.;
				.pending[$s.session_id] //= {first_at: $now, events: []}
				| if any(.pending[$s.session_id].events[]; .pr == $r and .key == $e.key) then .
				  # A new event earns the session fresh relay tries (relay_tries):
				  # the ones it used up were for what was held before.
				  else .pending[$s.session_id].events += [$e + {pr: $r, pr_url: $pr_url, pr_state: $x.ps.pr_state,
				                                                pr_head: $x.ps.head, pr_base: $x.ps.base}]
				       | .pending[$s.session_id] |= del(.relay_unconfirmed) end))'
	# A subscription made after the PR closed would never hear of it.
	local closed sid
	closed=$(jq -r '.ps.closed_at // empty' "$result")
	[ -n "$closed" ] || return 0
	jq -r --arg r "$ref" --arg c "$closed" \
		'.subscriptions[] | select(.pr == $r and .subscribed_at > $c) | .session_id' "$work_registry" >"$run_tmp/closed-subs"
	while IFS= read -r sid; do
		[ -z "$sid" ] || unsubscribe "$ref" "$sid" closed-before-subscribe
	done <"$run_tmp/closed-subs"
}

examine_due() { # every subscribed PR that is dirty or due a sweep
	local ref
	jq -r --slurpfile st "$work_state" --argjson now "$now" --argjson every "$sweep_interval" --argjson retry "$slow_retry" '
		.subscriptions | map(.pr) | unique | .[]
		| select(($st[0].prs[.] // {}) as $p | (($p.dirty == true) or ($now - ($p.last_swept // 0) >= $every))
			and $now - ($p.failed_at // 0) >= $retry - 5)' \
		"$work_registry" >"$run_tmp/due"
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		examine "$ref" || pr_unreadable "$ref"
	done <"$run_tmp/due"
}

pr_unreadable() { # pr_unreadable <ref>: after a failed read
	# A failed read leaves the PR marked, so a check a minute or more later
	# tries again (not every check: one every 15 seconds, for every PR, would
	# hammer GitHub through an outage), until it has failed for hold_bound:
	# then it is reported once and falls back to the sweep, so a PR that is
	# gone (or was never a PR) costs one read per sweep, not one a minute.
	local mins
	edit "$work_state" --arg r "$1" --argjson now "$now" --argjson bound "$hold_bound" '
		.prs[$r].failing_since //= $now
		| .prs[$r].failed_at = $now
		| if $now - .prs[$r].failing_since < $bound then .prs[$r].dirty = true
		  else .prs[$r] += {dirty: false, last_swept: $now} end'
	mins=$(jq -r --arg r "$1" --argjson now "$now" --argjson bound "$hold_bound" '.prs[$r]
		| if ($now - .failing_since) >= $bound and (.failing_reported | not)
		  then (($now - .failing_since) / 60 | floor) else empty end' "$work_state")
	[ -n "$mins" ] || return 0
	log "stale pr=$1 unreadable=${mins}m"
	echo "pr-notifier: $1 has been unreadable for ${mins}m; its subscribers hear nothing until it reads again; see $log_file" >&2
	edit "$work_state" --arg r "$1" '.prs[$r].failing_reported = true'
}

# --- check: delivery --------------------------------------------------------

# What a session sets for the processes it starts. None of it may reach a
# claude the notifier runs, or that claude would act as the session that ran
# check (check is also run by hand from a session, as a test hook).
session_vars=(CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID CLAUDE_CODE_MESSAGING_SOCKET
	CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_CHILD_SESSION
	CLAUDE_CODE_SESSION_ATTENDED CLAUDE_PID CLAUDECODE CLAUDE_JOB_DIR)
claude_timeout=120 # no claude call holds the lock longer than this

# Every claude call runs from /, which must stay untrusted. A --resume that
# reaches a session Claude Code's daemon still counts as running (as one does
# for about a second after claude stop returns) doesn't resume it: it starts a
# copy, a fork of the conversation, in the caller's cwd. From / the trust check
# refuses that copy (exit 1, "Workspace not trusted"), so the fork never
# starts; from a trusted cwd, such as the session's own, it would (#338, on
# 2.1.325). A resume the daemon takes as a wake runs in the session's own
# recorded cwd, so / costs it nothing.
claude_env() { # claude_env <config dir or ""> <PATH> <claude args...>: from /, stdin inherited
	local cfg=$1 p=$2 cmd=(env) v
	shift 2
	! command -v perl >/dev/null 2>&1 || cmd=(perl -e 'alarm shift; exec @ARGV' "$claude_timeout" env)
	for v in "${session_vars[@]}"; do cmd+=(-u "$v"); done
	if [ -n "$cfg" ]; then
		cmd+=(CLAUDE_CONFIG_DIR="$cfg")
	else
		cmd+=(-u CLAUDE_CONFIG_DIR) # unset, never set to ~/.claude: the spike's Trap 3
	fi
	(cd / && "${cmd[@]}" PATH="$p" "$claude_path" "$@")
}

run_claude() { # run_claude <config dir or ""> <claude args...>: under wake_path, with no stdin
	local cfg=$1
	shift
	claude_env "$cfg" "$wake_path" "$@" </dev/null
}

agents() { # agents <config dir or ""> [fresh]: the root's claude agents listing, reused for 15 seconds
	# A relay can take a minute, so a listing read before one may no longer
	# say which sessions are stopped: resuming one that has since started
	# would fork it.
	local f at
	f=$run_tmp/agents.$(printf '%s' "${1:-default}" | cksum | cut -d' ' -f1).json
	at=$(cat "$f.at" 2>/dev/null) || at=
	[ -z "${2:-}" ] && [ -n "$at" ] && [ $((SECONDS - at)) -le 15 ] || rm -f "$f"
	if [ ! -f "$f" ]; then
		echo "$SECONDS" >"$f.at"
		run_claude "$1" agents --json --all >"$f.tmp" 2>/dev/null &&
			jq -e 'type == "array"' "$f.tmp" >/dev/null 2>&1 || {
			rm -f "$f.tmp"
			return 1
		}
		mv -f "$f.tmp" "$f"
	fi
	cat "$f"
}

# A row's fields are joined by US (\x1f), not a tab: read collapses runs of a
# whitespace IFS, so an empty pid would shift the fields after it.
us=$'\x1f'

session_row() { # session_row <config dir> <session id> [fresh]: "<short> <cwd> <pid> <status> <state> <kind>", US-joined
	local listing
	listing=$(agents "$1" "${3:-}") || return 2
	jq -r --arg s "$2" '[.[] | select(.sessionId == $s)] | last // empty
		| [.id // "", .cwd // "", (.pid // "" | tostring), .status // "", .state // "", .kind // ""] | join("\u001f")' <<<"$listing"
}

job_state() { # job_state <config dir> <short id>: "<in flight: none|busy|unknown> <updatedAt epoch or -1> <tempo or unknown>"
	local f=${1:-$HOME/.claude}/jobs/$2/state.json
	jq -r '[ (if (.inFlight | type) != "object" then "unknown"
	          elif ((.inFlight.tasks // 0) > 0) or ((.inFlight.queued // 0) > 0)
	               or ((.inFlight.kinds // []) | length) > 0 then "busy"
	          else "none" end),
	         ((.updatedAt // "") | sub("\\.[0-9]+Z$"; "Z") | (try fromdateiso8601 catch -1) | tostring),
	         (.tempo | if type == "string" and test("^[a-z]+$") then . else "unknown" end) ] | join(" ")' \
		"$f" 2>/dev/null || echo 'unknown -1 unknown'
}

settled_state() { # settled_state <status> <state> <in flight> <updatedAt epoch> <tempo>: the row's state, or "stale"
	# "stale" is a row whose state working is left over: status idle, nothing
	# in flight, the job's tempo idle, and no job state written for
	# working_grace. Such a session is at its prompt, and takes a relay as an
	# idle one does. A session stopped while blocked and then woken with no
	# prompt reads so, its state never set back (reproduced by attaching to
	# one on 2.1.325, #338). A turn shows status busy and tempo active (the
	# same session mid-turn), and writes its job state as it goes. Anything
	# unread or unknown keeps the state working, so the session is held: work
	# in flight can't be ruled out. Both delivery and the fallback's re-read
	# decide by this, so they can't disagree about a row.
	if [ "$1:$2:$3:$5" = idle:working:none:idle ] && [ "$4" -ge 0 ] && [ $((now - $4)) -ge "$working_grace" ]; then
		echo stale
	else
		echo "$2"
	fi
}

pid_alive() { # pid_alive <pid>: a process with that pid exists, whoever owns it
	[[ $1 =~ ^[0-9]+$ ]] && "$ps_bin" -p "$1" -o pid= >/dev/null 2>&1
}

hold() { # hold <session id> <reason>: logged when the reason changes, and every five minutes it doesn't
	# A check runs every 15 seconds, so a session busy for an hour would
	# otherwise log 240 lines saying so.
	if jq -e --arg s "$1" --arg r "$2" --argjson now "$now" \
		'.pending[$s] | .last_hold == $r and $now - (.hold_logged_at // 0) < 300' "$work_state" >/dev/null; then
		return 0
	fi
	edit "$work_state" --arg s "$1" --arg r "$2" --argjson now "$now" '.pending[$s] += {last_hold: $r, hold_logged_at: $now}'
	log "hold session=$(short "$1") reason=$2"
}

drop_session() { # drop_session <session id> <reason>: it can't be woken, so its subscriptions go
	local sid=$1 ref
	jq -r --arg s "$sid" '.subscriptions[] | select(.session_id == $s) | .pr' "$work_registry" >"$run_tmp/drop"
	while IFS= read -r ref; do
		[ -z "$ref" ] || unsubscribe "$ref" "$sid" "$2"
	done <"$run_tmp/drop"
	edit "$work_state" --arg s "$sid" '.pending |= del(.[$s])'
}

listing_doubt() { # listing_doubt <config dir> <session id>: why that root's listing can't be trusted to show a deletion, or nothing
	# A deletion removes one session. A listing that shows no session at
	# all (an empty list, or rows whose fields were renamed), or has lost
	# every other subscribed session too, more likely changed or broke (a
	# Claude Code update, say).
	local listing
	listing=$(agents "$1") || return 0
	jq -r --arg c "$1" --arg s "$2" --argjson l "$listing" '
		if any($l[]; (.sessionId | type) == "string") | not then "the listing shows no session"
		else [.subscriptions[] | select((.config_dir // "") == $c and .session_id != $s) | .session_id] | unique
		  | if length > 0 and (any(.[]; . as $o | any($l[]; .sessionId == $o)) | not)
		    then "no other session subscribed in its root is listed either" else empty end
		end' "$work_registry"
}

drop_notice() { # drop_notice <session id> <minutes>: a comment on each PR it's subscribed to, saying nothing is listening
	# The log alone reaches no one, and whoever comments next on the PR
	# would otherwise expect the session to wake. The notifier posts as the
	# sessions' own login, whose comments wake no one (examine.jq). The PR
	# may be public, so the comment names the session only by its short id
	# (the handle claude agents shows), and the command that resubscribes
	# it, with its full id, goes in the log.
	local sid=$1 ref text again
	jq -r --arg s "$sid" '[.subscriptions[] | select(.session_id == $s) | .pr] | unique | .[]' "$work_registry" >"$run_tmp/notice"
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		text="pr-notifier: session \`$(short "$sid")\` has had no \`claude agents\` row for $2 minutes, so it's unsubscribed from this PR, and new activity here won't wake it. That usually means it was deleted (Ctrl-X in agent view, or \`claude rm\`). If it still exists, the notifier's log has the command that resubscribes it."
		again=$(jq -rn --arg c "pr-notifier subscribe $ref --session $sid" '$c | @json')
		if "$gh_bin" api -X POST "repos/${ref%#*}/issues/${ref##*#}/comments" -f body="$text" </dev/null >/dev/null 2>"$run_tmp/err"; then
			log "notice pr=$ref session=$(short "$sid") posted=yes resubscribe=$again"
		else
			log "notice pr=$ref session=$(short "$sid") resubscribe=$again error=$(head -c 200 "$run_tmp/err" | jq -Rrs '@json')"
		fi
	done <"$run_tmp/notice"
}

wake_prompt() { # wake_prompt <session id>: the fixed template, carrying URLs and checked details (lib/wake.jq)
	jq -r --arg s "$1" --argjson quote "$owner_text" --argjson cap "$owner_text_cap" --argjson budget "$owner_text_budget" \
		-f "$wake_jq" "$work_state"
}

resume_path() { # resume_path <session id>: its recorded PATH, then any of wake_path's entries it lacks
	# Absolute entries only, each once. Merging means a PATH recorded while
	# degraded (say, by a session once woken under a bare one) can't persist.
	local rec
	rec=$(jq -r --arg s "$1" '[.subscriptions[] | select(.session_id == $s) | .path | strings] | last // empty' "$work_registry")
	jq -rn --arg a "$rec" --arg b "$wake_path" '
		[($a, $b) | split(":")[] | select(startswith("/"))]
		| reduce .[] as $e ([]; if any(.[]; . == $e) then . else . + [$e] end) | join(":")'
}

finish_wake() { # finish_wake <session id> <how> [log detail] [event ids, a JSON list]: the wake landed, so the events it carried go
	# The ids ("<pr>|<key>") default to every held event. A relay that lands
	# a check late carried only the events held when it was sent, so any
	# queued since stay for the next wake.
	local sid=$1 ids=${4:-} ref
	[ -n "$ids" ] || ids=$(jq -c --arg s "$sid" '[.pending[$s].events[] | "\(.pr)|\(.key)"]' "$work_state")
	jq -c --arg s "$sid" --argjson ids "$ids" \
		'[.pending[$s].events[] | select("\(.pr)|\(.key)" as $i | $ids | index($i))]' "$work_state" >"$run_tmp/landed"
	log "wake session=$(short "$sid") how=$2 prs=$(jq -r '[.[].pr] | unique | join(",")' "$run_tmp/landed") events=$(jq -r length "$run_tmp/landed")${3:+ $3}"
	# The final wake for a PR that merged or closed ends its subscription, if
	# the PR is still merged or closed as last read: one reopened since its
	# close was queued keeps its subscribers.
	jq -r --slurpfile ev "$run_tmp/landed" '.prs as $prs
		| [$ev[0][] | select(.kind == "merged" or .kind == "closed") | .pr
		   | select(($prs[.].pr_state // "closed") != "open")] | unique | .[]' \
		"$work_state" >"$run_tmp/final"
	# A landed wake also ends the relay and resume backoffs: they count
	# failures to reach the session, which just ended.
	# The events left are a hold of their own, so their clock and stale
	# report start over.
	edit "$work_state" --arg s "$sid" --argjson ids "$ids" --argjson now "$now" '
		.pending[$s].events = [.pending[$s].events[] | select("\(.pr)|\(.key)" as $i | $ids | index($i) | not)]
		| if (.pending[$s].events | length) == 0 then .pending |= del(.[$s])
		  else .pending[$s] |= (del(.relay_failures, .relay_unconfirmed, .next_relay_at, .wake_failures, .next_wake_at,
		                            .stale_reported, .last_hold, .hold_logged_at, .stale_logged, .fallback_at) | .first_at = $now)
		  end'
	while IFS= read -r ref; do
		[ -z "$ref" ] || unsubscribe "$ref" "$sid" "pr-final-wake"
	done <"$run_tmp/final"
}

back_off() { # back_off <session id> <failures field> <next-try field>: counts a failure; the next try is 5, 10, 20, 40, then 60 minutes on
	edit "$work_state" --arg s "$1" --arg n "$2" --arg at "$3" --argjson now "$now" '
		.pending[$s][$n] = ((.pending[$s][$n] // 0) + 1)
		| .pending[$s][$at] = $now + ([300 * pow(2; .pending[$s][$n] - 1), 3600] | min)'
}

wake() { # wake <session id> <config dir> <how>: resumes it with the wake prompt, under its own PATH
	local sid=$1 cfg=$2 out rc copy stopped=no copy_re='started a copy as ([0-9a-f]{8})'
	out=$(claude_env "$cfg" "$(resume_path "$sid")" --bg --resume "$sid" "$(wake_prompt "$sid")" </dev/null 2>&1)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		# A refused resume keeps its events for the next wake, and retries
		# back off. One refused for the session's own cwd (untrusted, or
		# gone) says its message is saved for the session's next start (the
		# #292 spike), so a retry can deliver the prompt twice, which the
		# template makes harmless. One refused because it would have started
		# a copy (claude_env) says nothing of the kind, and its prompt never
		# reached the session (2.1.325, #338).
		back_off "$sid" wake_failures next_wake_at
		hold "$sid" "wake-failed"
		log "wake-failed session=$(short "$sid") rc=$rc detail=$(printf '%s' "$out" | head -n 1 | head -c 200 | jq -Rrs '@json')"
		return 1
	fi
	# A backstop for a guard that failed: the daemon still counted the
	# session as running, so the resume started a copy of it, with the wake
	# prompt, instead, which only a trusted / lets run (claude_env). Only the
	# note that says so marks a copy (2.1.325's wording), since a real wake
	# never prints it: guessing from anything less could stop the session a
	# real wake just started. A copy acting on the session's PR would
	# duplicate its work, so it is stopped at once (its conversation is
	# kept), with one retry a second on, and the wake counts as refused.
	if [[ $out =~ $copy_re ]]; then
		copy=${BASH_REMATCH[1]}
		if run_claude "$cfg" stop "$copy" >/dev/null 2>&1 || { sleep 1 && run_claude "$cfg" stop "$copy" >/dev/null 2>&1; }; then
			stopped=yes
		fi
		back_off "$sid" wake_failures next_wake_at
		hold "$sid" "wake-forked"
		log "wake-forked session=$(short "$sid") copy=$copy copy-stopped=$stopped"
		echo "pr-notifier: resuming session $(short "$sid") started a copy, $copy, instead (copy stopped: $stopped); is / trusted? see $log_file" >&2
		return 1
	fi
	finish_wake "$sid" "$3"
}

# --- check: the relay ------------------------------------------------------------

private_dir() { # private_dir <dir>: a real directory, this user's or root's, that no one else can write
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	[ -O "$1" ] || [ -n "$(find "$1" -maxdepth 0 -user root 2>/dev/null)" ] || return 1
	[ -z "$(find "$1" -maxdepth 0 \( -perm -020 -o -perm -002 \) 2>/dev/null)" ]
}

session_socket() { # session_socket <pid>: a live session's messaging address, uds:<its socket>
	# Each live session listens on <pid>.sock in its user's private socket
	# directory, named for the pid its claude agents row shows (checked on the
	# Mac Studio for every live row). Addressing that socket, not the session's
	# name, can't hit another session that shares or took over the name. The
	# directory is /tmp/cc-socks when that is this user's or root's and
	# private, else /tmp/cc-socks-<uid>; a directory or socket someone else
	# could have placed (another owner, writable by others, a symlink) is
	# skipped.
	local d dirs
	[[ $1 =~ ^[0-9]+$ ]] || return 1
	IFS=: read -ra dirs <<<"${PR_NOTIFIER_SOCK_DIRS:-/tmp/cc-socks:/tmp/cc-socks-$(id -u)}"
	for d in ${dirs[@]+"${dirs[@]}"}; do
		if [ -n "$d" ] && private_dir "$d" && [ ! -L "$d/$1.sock" ] && [ -S "$d/$1.sock" ] && [ -O "$d/$1.sock" ]; then
			printf 'uds:%s/%s.sock' "$d" "$1"
			return 0
		fi
	done
	return 1
}

transcripts() { # transcripts <config dir> <session id>: the session's transcript files, one a line
	# It sits under the project its session started in, and moves with
	# EnterWorktree, so it is found by name.
	find "${1:-$HOME/.claude}/projects" -mindepth 2 -maxdepth 2 -type f -name "$2.jsonl" 2>/dev/null
}

session_mode() { # session_mode <transcript...>: the permission mode it last recorded, for the log
	# Read oldest file first, so the last line found is the newest file's.
	local m= f files=()
	[ $# -eq 0 ] || while IFS= read -r f; do [ -z "$f" ] || files+=("$f"); done < <(ls -tr -- "$@" 2>/dev/null)
	[ ${#files[@]} -eq 0 ] || m=$(grep -hF '"permission-mode"' "${files[@]}" 2>/dev/null | tail -n 1 |
		jq -r 'select(.type == "permission-mode") | .permissionMode | strings' 2>/dev/null)
	[[ $m =~ ^[A-Za-z]+$ ]] || m=unknown
	printf '%s' "$m"
}

landed() { # landed <message id> <transcript...>: the message is a turn in the session
	# The receiving session writes each peer message it takes as a user turn
	# whose origin carries the sender's msg_id. A message held for approval,
	# refused, or queued for a session that has since stopped isn't one. A
	# transcript that moved since it was found makes grep fail even after a
	# match elsewhere, so its status doesn't count (pipefail).
	local id=$1
	shift
	[ $# -gt 0 ] || return 1
	{ grep -hF -- "$id" "$@" 2>/dev/null || :; } |
		jq -enR --arg m "$id" '[inputs | fromjson? | select(type == "object" and .type == "user" and .origin.msg_id? == $m)] | length > 0' >/dev/null
}

relay_prompt() { # relay_prompt <address> <text>: what the relay session is asked to do
	printf '%s\n' "You relay one message for pr-notifier. Call the SendMessage tool exactly once. Set its \"to\" to exactly this address:" \
		"$1" \
		"Set its \"message\" to exactly the text between the BEGIN and END lines below, verbatim: no added words, no quotes, nothing left out. Call no other tool, then stop." \
		BEGIN "$2" END
}

relay_result() { # relay_result <stream-json file> <address> <text>: "ok <msg id>", "maybe: <why>" or "no: <why>"
	# The exit code says nothing (claude -p exits 0 when the model never
	# sends, or rewords the text), so the SendMessage calls are checked, and
	# so is what the tool answered each. The last call to the session's
	# address that the tool reports sent decides, so a retry after a failed
	# first call still gives its message id. "no" is a relay that sent
	# nothing to the session; "maybe" is one whose message may have reached
	# it (a changed text, a send with no usable id, or a call with no result
	# because the relay was killed after it).
	jq -nrR --arg to "$2" --arg text "$3" '
		def rstrip: sub("\\s+$"; "");
		def body: .content | if type == "array" then map(.text? // "") | join("") elif type == "string" then . else "" end;
		[inputs | fromjson? | select(type == "object")] as $m
		| [$m[] | select(.type == "assistant") | .message.content[]? | select(type == "object" and .type == "tool_use")] as $uses
		| [$m[] | select(.type == "user") | .message.content[]? | select(type == "object" and .type == "tool_result")] as $results
		| [$uses[] | select(.name == "SendMessage" and (.input.to // "") == $to)
		   | . as $u | ([$results[] | select(.tool_use_id == $u.id)] | first) as $r
		   | {same: ((($u.input.message // "") | tostring | rstrip) == ($text | rstrip)),
		      r: $r, body: (if $r == null then "" else ($r | body) end)}
		   | . + {j: (.body | fromjson? // null)}] as $sends
		| [$sends[] | select(.r != null and .r.is_error != true and (.j | type) == "object" and .j.success == true)] as $sent
		| if ($uses | length) == 0 then "no: no tool call"
		  elif ($sends | length) == 0 then
		    (if any($uses[]; .name != "SendMessage") then "no: called \([$uses[].name] | unique | join(","))"
		     else "no: sent to another address" end)
		  elif ($sent | length) > 0 then
		    ($sent | last) as $s
		    | if ($s.same | not) then "maybe: sent with the text changed"
		      elif (($s.j.msg_id | type) != "string") or ($s.j.msg_id | test("^[A-Za-z0-9_.:-]+$") | not) then "maybe: sent with no message id"
		      else "ok \($s.j.msg_id)" end
		  elif any($sends[]; .r == null) then "maybe: no tool result"
		  else ($sends | last) as $s
		    | if $s.r.is_error == true then "no: \($s.body | .[0:160])" else "no: not sent: \($s.body | .[0:160])" end
		  end' "$1" 2>/dev/null || echo "no: unreadable output"
}

relay_failed() { # relay_failed <session id> <mode> <why> [maybe]: logs it and backs relays off
	# Relays to the session back off as refused resumes do, and the
	# stop-then-resume fallback isn't held up by it. One whose message may
	# have reached the session (maybe) also counts toward relay_tries: it may
	# still land (a held message approved later), so it isn't repeated
	# forever. One that sent nothing doesn't, so a crash or a missing socket
	# never stops relays for good.
	back_off "$1" relay_failures next_relay_at
	[ "${4:-}" != maybe ] || edit "$work_state" --arg s "$1" '.pending[$s].relay_unconfirmed = ((.pending[$s].relay_unconfirmed // 0) + 1)'
	log "relay-failed session=$(short "$1") mode=$2 reason=$(jq -rn --arg r "$3" '$r | @json')"
}

relay() { # relay <session id> <config dir> <pid>: 0 once the wake is a turn in the live session,
	# 1 if nothing reached it, 2 if it may have but no turn took it (both logged).
	# A one-shot headless session SendMessages the wake prompt to the
	# session's socket. It restarts nothing, so nothing in flight is lost and
	# an attached viewer stays connected.
	local sid=$1 cfg=$2 pid=$3 to text res id mode waited=0 files=() f row rid rcwd rpid rstatus rst rkind
	to=$(session_socket "$pid") || {
		relay_failed "$sid" unknown "no socket for pid $pid"
		return 1
	}
	text=$(wake_prompt "$sid")
	relay_prompt "$to" "$text" >"$run_tmp/relay.in"
	# The prompt goes on stdin: --tools takes every argument after it. A relay
	# takes seconds, so it gets a minute, not the two other calls get.
	claude_timeout=60 claude_env "$cfg" "$wake_path" -p --safe-mode --name pr-notifier --no-session-persistence \
		--model "$relay_model" --max-turns 3 --output-format stream-json --verbose --tools SendMessage \
		<"$run_tmp/relay.in" >"$run_tmp/relay.out" 2>"$run_tmp/relay.err"
	res=$(relay_result "$run_tmp/relay.out" "$to" "$text")
	find_transcripts "$cfg" "$sid"
	files=(${found_transcripts[@]+"${found_transcripts[@]}"})
	mode=$(session_mode ${files[@]+"${files[@]}"})
	case $res in
	"ok "*) id=${res#ok } ;;
	maybe:*)
		relay_failed "$sid" "$mode" "${res#maybe: }" maybe
		return 2
		;;
	*)
		relay_failed "$sid" "$mode" "${res#no: }$(head -n 1 "$run_tmp/relay.err" | head -c 160 | sed 's/^./; &/')"
		return 1
		;;
	esac
	# A successful send means only that the message reached the session's
	# inbox: one held for approval, or sent to a session that has just
	# stopped, reports the same. So wait for the turn itself.
	while :; do
		if [ ${#files[@]} -gt 0 ]; then
			landed "$id" "${files[@]}" && break
		elif [ $((waited % 2)) -eq 0 ]; then
			# No transcript to read (Claude Code moved it): the row, with the
			# same pid and busy, is the weaker sign the message was taken. A
			# listing takes about a second, so it is read every other one.
			row=$(session_row "$cfg" "$sid" fresh) || row=
			IFS=$us read -r rid rcwd rpid rstatus rst rkind <<<"$row"
			[ "$rpid" = "$pid" ] && [ "$rstatus" = busy ] && break
		fi
		if [ "$waited" -ge "$relay_wait" ]; then
			relay_failed "$sid" "$mode" "sent as $id, but no turn took it within ${relay_wait}s (held, refused or stopped)" maybe
			# Later checks look for this message first (deliver), so one the
			# session takes late counts as the wake for what it carried.
			edit "$work_state" --arg s "$sid" --arg id "$id" --argjson max "$relay_outstanding" '
				.pending[$s].relay_msgs = (((.pending[$s].relay_msgs // [])
					+ [{id: $id, events: [.pending[$s].events[] | "\(.pr)|\(.key)"]}]) | .[-$max:])'
			return 2
		fi
		sleep 1
		waited=$((waited + 1))
	done
	finish_wake "$sid" relay "mode=$mode msg=$id cost=$(jq -nrR '[inputs | fromjson? | select(type == "object" and .type == "result") | .total_cost_usd | numbers | . * 10000 | round / 10000] | first // "unknown"' "$run_tmp/relay.out" 2>/dev/null)"
}

resume_backoff() { # resume_backoff <session id>: holds it and returns 0 while a refused resume is backing off
	local next
	next=$(jq -r --arg s "$1" '.pending[$s].next_wake_at // 0 | floor' "$work_state")
	[ "$now" -lt "$next" ] || return 1
	hold "$1" "wake-backoff until $(iso "$next")"
}

relay_tries=3        # relays that may have reached a session, unconfirmed, before it waits for the fallback alone
relay_outstanding=5  # unconfirmed relays a session may have waiting at once (relay_msgs), all of them watched
delivery_budget=150  # seconds of delivery in one check, after which no delivery starts
delivery_start=0     # SECONDS when this check's deliveries began (cmd_check)

over_budget() { # over_budget <session id> [why]: holds it and returns 0 once this check has run its delivery budget
	# Every relay, stop and resume holds the lock, which subscribe waits
	# only five minutes for, so a long check leaves the rest to the next.
	[ $((SECONDS - delivery_start)) -ge "$delivery_budget" ] || return 1
	hold "$1" "${2:+$2; }deferred: this check has delivered for $((SECONDS - delivery_start))s"
}

find_transcripts() { # find_transcripts <config dir> <session id>: sets found_transcripts to the session's transcript files
	local f
	found_transcripts=()
	while IFS= read -r f; do [ -z "$f" ] || found_transcripts+=("$f"); done < <(transcripts "$1" "$2")
}

deliver() { # deliver <session id>: the spike's state table, first match wins
	local sid=$1 cfg row id cwd pid status st kind next tries outstanding why ids late evs inflight updated tempo worker at files=()
	! over_budget "$sid" || return
	cfg=$(jq -r --arg s "$sid" '[.subscriptions[] | select(.session_id == $s)] | last | .config_dir // empty' "$work_registry")
	# Relays sent but not yet taken (relay_msgs, the last five) may have been
	# taken since: a held message, approved. Each one that was is the wake for
	# whatever it carried that is still held. A later relay doesn't replace an
	# earlier one, which the session can still take first.
	ids=$(jq -r --arg s "$sid" '.pending[$s].relay_msgs // [] | .[].id' "$work_state")
	if [ -n "$ids" ]; then
		find_transcripts "$cfg" "$sid"
		files=(${found_transcripts[@]+"${found_transcripts[@]}"})
		while IFS= read -r late; do
			[ -n "$late" ] && landed "$late" ${files[@]+"${files[@]}"} || continue
			evs=$(jq -c --arg s "$sid" --arg m "$late" '.pending[$s] as $p
				| [($p.relay_msgs // [])[] | select(.id == $m) | .events[]]
				| map(select(. as $i | any($p.events[]; "\(.pr)|\(.key)" == $i)))' "$work_state")
			edit "$work_state" --arg s "$sid" --arg m "$late" '.pending[$s].relay_msgs |= map(select(.id != $m))'
			[ "$evs" = "[]" ] || finish_wake "$sid" relay-late "msg=$late" "$evs"
			jq -e --arg s "$sid" '.pending[$s] != null' "$work_state" >/dev/null || return
		done <<<"$ids"
	fi
	row=$(session_row "$cfg" "$sid") || {
		hold "$sid" listing-failed
		return
	}
	if [ -z "$row" ]; then
		# No row in its root: usually deleted from agent view (Ctrl-X, or
		# claude rm), since the workflow unsubscribes before it removes a
		# session. Held for hold_bound in case the row comes back, then
		# dropped: a deleted session can't be woken, and its PRs would
		# otherwise be read, and its events held, for good.
		local gone mins doubt
		gone=$(jq -r --arg s "$sid" '.pending[$s].gone_since // empty' "$work_state")
		if [ -z "$gone" ]; then
			gone=$now
			edit "$work_state" --arg s "$sid" --argjson now "$now" '.pending[$s].gone_since = $now'
		fi
		if [ $((now - gone)) -lt "$hold_bound" ]; then
			hold "$sid" session-gone
			return
		fi
		mins=$(((now - gone) / 60))
		doubt=$(listing_doubt "$cfg" "$sid")
		if [ -n "$doubt" ]; then
			hold "$sid" "session-gone; kept: $doubt"
			return
		fi
		log "drop session=$(short "$sid") reason=session-gone gone=${mins}m"
		[ "$drop_comment" = false ] || drop_notice "$sid" "$mins"
		drop_session "$sid" session-gone
		return
	fi
	jq -e --arg s "$sid" '.pending[$s].gone_since == null' "$work_state" >/dev/null ||
		edit "$work_state" --arg s "$sid" '.pending[$s] |= del(.gone_since)'
	IFS=$us read -r id cwd pid status st kind <<<"$row"
	if [ -z "$pid" ]; then
		# The listing can be seconds old, and resuming a session that has
		# started since would fork it, so read its row afresh first.
		row=$(session_row "$cfg" "$sid" fresh) || {
			hold "$sid" listing-failed
			return
		}
		IFS=$us read -r id cwd pid status st kind <<<"$row"
		if [ -z "$row" ] || [ -n "$pid" ]; then
			hold "$sid" "changed since the listing; next check"
			return
		fi
		if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
			# Stopped, and its resume would be refused (exit 1) with the
			# prompt queued: usually FINISH removed its worktree.
			log "drop session=$(short "$sid") reason=cwd-gone cwd=$(jq -rn --arg c "$cwd" '$c | @json')"
			drop_session "$sid" cwd-gone
			return
		fi
		# A worker the fallback stopped but didn't see exit (stop-pending)
		# may still run, and until it exits a resume starts a copy. Its pid is
		# trusted for ten minutes, long past any exit, so a reused pid can't
		# hold the session for good.
		read -r worker at <<<"$(jq -r --arg s "$sid" '.pending[$s].stop_worker // empty | "\(.pid) \(.at | floor)"' "$work_state")"
		if [[ $worker =~ ^[0-9]+$ ]] && [[ $at =~ ^[0-9]+$ ]]; then
			if [ $((now - at)) -lt 600 ] && pid_alive "$worker"; then
				hold "$sid" "stop-pending worker=$worker"
				return
			fi
			edit "$work_state" --arg s "$sid" '.pending[$s] |= del(.stop_worker)'
		fi
		resume_backoff "$sid" || wake "$sid" "$cfg" stopped
		return
	fi
	# Running again, so a worker recorded at an earlier stop no longer
	# matters, and its pid mustn't hold the session's next stop.
	jq -e --arg s "$sid" '.pending[$s].stop_worker == null' "$work_state" >/dev/null ||
		edit "$work_state" --arg s "$sid" '.pending[$s] |= del(.stop_worker)'
	if [ "$status:$st" = idle:working ] && [[ $id =~ ^[0-9a-f]{8}$ ]]; then
		read -r inflight updated tempo <<<"$(job_state "$cfg" "$id")"
		st=$(settled_state "$status" "$st" "$inflight" "$updated" "$tempo")
		# Logged once a hold, not every check it stays so.
		if [ "$st" = stale ] && jq -e --arg s "$sid" '.pending[$s].stale_logged != true' "$work_state" >/dev/null; then
			log "stale-state session=$(short "$sid") status=idle state=working in-flight=none tempo=idle quiet=$((now - updated))s"
			edit "$work_state" --arg s "$sid" '.pending[$s].stale_logged = true'
		fi
	fi
	case $status:$st in
	busy:* | waiting:* | *:working)
		hold "$sid" "busy status=$status state=$st"
		return
		;;
	idle:done | idle:blocked | idle:stale) ;;
	*)
		hold "$sid" "unplaced status=$status state=$st"
		return
		;;
	esac
	# Live and idle, in a terminal or in the background: relay the wake in
	# place. Neither its cwd nor its work in flight matters to the relay.
	read -r next tries outstanding <<<"$(jq -r --arg s "$sid" '.pending[$s]
		| "\(.next_relay_at // 0 | floor) \(.relay_unconfirmed // 0) \(.relay_msgs // [] | length)"' "$work_state")"
	if [ "$relay_on" = false ]; then
		why="relay off"
	elif [ "$tries" -ge "$relay_tries" ]; then
		# Each unconfirmed relay may still have reached the session, so after
		# a few it stops trying until a wake lands and the count resets.
		why="relay gave up after $tries unconfirmed tries"
	elif [ "$outstanding" -ge "$relay_outstanding" ]; then
		# New events reset the tries, but not this: a session holding peer
		# messages for approval gets no more than these few, every one
		# still watched for, until one lands.
		why="relay gave up with $outstanding relays unconfirmed"
	elif [ "$now" -lt "$next" ]; then
		why="relay backoff until $(iso "$next")"
	else
		relay "$sid" "$cfg" "$pid"
		case $? in
		0) return ;;
		2)
			# It may have reached the session without a turn yet: it may still
			# be taken, so the fallback that stops the session waits slow_retry
			# (the relay backs off).
			edit "$work_state" --arg s "$sid" --argjson at $((now + slow_retry)) '.pending[$s].fallback_at = $at'
			hold "$sid" "relay unconfirmed; the fallback waits a minute"
			return
			;;
		esac
		why="relay not sent"
		! over_budget "$sid" "$why" || return
	fi
	stop_and_resume "$sid" "$cfg" "$id" "$cwd" "$kind" "$why"
}

stop_and_resume() { # stop_and_resume <session id> <config dir> <short id> <cwd> <kind> <why no relay>: the fallback
	local sid=$1 cfg=$2 id=$3 cwd=$4 kind=$5 why=$6 pid status st inflight updated tempo tries row worker wait_until
	wait_until=$(jq -r --arg s "$sid" '.pending[$s].fallback_at // 0 | floor' "$work_state")
	if [ "$now" -lt $((wait_until - 5)) ]; then
		hold "$sid" "$why; a relay may still land, so the fallback waits until $(iso "$wait_until")"
		return
	fi
	if [ "$kind" != background ]; then
		# A live terminal session: someone is at it, and a stop would end it
		# under them. Its events wait for a relay, or until it exits.
		hold "$sid" "$why; live ${kind:-unknown-kind} session"
		return
	fi
	if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
		# Live, but its resume would be refused once it was stopped. Held
		# under the bound: a later relay can still reach it.
		hold "$sid" "$why; cwd-gone cwd=$(jq -rn --arg c "$cwd" '$c | @json')"
		return
	fi
	[[ $id =~ ^[0-9a-f]{8}$ ]] || {
		hold "$sid" "$why; bad short id"
		return
	}
	! resume_backoff "$sid" || return
	read -r inflight updated tempo <<<"$(job_state "$cfg" "$id")"
	if [ "$inflight" != none ]; then
		# A stop would kill that work; an unreadable inFlight counts as work.
		hold "$sid" "$why; in-flight=$inflight"
		return
	fi
	# Attached viewers: the stop disconnects one, and attachment isn't visible
	# from outside the daemon. So a live session gets a quiet period after its
	# last activity before it is stopped.
	if [ "$updated" -ge 0 ] && [ $((now - updated)) -lt "$idle_grace" ]; then
		hold "$sid" "$why; recent-activity"
		return
	fi
	# Re-read right before the stop, to narrow the window for a new turn.
	row=$(session_row "$cfg" "$sid" fresh) || {
		hold "$sid" "$why; listing-failed"
		return
	}
	IFS=$us read -r id cwd pid status st kind <<<"$row"
	read -r inflight updated tempo <<<"$(job_state "$cfg" "$id")"
	st=$(settled_state "$status" "$st" "$inflight" "$updated" "$tempo")
	case $status:$st:$inflight in
	idle:done:none | idle:blocked:none | idle:stale:none) ;;
	*)
		hold "$sid" "$why; changed status=$status state=$st in-flight=$inflight"
		return
		;;
	esac
	worker=$pid
	if ! run_claude "$cfg" stop "$id" >/dev/null 2>&1; then
		hold "$sid" "$why; stop-failed"
		return
	fi
	# --resume on a session the daemon still counts as running starts a copy,
	# so wait until it is stopped. The row drops its pid as soon as the stop
	# is asked for, but the worker process runs on for a moment (claude stop
	# returned in about 0.4s, and the worker exited 0.4 to 0.7s after that,
	# on 2.1.325), and the daemon settles the session only once it exits. So
	# wait for the worker itself, then for a fresh row with no pid, whose
	# listing gives the daemon a second more. Resuming any sooner started a
	# copy, which / refused: every first wake failed so (#338).
	tries=0
	while pid_alive "$worker"; do
		tries=$((tries + 1))
		if [ "$tries" -ge 20 ]; then
			# The session is left stopped, so the next check takes the
			# stopped path, which waits for this pid too.
			edit "$work_state" --arg s "$sid" --argjson w "$worker" --argjson now "$now" \
				'.pending[$s].stop_worker = {pid: $w, at: $now}'
			hold "$sid" "$why; stop-pending worker=$worker"
			return
		fi
		sleep 0.25
	done
	tries=0
	while :; do
		row=$(session_row "$cfg" "$sid" fresh) || row=
		IFS=$us read -r id cwd pid status st kind <<<"$row"
		[ -n "$row" ] && [ -z "$pid" ] && break
		tries=$((tries + 1))
		if [ "$tries" -ge 10 ]; then
			hold "$sid" "$why; stop-pending"
			return
		fi
		sleep 1
	done
	wake "$sid" "$cfg" live-idle
}

report_stale() {
	local line
	jq -r --argjson now "$now" --argjson bound "$hold_bound" '
		.pending | to_entries[] | select(($now - .value.first_at) >= $bound and (.value.stale_reported | not))
		| "\(.key) \((($now - .value.first_at) / 60) | floor) \(.value.last_hold // "none" | gsub(" "; "_"))"' \
		"$work_state" >"$run_tmp/stale"
	while read -r sid mins why; do
		[ -n "$sid" ] || continue
		log "stale session=$(short "$sid") held=${mins}m reason=$why"
		echo "pr-notifier: events for session $(short "$sid") held ${mins}m (last: $why); see $log_file" >&2
		edit "$work_state" --arg s "$sid" '.pending[$s].stale_reported = true'
	done <"$run_tmp/stale"
}

cmd_check() {
	[ $# -eq 0 ] || usage
	load_settings
	if ! lock 0; then
		mkdir -p "$home" && log "check skipped=locked"
		return 0
	fi
	load_files
	claude_path=$(command -v "$claude_bin" 2>/dev/null) || claude_path=$claude_bin
	if jq -e '(.subscriptions | length) == 0' "$work_registry" >/dev/null &&
		jq -e '(.pending // {} | length) == 0' "$work_state" >/dev/null; then
		# Logged once an hour, not every 15 seconds: the line shows the job
		# runs, and job.last shows it too.
		if [ $((now - $(jq -r '.idle_logged_at // 0 | floor' "$work_state"))) -ge 3600 ]; then
			log "check skipped=no-subscriptions"
			edit "$work_state" --argjson now "$now" '.idle_logged_at = $now'
		fi
		save_files
		return 0
	fi
	poll_feed
	poll_prs
	examine_due
	local sid off
	# Sessions take turns going first: a few slow ones early in a fixed order
	# could otherwise spend delivery_budget on every check, and the rest
	# would never be reached.
	off=$(jq -r '.feed.delivery_turn // 0 | floor' "$work_state")
	jq -r --argjson off "$off" '.pending // {} | keys | (length) as $n
		| if $n == 0 then empty else (.[($off % $n):] + .[:($off % $n)])[] end' "$work_state" >"$run_tmp/sessions"
	edit "$work_state" --argjson off "$off" '.feed.delivery_turn = $off + 1'
	delivery_start=$SECONDS # the poll and the PR reads above don't count against delivery_budget
	while IFS= read -r sid; do
		[ -n "$sid" ] || continue
		deliver "$sid"
	done <"$run_tmp/sessions"
	report_stale
	save_files
}

case ${1:-} in
subscribe) shift; cmd_subscribe "$@" ;;
unsubscribe) shift; cmd_unsubscribe "$@" ;;
status) shift; cmd_status "$@" ;;
check) shift; cmd_check "$@" ;;
*) usage ;;
esac
