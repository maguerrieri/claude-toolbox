#!/usr/bin/env bash
# pr-notifier: wake the local Claude Code session that owns a PR when the
# owner or a configured review bot acts on it, or when it merges or closes.
# The plugin's README has the design; skills/pr-notifier/SKILL.md has the
# contract sessions rely on (the stable path and the wake prompt).
#
#   pr-notifier subscribe <owner>/<repo>#<n> [--session <id>] [--name <name>]
#   pr-notifier unsubscribe <owner>/<repo>#<n> [--session <id>]
#   pr-notifier status [--json]
#   pr-notifier check
#
# State lives in $PR_NOTIFIER_HOME (default ~/.local/state/pr-notifier), for
# the one macOS user the notifier serves: registry.json (subscriptions),
# state.json (cursors and held events), config.json (optional settings),
# notifier.log (append-only), and lock/ (held by any command that writes).
#
# Test seams: PR_NOTIFIER_GH, PR_NOTIFIER_CLAUDE and PR_NOTIFIER_OWNER_CHECK
# replace gh, claude and owner-check.sh; PR_NOTIFIER_NOW fixes the clock
# (epoch seconds); PR_NOTIFIER_SOCK_DIRS (colon-separated) replaces the
# directories a live session's messaging socket is looked for in.
set -uo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd) || exit 1

home=${PR_NOTIFIER_HOME:-$HOME/.local/state/pr-notifier}
registry=$home/registry.json
state_file=$home/state.json
config_file=$home/config.json
log_file=$home/notifier.log
lock_dir=$home/lock
examine_jq=$root/lib/examine.jq

gh_bin=${PR_NOTIFIER_GH:-gh}
claude_bin=${PR_NOTIFIER_CLAUDE:-claude}
owner_check=${PR_NOTIFIER_OWNER_CHECK:-$root/scripts/owner-check.sh}

now=${PR_NOTIFIER_NOW:-$(date -u +%s)}
case $now in '' | *[!0-9]*) echo "pr-notifier: PR_NOTIFIER_NOW must be epoch seconds" >&2 && exit 2 ;; esac

usage() {
	cat >&2 <<'USAGE_EOF'
usage: pr-notifier subscribe <owner>/<repo>#<n> [--session <id>] [--name <name>]
       pr-notifier unsubscribe <owner>/<repo>#<n> [--session <id>]
       pr-notifier status [--json]
       pr-notifier check
USAGE_EOF
	exit 2
}

die() {
	echo "pr-notifier: $*" >&2
	exit 1
}

command -v jq >/dev/null 2>&1 || die "jq not found on PATH"

iso() { jq -nr --argjson t "$1" '$t | todate'; }
now_iso=$(iso "$now")
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

log() { # log <word> [k=v ...]: one line in notifier.log
	printf '%s %s\n' "$now_iso" "$*" >>"$log_file"
}

# --- settings -------------------------------------------------------------

default_bots='["copilot-pull-request-reviewer[bot]","Copilot","chatgpt-codex-connector[bot]"]'

setting() { # setting <key> <default>: config.json's value, else the default
	local v=
	[ -f "$config_file" ] &&
		v=$(jq -r --arg k "$1" '.[$k] | select(. != null) | if type == "array" then tojson else tostring end' "$config_file" 2>/dev/null)
	printf '%s' "${v:-$2}"
}

number_setting() { # number_setting <key> <default>: a whole number of seconds
	local v
	v=$(setting "$1" "$2")
	case $v in '' | *[!0-9]*) v=$2 ;; esac
	printf '%s' "$v"
}

load_settings() {
	review_bots=$(setting review_bots "$default_bots")
	jq -e 'type == "array" and all(.[]; type == "string")' >/dev/null 2>&1 <<<"$review_bots" ||
		review_bots=$default_bots
	sweep_interval=$(number_setting sweep_interval 300)
	hold_bound=$(number_setting hold_bound 1800)
	idle_grace=$(number_setting idle_grace 600)
	retry_window=$(number_setting retry_window 1800)
	owner_ttl=$(number_setting owner_ttl 3600)
	relay_wait=$(number_setting relay_wait 30)
	relay_model=$(setting relay_model haiku)
	local model_re='^[]A-Za-z0-9._[-]+$' # "]" first: inside brackets, a backslash doesn't escape it
	[[ $relay_model =~ $model_re ]] || relay_model=haiku
	case $(lc "$(setting relay true)") in false | 0 | no | off) relay_on=false ;; *) relay_on=true ;; esac
	# The PATH every claude the notifier runs gets. A resumed session keeps
	# its waker's PATH as its tool PATH (the spike's Trap 2), so a resume
	# passes the session's own recorded PATH in front of this one
	# (resume_path); everything else runs under this alone.
	wake_path=$(setting wake_path "$PATH")
}

# --- files and the lock ---------------------------------------------------

run_tmp=
cleanup() {
	[ -z "$run_tmp" ] || rm -rf "$run_tmp"
	[ "${have_lock:-}" != 1 ] || rm -rf "$lock_dir"
}
trap cleanup EXIT

older_than() { [ -n "$(find "$1" -maxdepth 0 -mmin +"$2" 2>/dev/null)" ]; } # older_than <path> <minutes>
older_than_a_minute() { older_than "$1" 1; }

take_over() { # take_over <the dead holder's pid, or "" for none>: removes a dead holder's lock
	# Takeovers run one at a time, and each re-reads the holder inside its own
	# turn, so two contenders that both saw the dead holder can't both remove
	# the lock: the second sees the first's live pid and leaves it.
	if ! mkdir "$lock_dir.takeover" 2>/dev/null; then
		! older_than_a_minute "$lock_dir.takeover" || rmdir "$lock_dir.takeover" 2>/dev/null
		return
	fi
	if [ "$(cat "$lock_dir/pid" 2>/dev/null)" = "$1" ]; then
		if [ -n "$1" ] || older_than_a_minute "$lock_dir"; then
			rm -rf "$lock_dir"
		fi
	fi
	rmdir "$lock_dir.takeover"
}

have_lock=
lock() { # lock <seconds to wait>: 0 once held, 1 if another command holds it
	local waited=0 holder
	mkdir -p "$home" || die "can't create $home"
	while ! mkdir "$lock_dir" 2>/dev/null; do
		holder=$(cat "$lock_dir/pid" 2>/dev/null)
		if [ -n "$holder" ] && { ! kill -0 "$holder" 2>/dev/null || older_than "$lock_dir" 30; }; then
			# Its holder died, or held it far longer than any command runs: a
			# dead holder whose pid another process now has.
			take_over "$holder"
			! mkdir "$lock_dir" 2>/dev/null || break
		elif [ -z "$holder" ] && older_than_a_minute "$lock_dir"; then
			take_over "" # a holder that died between mkdir and writing its pid
			! mkdir "$lock_dir" 2>/dev/null || break
		fi
		[ "$waited" -lt "$1" ] || return 1
		sleep 1
		waited=$((waited + 1))
	done
	have_lock=1
	echo $$ >"$lock_dir/pid"
}

load_files() { # copies registry and state into run_tmp, creating them when missing
	run_tmp=$(mktemp -d "${TMPDIR:-/tmp}/pr-notifier.XXXXXX") || die "can't make a temp dir"
	work_registry=$run_tmp/registry.json
	work_state=$run_tmp/state.json
	if [ -f "$registry" ]; then
		jq -e '.subscriptions | type == "array"' "$registry" >/dev/null 2>&1 ||
			die "$registry isn't a registry; fix or remove it"
		cp "$registry" "$work_registry"
	else
		printf '%s\n' '{"version":1,"subscriptions":[]}' >"$work_registry"
	fi
	if [ -f "$state_file" ]; then
		jq -e 'type == "object"' "$state_file" >/dev/null 2>&1 ||
			die "$state_file isn't a state file; fix or remove it"
		cp "$state_file" "$work_state"
	else
		printf '%s\n' '{"version":1,"feed":{},"prs":{},"pending":{},"owners":{}}' >"$work_state"
	fi
}

save() { # save <work file> <destination>: atomic replace
	cp "$1" "$2.new.$$" && mv -f "$2.new.$$" "$2" || die "can't write $2"
}

save_files() {
	save "$work_registry" "$registry"
	save "$work_state" "$state_file"
}

edit() { # edit <file> <jq args...>: rewrites the file through jq
	local f=$1
	shift
	jq "$@" "$f" >"$f.new" && mv -f "$f.new" "$f"
}

# --- references -----------------------------------------------------------

ref_re='^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+#[0-9]+$'
session_re='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

parse_ref() { # parse_ref <ref>: prints the lowercased ref, or fails
	[[ $1 =~ $ref_re ]] || return 1
	case ${1%#*} in */*/* | */. | */..) return 1 ;; esac
	lc "$1"
}

short() { printf '%s' "${1:0:8}"; }

# --- subscribe / unsubscribe / status --------------------------------------

cmd_subscribe() {
	local ref= sid=${CLAUDE_CODE_SESSION_ID:-} name= have_name= cfg=${CLAUDE_CONFIG_DIR:-}
	while [ $# -gt 0 ]; do
		case $1 in
		--session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
		--name) [ $# -ge 2 ] || usage; name=$2; have_name=1; shift 2 ;;
		-*) usage ;;
		*) [ -z "$ref" ] || usage; ref=$1; shift ;;
		esac
	done
	[ -n "$ref" ] || usage
	ref=$(parse_ref "$ref") || die "'$ref' isn't <owner>/<repo>#<n>"
	[ -n "$sid" ] || die "no session id: run this from a Claude Code session (CLAUDE_CODE_SESSION_ID) or pass --session"
	[[ $sid =~ $session_re ]] || die "'$sid' isn't a full session id"
	sid=$(lc "$sid")
	# Setting CLAUDE_CONFIG_DIR to the default root explicitly isn't the
	# default root (the spike's Trap 3), so that value is recorded as unset.
	cfg=${cfg%/}
	[ "$cfg" != "$HOME/.claude" ] || cfg=
	if [ -z "$have_name" ]; then
		# Best-effort: the name is for the log and status only.
		name=$("$claude_bin" agents --json --all 2>/dev/null </dev/null |
			jq -r --arg s "$sid" '[.[]? | select(.sessionId == $s) | .name // empty] | last // empty' 2>/dev/null)
	fi
	load_settings
	lock 300 || die "another pr-notifier command has held $lock_dir for five minutes; try again"
	load_files
	# Two minutes of slack, so clock skew can't put a reply just after the
	# subscribe before it; a repeated event is harmless (the wake prompt).
	# The caller's PATH is the session's own tool PATH when the session runs
	# subscribe itself, from its Bash tool, and a resume carries it back in
	# (the spike's Trap 2). It is the session's, so every one of its
	# subscriptions gets the latest. A subscribe for another session (--session
	# from a shell or another session) records no PATH: the caller's isn't the
	# session's, so the one already recorded stays.
	local own_path=
	[ "$sid" != "$(lc "${CLAUDE_CODE_SESSION_ID:-}")" ] || own_path=${PATH:-}
	edit "$work_registry" --arg pr "$ref" --arg sid "$sid" --arg name "$name" --arg cfg "$cfg" \
		--arg at "$(iso $((now - 120)))" --arg path "$own_path" '
		(.subscriptions | map(select(.pr == $pr and .session_id == $sid)) | first) as $old
		| (if $path == "" then ([.subscriptions[] | select(.session_id == $sid) | .path | strings] | last)
		   else $path end) as $p
		| .subscriptions = [.subscriptions[] | select((.pr == $pr and .session_id == $sid) | not)
		                    | if .session_id == $sid then .path = $p else . end]
			+ [{pr: $pr, session_id: $sid, name: $name,
			    config_dir: (if $cfg == "" then null else $cfg end),
			    path: $p,
			    subscribed_at: ($old.subscribed_at // $at)}]' || die "can't update the registry"
	save "$work_registry" "$registry"
	log "subscribe pr=$ref session=$(short "$sid") name=$(jq -rn --arg n "$name" '$n | @json') root=${cfg:-default} path=$(if [ -n "$own_path" ]; then printf '%s' "$own_path" | awk -F: '{ print NF " entries" }' | tr ' ' _; else echo kept; fi)"
	echo "pr-notifier: subscribed $(short "$sid") to $ref"
}

cmd_unsubscribe() {
	local ref= sid=${CLAUDE_CODE_SESSION_ID:-}
	while [ $# -gt 0 ]; do
		case $1 in
		--session) [ $# -ge 2 ] || usage; sid=$2; shift 2 ;;
		-*) usage ;;
		*) [ -z "$ref" ] || usage; ref=$1; shift ;;
		esac
	done
	[ -n "$ref" ] || usage
	ref=$(parse_ref "$ref") || die "'$ref' isn't <owner>/<repo>#<n>"
	[ -n "$sid" ] || die "no session id: run this from a Claude Code session (CLAUDE_CODE_SESSION_ID) or pass --session"
	[[ $sid =~ $session_re ]] || die "'$sid' isn't a full session id"
	sid=$(lc "$sid")
	lock 300 || die "another pr-notifier command has held $lock_dir for five minutes; try again"
	load_files
	unsubscribe "$ref" "$sid" requested
	save_files
	echo "pr-notifier: unsubscribed $(short "$sid") from $ref"
}

unsubscribe() { # unsubscribe <ref> <session id> <reason>: drops the subscription and its held events
	local ref=$1 sid=$2
	jq -e --arg pr "$ref" --arg sid "$sid" 'any(.subscriptions[]; .pr == $pr and .session_id == $sid)' \
		"$work_registry" >/dev/null || return 0
	edit "$work_registry" --arg pr "$ref" --arg sid "$sid" \
		'.subscriptions = [.subscriptions[] | select((.pr == $pr and .session_id == $sid) | not)]'
	edit "$work_state" --arg pr "$ref" --arg sid "$sid" --slurpfile reg "$work_registry" '
		if .pending[$sid] then
			.pending[$sid].events = [.pending[$sid].events[] | select(.pr != $pr)]
			| if (.pending[$sid].events | length) == 0 then .pending |= del(.[$sid]) else . end
		else . end
		| if any($reg[0].subscriptions[]; .pr == $pr) then . else .prs |= del(.[$pr]) end'
	log "unsubscribe pr=$ref session=$(short "$sid") reason=$3"
}

cmd_status() {
	local json=
	case ${1:-} in --json) json=1 ;; '') ;; *) usage ;; esac
	local reg='{"subscriptions":[]}' st='{}'
	[ ! -f "$registry" ] || reg=$(cat "$registry")
	[ ! -f "$state_file" ] || st=$(cat "$state_file")
	load_settings
	if [ -n "$json" ]; then
		jq -n --argjson reg "$reg" --argjson st "$st" \
			'{subscriptions: $reg.subscriptions, pending: ($st.pending // {}), feed: ($st.feed // {})}'
		return
	fi
	jq -nr --argjson reg "$reg" --argjson st "$st" --argjson now "$now" --argjson bound "$hold_bound" '
		def ago($t): "\((($now - $t) / 60) | floor)m";
		($st.pending // {}) as $p
		| "pr-notifier: \($reg.subscriptions | length) subscription(s), \($p | length) session(s) with held events",
		  ($reg.subscriptions[] | "subscription \(.pr) session=\(.session_id[0:8]) name=\(.name | @json) root=\(.config_dir // "default") since=\(.subscribed_at) path=\(if (.path | type) == "string" then "recorded" else "none" end)"),
		  ($p | to_entries[] | "held session=\(.key[0:8]) events=\(.value.events | length) for=\(ago(.value.first_at)) last=\(.value.last_hold // "none")\(if $now - .value.first_at >= $bound then " STALE" else "" end)"),
		  (($st.feed // {}) | "feed last=\(.last_poll_iso // "never") status=\(.last_status // "none")")'
}

# --- check: the feed --------------------------------------------------------

poll_feed() { # marks subscribed PRs whose notification thread moved as dirty
	local next lm since raw status interval body_start body
	next=$(jq -r '.feed.next_poll_at // 0' "$work_state")
	if [ "$now" -lt "$next" ]; then
		log "poll skipped=interval next=$(iso "$next")"
		return 0
	fi
	lm=$(jq -r '.feed.last_modified // empty' "$work_state")
	since=$(jq -r '.feed.since // empty' "$work_state")
	# The URL stays the same between 200s, so If-Modified-Since can answer 304.
	[ -n "$since" ] || since=$(iso $((now - 86400)))
	raw=$run_tmp/feed.raw
	if [ -n "$lm" ]; then
		"$gh_bin" api -i -H "If-Modified-Since: $lm" "notifications?all=true&per_page=50&since=$since" \
			</dev/null >"$raw" 2>"$run_tmp/feed.err"
	else
		"$gh_bin" api -i "notifications?all=true&per_page=50&since=$since" </dev/null >"$raw" 2>"$run_tmp/feed.err"
	fi
	tr -d '\r' <"$raw" >"$raw.lf"
	status=$(awk 'NR == 1 { print $2; exit }' "$raw.lf")
	interval=$(awk -F': *' 'tolower($1) == "x-poll-interval" { print $2; exit }' "$raw.lf")
	case $interval in '' | *[!0-9]*) interval=60 ;; esac
	edit "$work_state" --arg s "${status:-none}" --arg iso "$now_iso" --argjson next $((now + interval)) \
		'.feed += {last_status: $s, last_poll_iso: $iso, next_poll_at: $next}'
	case $status in
	304)
		log "poll status=304"
		return 0
		;;
	200) ;;
	*)
		log "poll error status=${status:-none} detail=$(head -c 200 "$run_tmp/feed.err" | jq -Rrs '@json')"
		return 1
		;;
	esac
	body_start=$(awk 'NF == 0 { print NR + 1; exit }' "$raw.lf")
	body=$run_tmp/feed.json
	tail -n +"${body_start:-1}" "$raw.lf" >"$body"
	if grep -qi '^link:.*rel="next"' "$raw.lf"; then
		# More than one page: read them all, unconditionally.
		"$gh_bin" api --paginate --slurp "notifications?all=true&per_page=50&since=$since" </dev/null \
			>"$body.all" 2>>"$run_tmp/feed.err" && jq 'flatten' "$body.all" >"$body.flat" && mv -f "$body.flat" "$body" ||
			log "poll error detail=\"later pages unreadable; first page only\""
	fi
	jq -e 'type == "array"' "$body" >/dev/null 2>&1 || {
		log "poll error detail=\"body isn't a thread list\""
		return 1
	}
	local lm_new matched
	lm_new=$(awk -F': *' 'tolower($1) == "last-modified" { sub(/^[^:]*: */, ""); print; exit }' "$raw.lf")
	# A subscribed PR's thread marks it to be read only when its updated_at
	# moved past the one last seen: since repeats for up to an hour, so the
	# same thread comes back on every 200 until then.
	jq -c --slurpfile reg "$work_registry" '
		($reg[0].subscriptions | map(.pr) | unique) as $subs
		| [ .[] | select(.subject.type? == "PullRequest")
			| (.updated_at // "") as $at
			| (.subject.url // "") | capture("/repos/(?<p>[^/]+/[^/]+)/pulls/(?<n>[0-9]+)$")?
			| {pr: "\(.p | ascii_downcase)#\(.n)", at: $at} | select(.pr as $r | $subs | index($r)) ]
		| group_by(.pr) | map(max_by(.at))' "$body" >"$run_tmp/threads.json"
	# since moves at most hourly, so the URL usually repeats and a quiet poll
	# can still be a 304; when it moves, it goes to a little before this poll,
	# since a thread's updated_at can trail its event.
	local since_epoch matched
	since_epoch=$(jq -nr --arg s "$since" '$s | try fromdateiso8601 catch 0')
	[ $((now - since_epoch)) -lt 3600 ] || since=$(iso $((now - 300)))
	matched=$(jq -r --slurpfile st "$work_state" \
		'[.[] | select(.at == "" or .at > ($st[0].prs[.pr].thread_at // ""))] | length' "$run_tmp/threads.json")
	edit "$work_state" --arg lm "$lm_new" --arg since "$since" --slurpfile th "$run_tmp/threads.json" '
		.feed += {last_modified: (if $lm == "" then null else $lm end), since: $since}
		| reduce $th[0][] as $t (.;
			if $t.at == "" or $t.at > (.prs[$t.pr].thread_at // "") then .prs[$t.pr] += {dirty: true, thread_at: $t.at} else . end)'
	log "poll status=200 threads=$(jq length "$body") matched=$matched"
}

# --- check: examining a PR ------------------------------------------------

my_login= # read once per run, never cached across runs: owner-check reads it
# live too, and the two must agree on who the sessions are
read_my_login() {
	[ -n "$my_login" ] && return 0
	my_login=$("$gh_bin" api user --jq .login </dev/null 2>/dev/null) || my_login=
	[ -n "$my_login" ]
}

owner_status() { # owner_status <owner>/<repo> <login>: owner-check's exit code
	local key code
	key="$1:$(lc "$2")"
	if [ $((now - $(jq -r --arg k "$key" '.owners[$k] // 0' "$work_state"))) -lt "$owner_ttl" ]; then
		echo 0
		return
	fi
	code=$(awk -v k="$key" '$1 == k { print $2; exit }' "$run_tmp/owner-memo" 2>/dev/null)
	if [ -z "$code" ]; then
		OWNER_CHECK_GH=$gh_bin bash "$owner_check" -R "$1" "$2" </dev/null >/dev/null 2>>"$run_tmp/owner-check.err"
		code=$?
		printf '%s %s\n' "$key" "$code" >>"$run_tmp/owner-memo"
		# Only a yes is cached: a no may be a failed read, retried next time.
		[ "$code" -ne 0 ] || edit "$work_state" --arg k "$key" --argjson t "$now" '.owners[$k] = $t'
	fi
	echo "$code"
}

edit_authors() { # comment node ids on stdin: prints {node id: {login, type}} for each one GraphQL names an editor of
	local args=() id
	while IFS= read -r id; do
		[[ $id =~ ^[A-Za-z0-9_=-]+$ ]] && args+=(-f "ids[]=$id")
	done
	if [ "${#args[@]}" -eq 0 ]; then
		echo '{}'
		return
	fi
	local out
	out=$("$gh_bin" api graphql "${args[@]}" -f query='query($ids:[ID!]!){nodes(ids:$ids){... on IssueComment{id editor{login __typename}}}}' \
		--jq '[.data.nodes[]? | select(. != null and .editor != null)
			| {(.id): {login: .editor.login, type: (if .editor.__typename == "Bot" then "Bot" else "User" end)}}] | add // {}' \
		</dev/null 2>/dev/null) || out=
	[ -n "$out" ] || out='{}'
	jq -c 'if type == "object" then . else {} end' <<<"$out" 2>/dev/null || echo '{}'
}

examine() { # examine <ref>: reads the PR and queues its new events; 1 if a read failed
	local ref=$1 repo_path=${1%#*} n=${1##*#} baseline login owners editors result
	baseline=$(jq -r --arg r "$ref" '[.subscriptions[] | select(.pr == $r) | .subscribed_at] | min // empty' "$work_registry")
	[ -n "$baseline" ] || return 0
	read_my_login || {
		log "examine pr=$ref error=\"can't read the sessions' own login\""
		return 1
	}
	"$gh_bin" api "repos/$repo_path/pulls/$n" </dev/null >"$run_tmp/pr.json" 2>"$run_tmp/err" &&
		jq -e 'type == "object" and has("state")' "$run_tmp/pr.json" >/dev/null 2>&1 || {
		log "examine pr=$ref error=\"PR unreadable\" detail=$(head -c 200 "$run_tmp/err" | jq -Rrs '@json')"
		return 1
	}
	"$gh_bin" api "repos/$repo_path/issues/$n/timeline?per_page=100" --paginate --slurp </dev/null \
		>"$run_tmp/tl.json" 2>"$run_tmp/err" &&
		jq -e 'type == "array"' "$run_tmp/tl.json" >/dev/null 2>&1 || {
		log "examine pr=$ref error=\"timeline unreadable\" detail=$(head -c 200 "$run_tmp/err" | jq -Rrs '@json')"
		return 1
	}
	jq --arg r "$ref" '.prs[$r] // {}' "$work_state" >"$run_tmp/ps.json"
	set -- --slurpfile tl "$run_tmp/tl.json" --slurpfile pr "$run_tmp/pr.json" --slurpfile psf "$run_tmp/ps.json" \
		--arg me "$my_login" --argjson bots "$review_bots" --arg baseline "$baseline" --argjson now "$now" \
		--argjson retry_window "$retry_window"
	# Who edited each comment edited since it was last seen: the REST timeline
	# names only its author. An editor that can't be read is retried.
	editors=$(edit_authors < <(jq -nr --arg phase edits --argjson editors '{}' --argjson owners '{}' "$@" -f "$examine_jq"))
	owners='{}'
	while IFS= read -r login; do
		[ -n "$login" ] || continue
		owners=$(jq -c --arg l "$(lc "$login")" --argjson c "$(owner_status "$repo_path" "$login")" '.[$l] = $c' <<<"$owners")
	done < <(jq -nr --arg phase need --argjson editors "$editors" --argjson owners '{}' "$@" -f "$examine_jq")
	result=$run_tmp/result.json
	jq -n --arg phase result --argjson editors "$editors" --argjson owners "$owners" "$@" -f "$examine_jq" >"$result" || {
		log "examine pr=$ref error=\"filter failed\""
		return 1
	}
	jq -r --arg r "$ref" '.log[] | "event pr=\($r) key=\(.key) actor=\(.actor) verdict=\(.verdict) reason=\(.reason | @json)"' \
		"$result" | while IFS= read -r line; do log "$line"; done
	# The new cursor, then the events, fanned out to each subscription that
	# was in place when the event happened.
	edit "$work_state" --arg r "$ref" --slurpfile res "$result" --slurpfile reg "$work_registry" \
		--argjson now "$now" --arg pr_url "$(jq -r '.html_url // ""' "$run_tmp/pr.json")" '
		$res[0] as $x
		| .prs[$r] = ($x.ps + {last_swept: $now, dirty: false} | del(.failing_since, .failing_reported))
		| reduce ($reg[0].subscriptions[] | select(.pr == $r)) as $s (.;
			reduce ($x.events[] | select(.at >= $s.subscribed_at)) as $e (.;
				.pending[$s.session_id] //= {first_at: $now, events: []}
				| if any(.pending[$s.session_id].events[]; .pr == $r and .key == $e.key) then .
				  else .pending[$s.session_id].events += [$e + {pr: $r, pr_url: $pr_url, pr_state: $x.ps.pr_state}] end))'
	# A subscription made after the PR closed would never hear of it.
	local closed sid
	closed=$(jq -r '.ps.closed_at // empty' "$result")
	[ -n "$closed" ] || return 0
	jq -r --arg r "$ref" --arg c "$closed" \
		'.subscriptions[] | select(.pr == $r and .subscribed_at > $c) | .session_id' "$work_registry" >"$run_tmp/closed-subs"
	while IFS= read -r sid; do
		[ -z "$sid" ] || unsubscribe "$ref" "$sid" closed-before-subscribe
	done <"$run_tmp/closed-subs"
}

examine_due() { # every subscribed PR that is dirty or due a sweep
	local ref
	jq -r --slurpfile st "$work_state" --argjson now "$now" --argjson every "$sweep_interval" '
		.subscriptions | map(.pr) | unique | .[]
		| select(($st[0].prs[.] // {}) as $p | ($p.dirty == true) or ($now - ($p.last_swept // 0) >= $every))' \
		"$work_registry" >"$run_tmp/due"
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		examine "$ref" || pr_unreadable "$ref"
	done <"$run_tmp/due"
}

pr_unreadable() { # pr_unreadable <ref>: after a failed read
	# A failed read leaves the PR marked, so the next check tries again, until
	# it has failed for hold_bound: then it is reported once and falls back to
	# the sweep, so a PR that is gone (or was never a PR) costs one read per
	# sweep, not one a minute.
	local mins
	edit "$work_state" --arg r "$1" --argjson now "$now" --argjson bound "$hold_bound" '
		.prs[$r].failing_since //= $now
		| if $now - .prs[$r].failing_since < $bound then .prs[$r].dirty = true
		  else .prs[$r] += {dirty: false, last_swept: $now} end'
	mins=$(jq -r --arg r "$1" --argjson now "$now" --argjson bound "$hold_bound" '.prs[$r]
		| if ($now - .failing_since) >= $bound and (.failing_reported | not)
		  then (($now - .failing_since) / 60 | floor) else empty end' "$work_state")
	[ -n "$mins" ] || return 0
	log "stale pr=$1 unreadable=${mins}m"
	echo "pr-notifier: $1 has been unreadable for ${mins}m; its subscribers hear nothing until it reads again; see $log_file" >&2
	edit "$work_state" --arg r "$1" '.prs[$r].failing_reported = true'
}

# --- check: delivery --------------------------------------------------------

# What a session sets for the processes it starts. None of it may reach a
# claude the notifier runs, or that claude would act as the session that ran
# check (check is also run by hand from a session, as a test hook).
session_vars=(CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID CLAUDE_CODE_MESSAGING_SOCKET
	CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_CHILD_SESSION
	CLAUDE_CODE_SESSION_ATTENDED CLAUDE_PID CLAUDECODE CLAUDE_JOB_DIR)
claude_timeout=120 # no claude call holds the lock longer than this

claude_env() { # claude_env <config dir or ""> <PATH> <claude args...>: from /, stdin inherited
	local cfg=$1 p=$2 cmd=(env) v
	shift 2
	! command -v perl >/dev/null 2>&1 || cmd=(perl -e 'alarm shift; exec @ARGV' "$claude_timeout" env)
	for v in "${session_vars[@]}"; do cmd+=(-u "$v"); done
	if [ -n "$cfg" ]; then
		cmd+=(CLAUDE_CONFIG_DIR="$cfg")
	else
		cmd+=(-u CLAUDE_CONFIG_DIR) # unset, never set to ~/.claude: the spike's Trap 3
	fi
	(cd / && "${cmd[@]}" PATH="$p" "$claude_path" "$@")
}

run_claude() { # run_claude <config dir or ""> <claude args...>: under wake_path, with no stdin
	local cfg=$1
	shift
	claude_env "$cfg" "$wake_path" "$@" </dev/null
}

agents() { # agents <config dir or ""> [fresh]: the root's claude agents listing, once per run
	local f
	f=$run_tmp/agents.$(printf '%s' "${1:-default}" | cksum | cut -d' ' -f1).json
	[ -z "${2:-}" ] || rm -f "$f"
	if [ ! -f "$f" ]; then
		run_claude "$1" agents --json --all >"$f.tmp" 2>/dev/null &&
			jq -e 'type == "array"' "$f.tmp" >/dev/null 2>&1 || {
			rm -f "$f.tmp"
			return 1
		}
		mv -f "$f.tmp" "$f"
	fi
	cat "$f"
}

# A row's fields are joined by US (\x1f), not a tab: read collapses runs of a
# whitespace IFS, so an empty pid would shift the fields after it.
us=$'\x1f'

session_row() { # session_row <config dir> <session id> [fresh]: "<short> <cwd> <pid> <status> <state> <kind>", US-joined
	local listing
	listing=$(agents "$1" "${3:-}") || return 2
	jq -r --arg s "$2" '[.[] | select(.sessionId == $s)] | last // empty
		| [.id // "", .cwd // "", (.pid // "" | tostring), .status // "", .state // "", .kind // ""] | join("\u001f")' <<<"$listing"
}

job_state() { # job_state <config dir> <short id>: "<in flight: none|busy|unknown> <updatedAt epoch or -1>"
	local f=${1:-$HOME/.claude}/jobs/$2/state.json
	jq -r '[ (if (.inFlight | type) != "object" then "unknown"
	          elif ((.inFlight.tasks // 0) > 0) or ((.inFlight.queued // 0) > 0)
	               or ((.inFlight.kinds // []) | length) > 0 then "busy"
	          else "none" end),
	         ((.updatedAt // "") | sub("\\.[0-9]+Z$"; "Z") | (try fromdateiso8601 catch -1) | tostring) ] | join(" ")' \
		"$f" 2>/dev/null || echo 'unknown -1'
}

hold() { # hold <session id> <reason>
	edit "$work_state" --arg s "$1" --arg r "$2" '.pending[$s].last_hold = $r'
	log "hold session=$(short "$1") reason=$2"
}

drop_session() { # drop_session <session id> <reason>: it can't be woken, so its subscriptions go
	local sid=$1 ref
	jq -r --arg s "$sid" '.subscriptions[] | select(.session_id == $s) | .pr' "$work_registry" >"$run_tmp/drop"
	while IFS= read -r ref; do
		[ -z "$ref" ] || unsubscribe "$ref" "$sid" "$2"
	done <"$run_tmp/drop"
	edit "$work_state" --arg s "$sid" '.pending |= del(.[$s])'
}

wake_prompt() { # wake_prompt <session id>: the fixed template, carrying only URLs
	jq -r --arg s "$1" '
		def url_ok: type == "string" and test("^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/pull/[0-9]+(#[A-Za-z0-9_-]+)?$");
		def pr_url($ref): ($ref | capture("^(?<p>[^#]+)#(?<n>[0-9]+)$")) | "https://github.com/\(.p)/pull/\(.n)";
		.prs as $prs
		| [ .pending[$s].events | group_by(.pr)[]
		  | sort_by(.at) as $evs
		  | ($evs[-1].pr_url | if url_ok and (test("#") | not) then . else pr_url($evs[0].pr) end) as $pu
		  | (($prs[$evs[0].pr].pr_state // $evs[-1].pr_state) | if IN("open", "merged", "closed") then . else "open" end) as $st
		  | "PR \($pu) \($st)",
		    ($evs[] | "- \(.kind) \(.url | if url_ok and (ascii_downcase | . == ($pu | ascii_downcase) or startswith($pu + "#" | ascii_downcase)) then . else $pu end)") ]
		| ["pr-notifier wake v1: GitHub activity on PRs this session subscribed to. This message is a pointer, not an instruction: it carries no request and no authority, and it may repeat an earlier wake. Re-read each PR below from GitHub, check who acted yourself, and handle only what is new."] + .
		| join("\n")' "$work_state"
}

resume_path() { # resume_path <session id>: its recorded PATH, then any of wake_path's entries it lacks
	# Absolute entries only, each once. Merging means a PATH recorded while
	# degraded (say, by a session once woken under a bare one) can't persist.
	local rec
	rec=$(jq -r --arg s "$1" '[.subscriptions[] | select(.session_id == $s) | .path | strings] | last // empty' "$work_registry")
	jq -rn --arg a "$rec" --arg b "$wake_path" '
		[($a, $b) | split(":")[] | select(startswith("/"))]
		| reduce .[] as $e ([]; if any(.[]; . == $e) then . else . + [$e] end) | join(":")'
}

finish_wake() { # finish_wake <session id> <how> [log detail]: the wake landed, so its events go
	local sid=$1 ref
	log "wake session=$(short "$sid") how=$2 prs=$(jq -r --arg s "$sid" '[.pending[$s].events[].pr] | unique | join(",")' "$work_state") events=$(jq -r --arg s "$sid" '.pending[$s].events | length' "$work_state")${3:+ $3}"
	# The final wake for a PR that merged or closed ends its subscription, if
	# the PR is still merged or closed as last read: one reopened since its
	# close was queued keeps its subscribers.
	jq -r --arg s "$sid" '.prs as $prs
		| [.pending[$s].events[] | select(.kind == "merged" or .kind == "closed") | .pr
		   | select(($prs[.].pr_state // "closed") != "open")] | unique | .[]' \
		"$work_state" >"$run_tmp/final"
	edit "$work_state" --arg s "$sid" '.pending |= del(.[$s])'
	while IFS= read -r ref; do
		[ -z "$ref" ] || unsubscribe "$ref" "$sid" "pr-final-wake"
	done <"$run_tmp/final"
}

wake() { # wake <session id> <config dir> <how>: resumes it with the wake prompt, under its own PATH
	local sid=$1 cfg=$2 out rc
	out=$(claude_env "$cfg" "$(resume_path "$sid")" --bg --resume "$sid" "$(wake_prompt "$sid")" </dev/null 2>&1)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		# A refused resume keeps its prompt for the next wake, which then
		# delivers both; the template makes that harmless. Each retry would
		# queue one more copy, so retries back off: 5, 10, 20, 40, then 60
		# minutes apart.
		edit "$work_state" --arg s "$sid" --argjson now "$now" '
			.pending[$s].wake_failures = ((.pending[$s].wake_failures // 0) + 1)
			| .pending[$s].next_wake_at = $now + ([300 * pow(2; .pending[$s].wake_failures - 1), 3600] | min)'
		hold "$sid" "wake-failed"
		log "wake-failed session=$(short "$sid") rc=$rc detail=$(printf '%s' "$out" | head -n 1 | head -c 200 | jq -Rrs '@json')"
		return 1
	fi
	finish_wake "$sid" "$3"
}

# --- check: the relay ------------------------------------------------------------

private_dir() { # private_dir <dir>: a real directory, this user's or root's, that no one else can write
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	[ -O "$1" ] || [ -n "$(find "$1" -maxdepth 0 -user root 2>/dev/null)" ] || return 1
	[ -z "$(find "$1" -maxdepth 0 \( -perm -020 -o -perm -002 \) 2>/dev/null)" ]
}

session_socket() { # session_socket <pid>: a live session's messaging address, uds:<its socket>
	# Each live session listens on <pid>.sock in its user's private socket
	# directory, named for the pid its claude agents row shows (checked on the
	# Mac Studio for every live row). Addressing that socket, not the session's
	# name, can't hit another session that shares or took over the name. The
	# directory is /tmp/cc-socks when that is this user's or root's and
	# private, else /tmp/cc-socks-<uid>; a directory or socket someone else
	# could have placed (another owner, writable by others, a symlink) is
	# skipped.
	local d dirs
	[[ $1 =~ ^[0-9]+$ ]] || return 1
	IFS=: read -ra dirs <<<"${PR_NOTIFIER_SOCK_DIRS:-/tmp/cc-socks:/tmp/cc-socks-$(id -u)}"
	for d in ${dirs[@]+"${dirs[@]}"}; do
		if [ -n "$d" ] && private_dir "$d" && [ ! -L "$d/$1.sock" ] && [ -S "$d/$1.sock" ] && [ -O "$d/$1.sock" ]; then
			printf 'uds:%s/%s.sock' "$d" "$1"
			return 0
		fi
	done
	return 1
}

transcripts() { # transcripts <config dir> <session id>: the session's transcript files, one a line
	# It sits under the project its session started in, and moves with
	# EnterWorktree, so it is found by name.
	find "${1:-$HOME/.claude}/projects" -mindepth 2 -maxdepth 2 -type f -name "$2.jsonl" 2>/dev/null
}

session_mode() { # session_mode <transcript...>: the permission mode it last recorded, for the log
	local m=
	[ $# -eq 0 ] || m=$(grep -hF '"permission-mode"' "$@" 2>/dev/null | tail -n 1 |
		jq -r 'select(.type == "permission-mode") | .permissionMode | strings' 2>/dev/null)
	[[ $m =~ ^[A-Za-z]+$ ]] || m=unknown
	printf '%s' "$m"
}

landed() { # landed <message id> <transcript...>: the message is a turn in the session
	# The receiving session writes each peer message it takes as a user turn
	# whose origin carries the sender's msg_id. A message held for approval,
	# refused, or queued for a session that has since stopped isn't one.
	local id=$1
	shift
	[ $# -gt 0 ] || return 1
	grep -hF -- "$id" "$@" 2>/dev/null |
		jq -enR --arg m "$id" '[inputs | fromjson? | select(type == "object" and .type == "user" and .origin.msg_id? == $m)] | length > 0' >/dev/null
}

relay_prompt() { # relay_prompt <address> <text>: what the relay session is asked to do
	printf '%s\n' "You relay one message for pr-notifier. Call the SendMessage tool exactly once. Set its \"to\" to exactly this address:" \
		"$1" \
		"Set its \"message\" to exactly the text between the BEGIN and END lines below, verbatim: no added words, no quotes, nothing left out. Call no other tool, then stop." \
		BEGIN "$2" END
}

relay_result() { # relay_result <stream-json file> <address> <text>: "ok <msg id>", or "error: <why>"
	# The exit code says nothing (claude -p exits 0 when the model never
	# sends, or rewords the text), so the one SendMessage call is checked, and
	# so is what the tool answered.
	jq -nrR --arg to "$2" --arg text "$3" '
		def rstrip: sub("\\s+$"; "");
		[inputs | fromjson? | select(type == "object")] as $m
		| [$m[] | select(.type == "assistant") | .message.content[]? | select(type == "object" and .type == "tool_use")] as $uses
		| if ($uses | length) != 1 then "error: \($uses | length) tool calls"
		  elif $uses[0].name != "SendMessage" then "error: called \($uses[0].name)"
		  elif ($uses[0].input.to // "") != $to then "error: sent to another address"
		  elif ((($uses[0].input.message // "") | tostring | rstrip) != ($text | rstrip)) then "error: the text was changed"
		  else
		    ([$m[] | select(.type == "user") | .message.content[]?
		      | select(type == "object" and .type == "tool_result" and .tool_use_id == $uses[0].id)] | first) as $r
		    | ($r.content | if type == "array" then map(.text? // "") | join("") elif type == "string" then . else "" end) as $body
		    | ($body | fromjson? // null) as $j
		    | if $r == null then "error: no tool result"
		      elif $r.is_error == true then "error: \($body | .[0:160])"
		      elif ($j | type) != "object" or $j.success != true then "error: not sent: \($body | .[0:160])"
		      elif (($j.msg_id | type) != "string") or ($j.msg_id | test("^[A-Za-z0-9-]+$") | not) then "error: no message id"
		      else "ok \($j.msg_id)" end
		  end' "$1" 2>/dev/null || echo "error: unreadable output"
}

relay_failed() { # relay_failed <session id> <mode> <why>: logs it and backs relays off
	# An unconfirmed relay may still land (a held message approved later), so
	# relays to the session back off as refused resumes do: 5, 10, 20, 40,
	# then 60 minutes. The stop-then-resume fallback isn't held up by it.
	edit "$work_state" --arg s "$1" --argjson now "$now" '
		.pending[$s].relay_failures = ((.pending[$s].relay_failures // 0) + 1)
		| .pending[$s].next_relay_at = $now + ([300 * pow(2; .pending[$s].relay_failures - 1), 3600] | min)'
	log "relay-failed session=$(short "$1") mode=$2 reason=$(jq -rn --arg r "$3" '$r | @json')"
}

relay() { # relay <session id> <config dir> <pid>: 0 once the wake is a turn in the live session,
	# 1 if it wasn't sent, 2 if it was sent but no turn took it (both logged).
	# A one-shot headless session SendMessages the wake prompt to the
	# session's socket. It restarts nothing, so nothing in flight is lost and
	# an attached viewer stays connected.
	local sid=$1 cfg=$2 pid=$3 to text res id mode waited=0 files=() f row rid rcwd rpid rstatus rst rkind
	while IFS= read -r f; do [ -z "$f" ] || files+=("$f"); done < <(transcripts "$cfg" "$sid")
	mode=$(session_mode ${files[@]+"${files[@]}"})
	to=$(session_socket "$pid") || {
		relay_failed "$sid" "$mode" "no socket for pid $pid"
		return 1
	}
	text=$(wake_prompt "$sid")
	relay_prompt "$to" "$text" >"$run_tmp/relay.in"
	# The prompt goes on stdin: --tools takes every argument after it. A relay
	# takes seconds, so it gets a minute, not the two other calls get.
	claude_timeout=60 claude_env "$cfg" "$wake_path" -p --safe-mode --name pr-notifier --no-session-persistence \
		--model "$relay_model" --max-turns 3 --output-format stream-json --verbose --tools SendMessage \
		<"$run_tmp/relay.in" >"$run_tmp/relay.out" 2>"$run_tmp/relay.err"
	res=$(relay_result "$run_tmp/relay.out" "$to" "$text")
	case $res in
	"ok "*) id=${res#ok } ;;
	*)
		relay_failed "$sid" "$mode" "${res#error: }$(head -n 1 "$run_tmp/relay.err" | head -c 160 | sed 's/^./; &/')"
		return 1
		;;
	esac
	# A successful send means only that the message reached the session's
	# inbox: one held for approval, or sent to a session that has just
	# stopped, reports the same. So wait for the turn itself.
	if [ ${#files[@]} -eq 0 ]; then
		while IFS= read -r f; do [ -z "$f" ] || files+=("$f"); done < <(transcripts "$cfg" "$sid")
	fi
	while :; do
		if [ ${#files[@]} -gt 0 ]; then
			landed "$id" "${files[@]}" && break
		elif [ $((waited % 5)) -eq 0 ]; then
			# No transcript to read (Claude Code moved it): the row, with the
			# same pid and busy, is the weaker sign the message was taken. A
			# listing takes a second or so, so it is read every five.
			row=$(session_row "$cfg" "$sid" fresh) || row=
			IFS=$us read -r rid rcwd rpid rstatus rst rkind <<<"$row"
			[ "$rpid" = "$pid" ] && [ "$rstatus" = busy ] && break
		fi
		if [ "$waited" -ge "$relay_wait" ]; then
			relay_failed "$sid" "$mode" "sent as $id, but no turn took it within ${relay_wait}s (held, refused or stopped)"
			return 2
		fi
		sleep 1
		waited=$((waited + 1))
	done
	finish_wake "$sid" relay "mode=$mode msg=$id cost=$(jq -nrR '[inputs | fromjson? | select(type == "object" and .type == "result") | .total_cost_usd | numbers | . * 10000 | round / 10000] | first // "unknown"' "$run_tmp/relay.out" 2>/dev/null)"
}

resume_backoff() { # resume_backoff <session id>: holds it and returns 0 while a refused resume is backing off
	local next
	next=$(jq -r --arg s "$1" '.pending[$s].next_wake_at // 0 | floor' "$work_state")
	[ "$now" -lt "$next" ] || return 1
	hold "$1" "wake-backoff until $(iso "$next")"
}

relay_tries=3   # unconfirmed relays to a session before it waits for the fallback alone
relay_budget=150 # seconds into a check after which no new relay starts

deliver() { # deliver <session id>: the spike's state table, first match wins
	local sid=$1 cfg row id cwd pid status st kind next tries why
	cfg=$(jq -r --arg s "$sid" '[.subscriptions[] | select(.session_id == $s)] | last | .config_dir // empty' "$work_registry")
	row=$(session_row "$cfg" "$sid") || {
		hold "$sid" listing-failed
		return
	}
	if [ -z "$row" ]; then
		# No row in its root: removed, or not yet listed. Held under the
		# bound like any hold, since a missing row may come back.
		hold "$sid" session-gone
		return
	fi
	IFS=$us read -r id cwd pid status st kind <<<"$row"
	if [ -z "$pid" ]; then
		if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
			# Stopped, and its resume would be refused (exit 1) with the
			# prompt queued: usually FINISH removed its worktree.
			log "drop session=$(short "$sid") reason=cwd-gone cwd=$(jq -rn --arg c "$cwd" '$c | @json')"
			drop_session "$sid" cwd-gone
			return
		fi
		resume_backoff "$sid" || wake "$sid" "$cfg" stopped
		return
	fi
	case $status:$st in
	busy:* | waiting:* | *:working)
		hold "$sid" "busy status=$status state=$st"
		return
		;;
	idle:done | idle:blocked) ;;
	*)
		hold "$sid" "unplaced status=$status state=$st"
		return
		;;
	esac
	# Live and idle, in a terminal or in the background: relay the wake in
	# place. Neither its cwd nor its work in flight matters to the relay.
	read -r next tries <<<"$(jq -r --arg s "$sid" '.pending[$s] | "\(.next_relay_at // 0 | floor) \(.relay_failures // 0)"' "$work_state")"
	if [ "$relay_on" = false ]; then
		why="relay off"
	elif [ "$tries" -ge "$relay_tries" ]; then
		# Each unconfirmed relay may still have reached the session, so after
		# a few it stops trying until a wake lands and the count resets.
		why="relay gave up after $tries unconfirmed tries"
	elif [ "$now" -lt "$next" ]; then
		why="relay backoff until $(iso "$next")"
	elif [ "$SECONDS" -ge "$relay_budget" ]; then
		# Every relay holds the lock, and subscribe waits for it only so long.
		hold "$sid" "relay deferred: this check has run ${SECONDS}s"
		return
	else
		relay "$sid" "$cfg" "$pid"
		case $? in
		0) return ;;
		2)
			# Sent but not yet a turn: it may still be taken, so the fallback
			# that stops the session waits a pass (the relay backs off).
			hold "$sid" "relay unconfirmed; the fallback waits a pass"
			return
			;;
		esac
		why="relay not sent"
	fi
	stop_and_resume "$sid" "$cfg" "$id" "$cwd" "$kind" "$why"
}

stop_and_resume() { # stop_and_resume <session id> <config dir> <short id> <cwd> <kind> <why no relay>: the fallback
	local sid=$1 cfg=$2 id=$3 cwd=$4 kind=$5 why=$6 pid status st inflight updated tries row
	if [ "$kind" != background ]; then
		# A live terminal session: someone is at it, and a stop would end it
		# under them. Its events wait for a relay, or until it exits.
		hold "$sid" "$why; live ${kind:-unknown-kind} session"
		return
	fi
	if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
		# Live, but its resume would be refused once it was stopped. Held
		# under the bound: a later relay can still reach it.
		hold "$sid" "$why; cwd-gone cwd=$(jq -rn --arg c "$cwd" '$c | @json')"
		return
	fi
	[[ $id =~ ^[0-9a-f]{8}$ ]] || {
		hold "$sid" "$why; bad short id"
		return
	}
	! resume_backoff "$sid" || return
	read -r inflight updated <<<"$(job_state "$cfg" "$id")"
	if [ "$inflight" != none ]; then
		# A stop would kill that work; an unreadable inFlight counts as work.
		hold "$sid" "$why; in-flight=$inflight"
		return
	fi
	# Attached viewers: the stop disconnects one, and attachment isn't visible
	# from outside the daemon. So a live session gets a quiet period after its
	# last activity before it is stopped.
	if [ "$updated" -ge 0 ] && [ $((now - updated)) -lt "$idle_grace" ]; then
		hold "$sid" "$why; recent-activity"
		return
	fi
	# Re-read right before the stop, to narrow the window for a new turn.
	row=$(session_row "$cfg" "$sid" fresh) || {
		hold "$sid" "$why; listing-failed"
		return
	}
	IFS=$us read -r id cwd pid status st kind <<<"$row"
	read -r inflight updated <<<"$(job_state "$cfg" "$id")"
	case $status:$st:$inflight in
	idle:done:none | idle:blocked:none) ;;
	*)
		hold "$sid" "$why; changed status=$status state=$st in-flight=$inflight"
		return
		;;
	esac
	if ! run_claude "$cfg" stop "$id" >/dev/null 2>&1; then
		hold "$sid" "$why; stop-failed"
		return
	fi
	# --resume on a live session forks a copy, so wait until it is stopped.
	tries=0
	while :; do
		row=$(session_row "$cfg" "$sid" fresh) || row=
		IFS=$us read -r id cwd pid status st kind <<<"$row"
		[ -n "$row" ] && [ -z "$pid" ] && break
		tries=$((tries + 1))
		if [ "$tries" -ge 10 ]; then
			hold "$sid" "$why; stop-pending"
			return
		fi
		sleep 1
	done
	wake "$sid" "$cfg" live-idle
}

report_stale() {
	local line
	jq -r --argjson now "$now" --argjson bound "$hold_bound" '
		.pending | to_entries[] | select(($now - .value.first_at) >= $bound and (.value.stale_reported | not))
		| "\(.key) \((($now - .value.first_at) / 60) | floor) \(.value.last_hold // "none" | gsub(" "; "_"))"' \
		"$work_state" >"$run_tmp/stale"
	while read -r sid mins why; do
		[ -n "$sid" ] || continue
		log "stale session=$(short "$sid") held=${mins}m reason=$why"
		echo "pr-notifier: events for session $(short "$sid") held ${mins}m (last: $why); see $log_file" >&2
		edit "$work_state" --arg s "$sid" '.pending[$s].stale_reported = true'
	done <"$run_tmp/stale"
}

cmd_check() {
	[ $# -eq 0 ] || usage
	load_settings
	if ! lock 0; then
		mkdir -p "$home" && log "check skipped=locked"
		return 0
	fi
	load_files
	claude_path=$(command -v "$claude_bin" 2>/dev/null) || claude_path=$claude_bin
	if jq -e '(.subscriptions | length) == 0' "$work_registry" >/dev/null &&
		jq -e '(.pending // {} | length) == 0' "$work_state" >/dev/null; then
		log "check skipped=no-subscriptions"
		save_files
		return 0
	fi
	poll_feed
	examine_due
	local sid
	jq -r '.pending // {} | keys[]' "$work_state" >"$run_tmp/sessions"
	while IFS= read -r sid; do
		[ -n "$sid" ] || continue
		deliver "$sid"
	done <"$run_tmp/sessions"
	report_stale
	save_files
}

case ${1:-} in
subscribe) shift; cmd_subscribe "$@" ;;
unsubscribe) shift; cmd_unsubscribe "$@" ;;
status) shift; cmd_status "$@" ;;
check) shift; cmd_check "$@" ;;
*) usage ;;
esac
