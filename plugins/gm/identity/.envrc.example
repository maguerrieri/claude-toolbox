# Copy to `.envrc` (gitignored), set your values, then run `direnv allow`.

# Where to look for personas beyond this campaign and this plugin — colon-separated
# dirs, each holding `<name>/persona.md`. Searched after `<campaign>/personas/` and
# before the plugin's own. Leave unset to use only campaign-local + shipped personas.
export GM_PERSONA_PATH=$HOME/rpg/personas

# The rest is only for the optional per-persona commit avatars (follow-on infra).
# Leave unset to use the neutral committed default (gm.invalid — no avatars).
export GM_IDENTITY_DOMAIN=example.com
export GM_IDENTITY_SEAT=gm@example.com
