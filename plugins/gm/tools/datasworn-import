def _meter(m):
    return f"[{'▰' * m['value'] + '▱' * (m['max'] - m['value'])}] {m['value']}/{m['max']}"


def render_sheet(doc, files):
    rules = (doc.base or doc).data["rules"]
    stats = rules["stats"]
    meters = rules["condition_meters"]
    cfg = doc.pkg.sheet
    cat, key, label = cfg["ship"]
    ship = doc.data["assets"][cat]["contents"][key]
    out = [GENERATED, "# {{name}}", "",
           f"**Pronouns:** {{{{}}}} · **{cfg['moniker']}:** {{{{}}}}  ",
           "**Look / act / wear:** {{}}", "",
           "Fill it in with `rules/character-creation.md`.", "",
           "**Stats** (assign the array 3, 2, 2, 1, 1, as in `ironsworn-core/sheet-template.md`):",
           "- " + " · ".join(f"{k} {{{{}}}}" for k in stats), ""]
    out += [f"  - *{k}:* {v['description']}" for k, v in stats.items()]
    out += ["", "**Condition meters:**"]
    for m in meters.values():
        out.append(f"- {m['label'].capitalize():<8} {_meter(m)}")
    out += [f"- Momentum  +2     (max +10; reset +2; impacts lower both: `rules/character-creation.md`, step {cfg['meters_step']})", "",
            "**Impacts** (mark as the fiction demands):"]
    for group in rules["impacts"].values():
        boxes = " ".join(f"[ ] {i['label']}" for i in group["contents"].values())
        out.append(f"- *{group['label']}:* {boxes}")
    out += ["", "**Legacy tracks** (progress tracks; see Earn Experience in `rules/moves.md`):"]
    for t in rules["special_tracks"].values():
        line = f"- {t['label'].capitalize():<11} [▱▱▱▱▱▱▱▱▱▱] 0/10"
        out.append(line + (f" — {t['description']}" if cfg["legacy_text"] else ""))
    out += ["", "**Background vow** (epic): {{vow}} [▱▱▱▱▱▱▱▱▱▱] 0/10", "",
            "**Vows** (progress tracks; rank sets the mark per milestone):",
            "- {{vow}} — {{troublesome | dangerous | formidable | extreme | epic}} [▱▱▱▱▱▱▱▱▱▱] 0/10", "",
            "**Connections** (progress tracks):",
            "- {{name, role}} — {{rank}} [▱▱▱▱▱▱▱▱▱▱] 0/10", "",
            f"**Assets** (`rules/assets.md`): {cfg['assets']}", "",
            "**Asset tracks** (each card's meters, clocks and counters, at their starting values):"]
    out += cfg["ship_lines"]
    tracks = [f"{c['label']} {_meter(c)}" for c in ship["controls"].values()]
    for t in [" · ".join(tracks)] if cfg["ship_join"] else tracks:
        out.append(f"{cfg['ship_prefix']}{label} {t}")
    out += ["- {{asset}} {{track}} {{value}} (a companion's health, a support vehicle's integrity, …)", "",
            "**Experience:** {{earned}} / {{spent}}", "",
            "**Notes / Inventory:** {{freeform}}"]
    put(files, f"{doc.pkg.adapter}/sheet-template.md", "\n".join(out) + "\n")


# --- driver -----------------------------------------------------------------

def generate(data, base=None):
    """One package's generated tree: {path relative to the plugin root: content}. data is
    its Datasworn file (a file without an _id is read as starforged); an expansion also
    needs its ruleset's file as base."""
    pkg = PACKAGES[data.get("_id", "starforged")]
    if bool(pkg.base) != (base is not None):
        raise ValueError(f"{pkg.key}: pass its ruleset's data as base exactly when it's an expansion")
    data = apply_errata(pkg.key, data)
    base_doc = None
    if base is not None:
        base_doc = Doc(PACKAGES[pkg.base], base)
        collect_tables(base_doc)
    doc = Doc(pkg, data, base_doc)
    if base_doc:
        link_expansion(doc)
    collect_tables(doc)
    files = {}
    if base_doc:
        check_paths(doc)
        render_redirects(doc, files)
    render_oracles(doc, files)
    render_truths(doc, files)
    render_moves(doc, files)
    render_assets(doc, files)
    render_oracle_index(doc, files)
    render_sheet(doc, files)
    return files


def generate_all(datas):
    """Every package's tree, from {package key: its Datasworn file}."""
    files = {}
    for key, pkg in PACKAGES.items():
        for rel, text in generate(datas[key], datas[pkg.base] if pkg.base else None).items():
            put(files, rel, text)
    return files


def _owned_dirs():
    for pkg in PACKAGES.values():
        yield pkg.adapter, ".md", True
        yield pkg.fixtures, ".json", False


def owned_files(root):
    """The generated files currently in the tree under root: {relpath: content}."""
    found = {}
    for rel_dir, ext, marked in _owned_dirs():
        for dirpath, _dirs, names in os.walk(os.path.join(root, rel_dir)):
            for n in names:
                if n.endswith(ext):            # not .DS_Store and the like
                    p = os.path.join(dirpath, n)
                    with open(p, encoding="utf-8") as fh:
                        text = fh.read()
                    if not marked or text.startswith(MARKER):
                        found[os.path.relpath(p, root)] = text
    return found


def fetch(url, attempts=3):
    for attempt in range(1, attempts + 1):
        try:
            with urllib.request.urlopen(url, timeout=120) as resp:
                return resp.read()
        except OSError as e:           # URLError, HTTPError, timeouts
            if attempt == attempts:
                sys.exit(f"datasworn-import: couldn't fetch {url}: {e}")
            time.sleep(5 * attempt)


def load(json_path=None, pkg=PACKAGES["starforged"]):
    """One package's pinned file: a local copy, or fetched. Exits if it isn't the pin."""
    if json_path:
        with open(json_path, "rb") as fh:
            raw = fh.read()
    else:
        raw = fetch(pkg.url)
    digest = hashlib.sha256(raw).hexdigest()
    if digest != pkg.sha256:
        sys.exit(f"datasworn-import: sha256 {digest} doesn't match the pin {pkg.sha256} "
                 f"({UPSTREAM_REPO}@{UPSTREAM_REF}:{pkg.file}); move the pin deliberately (see --help)")
    return json.loads(raw)


def load_all(json_paths=()):
    """{package key: data} for every package: the local copy given for it, else fetched."""
    local = {}
    for jp in json_paths:
        with open(jp, "rb") as fh:
            digest = hashlib.sha256(fh.read()).hexdigest()
        pkg = next((p for p in PACKAGES.values() if p.sha256 == digest), None)
        if not pkg:
            sys.exit(f"datasworn-import: {jp}: sha256 {digest} doesn't match the pin of any package "
                     f"({', '.join(p.file for p in PACKAGES.values())} at {UPSTREAM_REPO}@{UPSTREAM_REF[:7]})")
        local[pkg.key] = jp
    return {key: load(local.get(key), pkg) for key, pkg in PACKAGES.items()}


def write(root, files):
    old = owned_files(root)
    for rel in files:
        p = os.path.join(root, rel)
        if os.path.exists(p) and rel not in old:
            sys.exit(f"datasworn-import: {rel} exists and isn't generated; move it before regenerating")
    for rel in old:
        os.remove(os.path.join(root, rel))
    for rel, text in sorted(files.items()):
        p = os.path.join(root, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(text)
    removed = sorted(set(old) - set(files))
    # Prune only directories a removed file leaves empty, up to (not including) its base.
    for rel in removed:
        base = os.path.join(root, next(d for d, _e, _m in _owned_dirs() if rel.startswith(d + "/")))
        d = os.path.dirname(os.path.join(root, rel))
        while d != base and os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
            d = os.path.dirname(d)
    print(f"datasworn-import: wrote {len(files)} files" + (f", removed {len(removed)}" if removed else ""))


def check(root, files):
    old = owned_files(root)
    problems = [f"missing   {rel}" for rel in sorted(set(files) - set(old))]
    problems += [f"stale     {rel}" for rel in sorted(set(old) - set(files))]
    problems += [f"differs   {rel}" for rel in sorted(set(files) & set(old)) if files[rel] != old[rel]]
    if problems:
        print("\n".join(problems))
        sys.exit(f"datasworn-import --check: {len(problems)} generated file(s) out of date; re-run datasworn-import")
    print(f"datasworn-import --check: {len(files)} generated files match {UPSTREAM_REPO}@{UPSTREAM_REF[:7]}")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="datasworn-import", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", nargs="+", default=[], metavar="FILE",
                    help="local copies of pinned files, matched by sha256 (default: fetch them)")
    ap.add_argument("--check", action="store_true", help="diff instead of writing; exit 1 on drift")
    ap.add_argument("--root", default=PLUGIN, help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    files = generate_all(load_all(a.json))
    (check if a.check else write)(a.root, files)


if __name__ == "__main__":
    main()
