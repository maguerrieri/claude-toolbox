LINK = re.compile(r"\[([^\]]*)\]\(datasworn:([^)\s]+)\)")
TABLE_TEMPLATE = re.compile(r"\{\{table>([^}]+)\}\}")
ROLL_TYPES = {
    "action_roll": "action roll",
