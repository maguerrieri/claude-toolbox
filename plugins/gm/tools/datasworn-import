class Package:
    """One pinned Datasworn file and the adapter generated from it."""

    def __init__(self, key, file, sha256, adapter, title, sheet, base=None, deck=None):
        self.key = key              # the file's Datasworn _id, which its ids also carry
        self.file = file
        self.sha256 = sha256
        self.adapter = adapter
        self.name = adapter.rsplit("/", 1)[-1]
        self.fixtures = f"tests/fixtures/oracles/{self.name}"
        self.title = title
        self.base = base            # the ruleset an expansion extends
        self.sheet = sheet          # what its character sheet says differently (render_sheet)
        self.deck = deck            # where an expansion's own docs say which ruleset cards to use
        self.url = f"https://raw.githubusercontent.com/{UPSTREAM_REPO}/{UPSTREAM_REF}/{file}"


