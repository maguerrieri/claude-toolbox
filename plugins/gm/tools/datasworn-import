#!/usr/bin/env python3
"""Regenerate the starforged adapter's SRD content from Datasworn. Standard library only.

The Ironsworn: Starforged SRD (Shawn Tomkin, CC BY 4.0) is published as
machine-readable JSON by Datasworn (https://github.com/rsek/datasworn). This tool
converts one pinned copy of it into the gm adapter's formats:

  adapters/starforged/oracles/**/*.md           every rollable table (`roll table` format)
  adapters/starforged/rules/oracles.md          an index of those tables
  adapters/starforged/rules/moves.md            the full move list
  adapters/starforged/rules/assets.md           the asset index, and
  adapters/starforged/rules/assets/<cat>.md     every asset card, by category
  adapters/starforged/rules/truths.md           the 14 setting truths
  adapters/starforged/rules/encounters.md       the sample NPCs and foes
  adapters/starforged/sheet-template.md         the character sheet
  tests/fixtures/oracles/starforged/**/*.json   golden ranges for tests/test_oracle_parity.py

The tool owns its output: a run deletes every file it generated before (each .md
starts with the GENERATED marker; the fixture dir is all its own) and writes the
new set, so edit this tool or its pin, never the output. Hand-written adapter files
(adapter.md, SOURCE.md, frames/, rules/campaign-launch.md,
rules/character-creation.md, rules/sector-creation.md) have no marker and are never
touched; a generated path that would overwrite one is an error.

Usage:
  datasworn-import                  fetch the pinned upstream, verify it, regenerate
  datasworn-import --json FILE      use a local copy of the pinned file instead
  datasworn-import --cache DIR      fetch once into DIR, reuse it after (CI caches DIR)
  datasworn-import --check          regenerate in memory and diff against the tree
                                    (exit 1 on any drift; CI runs this)

To move the pin: change UPSTREAM_REF, UPSTREAM_TAG and UPSTREAM_SHA256 below,
re-run, review the diff, and update adapters/starforged/SOURCE.md and NOTICE.
"""
import argparse
import hashlib
import http.client
import json
import os
import re
import sys
import time
import urllib.request

UPSTREAM_REPO = "rsek/datasworn"
UPSTREAM_TAG = "v0.1.0-prerelease"
UPSTREAM_REF = "e643a75263c1cb3e845a0c0789879ff4e8b49532"
UPSTREAM_PATH = "datasworn/starforged/starforged.json"
UPSTREAM_SHA256 = "6246ed6da109cf1586f80ae3b8238feffca2ebaa00a37e3437e1b9f7b7e313c9"
UPSTREAM_URL = f"https://raw.githubusercontent.com/{UPSTREAM_REPO}/{UPSTREAM_REF}/{UPSTREAM_PATH}"

PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ADAPTER = "adapters/starforged"
FIXTURES = "tests/fixtures/oracles/starforged"
MARKER = "<!-- Generated by tools/datasworn-import"
GENERATED = (f"{MARKER} from {UPSTREAM_REPO}@{UPSTREAM_REF[:7]} ({UPSTREAM_TAG}). "
             "Do not edit: change the tool and re-run it. -->")

LINK = re.compile(r"\[([^\]]*)\]\(datasworn:([^)\s]+)\)")
TABLE_TEMPLATE = re.compile(r"\{\{table>([^}]+)\}\}")
PATHS_NOTE = ("Paths are relative to this adapter, so `oracles/<path>` rolls as "
              "`roll table ${CLAUDE_PLUGIN_ROOT}/adapters/starforged/oracles/<path>`.")
ROLL_TYPES = {
    "action_roll": "action roll",
    "progress_roll": "progress roll",
    "special_track": "progress roll on your legacy tracks",
    "no_roll": "no roll",
}


# --- ids and paths ----------------------------------------------------------

def _slug(seg):
    return seg.replace("_", "-")


def _split(ref):
    """'oracle_rollable:starforged/core/action' -> ('oracle_rollable', 'core/action')."""
    kind, _, rest = ref.partition(":")
    ruleset, _, path = rest.partition("/")
    if ruleset != "starforged" or not path:
        raise ValueError(f"not a starforged id: {ref!r}")
    return kind, path


def oracle_path(ref):
    """A rollable table's file, relative to the adapter's oracles/ dir.

    Datasworn ids map to nested paths (underscores become hyphens). Two families
    keep the flat names the gm core and the other adapters use: the core oracles
    (action, theme, descriptor, focus) sit at the top, and the Pay the Price
    move's table is pay-the-price.md. Tables inside moves live under moves/,
    tables inside truths under truths/<truth>/.
    """
    kind, path = _split(ref)
    if kind in ("oracle_rollable", "oracle_collection"):
        segs = path.split("/")
        if segs[0] == "core":
            segs = segs[1:]
    elif kind == "move.oracle_rollable":
        move_path, _, key = path.partition(".")
        move = move_path.split("/")[-1]
        if move == "pay_the_price" and key == move:
            return "pay-the-price.md"
        segs = ["moves", move] + ([] if key == move else [key])
    elif kind == "truth.option.oracle_rollable":
        truth, _idx, key = path.split(".")
        segs = ["truths", truth, key]
    elif kind == "truth":
        segs = ["truths", path]
    else:
        raise ValueError(f"not an oracle id: {ref!r}")
    return "/".join(_slug(s) for s in segs) + ".md"


def collection_dir(ref):
    """An oracle collection's directory, relative to oracles/ ('' for core)."""
    p = oracle_path(ref)[: -len(".md")]
    return p + "/" if p else ""


def asset_category(ref):
    _kind, path = _split(ref)
    return path.split("/")[0].replace("_", " ")


# --- text -------------------------------------------------------------------

class Doc:
    """The parsed upstream file, with an index from table id to (table, path)."""

    def __init__(self, data):
        self.data = data
        self.tables = {}

    def table(self, ref):
        if ref not in self.tables:
            raise ValueError(f"reference to an unknown table: {ref!r}")
        return self.tables[ref]


def convert_links(text):
    """Datasworn markdown links -> plain text the GM can act on.

    A table or collection keeps its path so the GM can roll it; a move is just its
    name (they all live in rules/moves.md); an asset names its category.
    """
    def sub(m):
        label, ref = m.group(1), m.group(2)
        kind = ref.partition(":")[0]
        if kind in ("oracle_rollable", "move.oracle_rollable", "truth.option.oracle_rollable"):
            return f"{label} (`oracles/{oracle_path(ref)}`)"
        if kind == "oracle_collection":
            return f"{label} (`oracles/{collection_dir(ref)}`)"
        if kind == "move":
            return label
        if kind == "asset":
            return f"{label} ({asset_category(ref)} asset)"
        raise ValueError(f"unknown datasworn link type: {ref!r}")

    out = LINK.sub(sub, text)
    if "datasworn:" in out or "{{" in out:     # a link we didn't parse, or a template
        raise ValueError(f"unconverted datasworn reference or template in: {text!r}")
    return out


def _range(roll):
    if not roll:
        return "—"
    lo, hi = roll["min"], roll["max"]
    return str(lo) if lo == hi else f"{lo}–{hi}"


def _cell(text):
    return convert_links(text or "").replace("|", "\\|").replace("\n", "<br>")


def md_table(doc, ref):
    """A table embedded in rules prose: its path, then its rows as a markdown table."""
    t, path = doc.table(ref)
    labels = t.get("column_labels") or {}
    has2 = any(r.get("text2") for r in t["rows"])
    head = [labels.get("roll", "Roll"), labels.get("text", "Result")]
    if has2:
        head.append(labels.get("text2", ""))
    lines = [f"Roll `oracles/{path}` ({t['dice']}):", "",
             "| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    for r in t["rows"]:
        cells = [_range(r.get("roll")), _cell(r["text"])]
        if has2:
            cells.append(_cell(r.get("text2")))
        lines.append("| " + " | ".join(cells) + " |")
    return "\n".join(lines)


def rules_text(doc, text):
    """Datasworn prose for a rules file: links converted, embedded tables expanded."""
    return convert_links(TABLE_TEMPLATE.sub(lambda m: md_table(doc, m.group(1)), text))


def entry_text(doc, text):
    """Datasworn prose inside a table entry: an embedded table becomes a pointer."""
    return convert_links(TABLE_TEMPLATE.sub(lambda m: f"→ Roll `oracles/{doc.table(m.group(1))[1]}`.", text))


def quote(text):
    """Prose as a blockquote, so no line can read as a table entry (`- `) or continuation."""
    return "\n".join(("> " + line).rstrip() for line in text.split("\n"))


def indent(text, by="  "):
    return "\n".join((by + line).rstrip() for line in text.split("\n"))


# --- oracle tables ----------------------------------------------------------

def _faces(dice):
    m = re.fullmatch(r"1d(\d+)", dice)
    if not m:
        raise ValueError(f"unsupported table dice: {dice!r}")
    return int(m.group(1))


def checked_rows(rows, dice, ref):
    """The rollable rows (a null roll is a result this column can't produce), checked
    to tile 1..faces exactly, so weights reproduce the upstream ranges."""
    live = [r for r in rows if r.get("roll") is not None]
    expect = 1
    for r in live:
        if r["roll"]["min"] != expect or r["roll"]["max"] < expect:
            raise ValueError(f"{ref}: rows don't tile the die at {expect} ({r['roll']})")
        expect = r["roll"]["max"] + 1
    if expect - 1 != _faces(dice):
        raise ValueError(f"{ref}: rows end at {expect - 1}, die is {dice}")
    return live


def row_lines(row):
    """One table row as entry lines: its text (+ second column), then any rolls on
    other tables, and any tables it suggests next, that the text doesn't already link."""
    text = convert_links(row["text"])
    if row.get("text2"):
        text = f"{text} — {convert_links(row['text2'])}"
    lines = text.split("\n")
    linked = {m.group(2) for m in LINK.finditer(row["text"] + (row.get("text2") or ""))}
    for roll in row.get("oracle_rolls") or []:
        ref = roll.get("oracle")
        if ref and ref not in linked:
            times = roll.get("number_of_rolls") or 1
            lines.append(f"→ Roll `oracles/{oracle_path(ref)}`" + (f" ×{times}" if times > 1 else ""))
            linked.add(ref)
    for ref in row.get("suggestions") or []:
        if ref not in linked:
            where = collection_dir(ref) if ref.startswith("oracle_collection:") else oracle_path(ref)
            lines.append(f"→ Next, consider `oracles/{where}`")
            linked.add(ref)
    return lines


def put(files, rel, text):
    if rel in files:
        raise ValueError(f"two generated files map to {rel}")
    files[rel] = text


def emit_table(files, path, title, ref, dice, summary, entries):
    """Write a rollable table and its golden fixture. entries: [(roll, [line, …])], with
    roll the upstream {min, max}. The table weighs each entry max - min + 1, while the
    fixture keeps the upstream max, so a weight the table gets wrong fails the parity test."""
    out = [GENERATED, f"# {title}", ""]
    meta = f"Datasworn `{ref}` · {dice}"
    out += [quote(f"{summary}\n\n{meta}" if summary else meta), ""]
    fixture = []
    for roll, lines in entries:
        lines = [ln.strip() for ln in lines if ln.strip()]
        out.append(f"- [{roll['max'] - roll['min'] + 1}] {lines[0]}")
        out += [f"  {ln}" for ln in lines[1:]]
        fixture.append({"max": roll["max"], "result": "\n".join(lines)})
    put(files, f"{ADAPTER}/oracles/{path}", "\n".join(out) + "\n")
    put(files, f"{FIXTURES}/{path[:-3]}.json", fixture_json(ref, dice, fixture))


def fixture_json(ref, dice, rows):
    body = ",\n".join("    " + json.dumps(r, ensure_ascii=False) for r in rows)
    return (f'{{\n  "id": {json.dumps(ref)},\n  "die": {json.dumps(dice)},\n'
            f'  "rows": [\n{body}\n  ]\n}}\n')


def _short(name):
    return name[: -len(" Oracles")] if name.endswith(" Oracles") else name


def collect_tables(doc):
    """Every rollable table as (ref, path, title, table) — oracles, move tables,
    truth sub-tables — and fill doc.tables. Order is the upstream file's."""
    found = []

    def walk(coll, trail):
        for t in coll.get("contents", {}).values():
            found.append((t["_id"], " › ".join(trail + [t["name"]]), t, coll))
        for sub in coll.get("collections", {}).values():
            walk(sub, trail + [sub["name"]])

    for coll in doc.data["oracles"].values():
        walk(coll, [_short(coll["name"])])
    for cat in doc.data["moves"].values():
        for move in cat["contents"].values():
            for key, t in move.get("oracles", {}).items():
                title = move["name"] if key == move["_id"].rsplit("/", 1)[-1] else f"{move['name']} › {t['name']}"
                found.append((t["_id"], title, t, None))
    for truth in doc.data["truths"].values():
        for opt in truth["options"]:
            for t in (opt.get("oracles") or {}).values():
                found.append((t["_id"], f"{truth['name']} › {t['name']}", t, None))

    out, seen = [], {}
    for ref, title, t, parent in found:
        path = oracle_path(ref)
        if path in seen:
            raise ValueError(f"{ref} and {seen[path]} both map to oracles/{path}")
        seen[path] = ref
        doc.tables[ref] = (t, path)
        out.append((ref, path, title, t, parent))
    return out


# "Given and family names are presented as a pair, so you may roll once for both."
ONE_ROLL = {"oracle_collection:starforged/character/name"}


def shared_roll_collections(doc):
    """The table_shared_rolls collections meant to be read off one roll, each of which
    gets a combined table with one row per roll. Sharing rolls only aligns the columns'
    ranges; whether to read them together is in each collection's summary, so it's listed
    in ONE_ROLL rather than inferred (Sector Name says to roll each word separately)."""
    found = []

    def walk(coll, trail):
        if coll.get("oracle_type") == "table_shared_rolls" and coll["_id"] in ONE_ROLL:
            found.append((coll, " › ".join(trail)))
        for sub in coll.get("collections", {}).values():
            walk(sub, trail + [sub["name"]])

    for coll in doc.data["oracles"].values():
        walk(coll, [_short(coll["name"])])
    return found


def render_oracles(doc, files):
    for ref, path, title, t, parent in collect_tables(doc):
        rows = checked_rows(t["rows"], t["dice"], ref)
        summary = t.get("summary")
        if not summary and t.get("oracle_type") == "column_text":
            summary = (parent or {}).get("summary")   # a column shares its collection's summary
        emit_table(files, path, title, ref, t["dice"], convert_links(summary) if summary else "",
                   [(r["roll"], row_lines(r)) for r in rows])

    for coll, title in shared_roll_collections(doc):
        ref = coll["_id"]
        cols = list(coll["contents"].values())
        rows = [checked_rows(c["rows"], c["dice"], c["_id"]) for c in cols]
        if len({c["dice"] for c in cols}) != 1 or len({tuple((r["roll"]["min"], r["roll"]["max"]) for r in rs) for rs in rows}) != 1:
            raise ValueError(f"{ref}: shared-roll columns don't share their rolls")
        entries = [(r["roll"], [" · ".join(f"{c['name']}: {convert_links(rs[i]['text'])}"
                                           for c, rs in zip(cols, rows))])
                   for i, r in enumerate(rows[0])]
        path = collection_dir(ref)[:-1] + ".md"
        summary = convert_links(coll.get("summary") or "")
        summary = (summary + "\n\n" if summary else "") + (
            "This table reads every column off one roll. To roll a column on its own: "
            + ", ".join(f"`oracles/{oracle_path(c['_id'])}`" for c in cols) + ".")
        emit_table(files, path, title, ref, cols[0]["dice"], summary, entries)


# --- truths -----------------------------------------------------------------

def render_truths(doc, files):
    out = [GENERATED, "# Setting Truths", "",
           "The Forge's 14 setting truths from the Starforged SRD. For each one, pick an option or",
           "roll its table, then roll any sub-table the chosen option names. Each option carries a",
           f"quest starter. {PATHS_NOTE}", ""]
    for truth in doc.data["truths"].values():
        ref = truth["_id"]
        path = oracle_path(ref)
        entries = []
        out += [f"## {truth['name']}", "", f"Roll `oracles/{path}` ({truth['dice']}), or choose.", ""]
        for opt in checked_rows(truth["options"], truth["dice"], ref):
            summary = convert_links(opt["summary"])
            lines = [summary] + entry_text(doc, opt["description"]).split("\n")
            if opt.get("quest_starter"):
                lines.append(f"Quest starter: {convert_links(opt['quest_starter'])}")
            entries.append((opt["roll"], lines))
            out += [f"### {_range(opt['roll'])}: {summary}", "", rules_text(doc, opt["description"]), ""]
            if opt.get("quest_starter"):
                out += [f"*Quest starter:* {convert_links(opt['quest_starter'])}", ""]
        if truth.get("your_character"):
            out += [f"*Your character:* {convert_links(truth['your_character'])}", ""]
        emit_table(files, path, f"Truth › {truth['name']}", ref, truth["dice"],
                   "Each option: its summary, the truth, then its quest starter.", entries)
    put(files, f"{ADAPTER}/rules/truths.md", "\n".join(out).rstrip() + "\n")


# --- moves ------------------------------------------------------------------

def roll_note(move):
    kind = ROLL_TYPES[move["roll_type"]]
    track = (move.get("tracks") or {}).get("category")
    return f"*Roll:* {kind}" + (f" ({track} track)" if track else "")


def render_moves(doc, files):
    out = [GENERATED, "# Starforged Moves", "",
           "The full Starforged move list from the SRD. Rolls go through the `ironsworn-core` engine",
           "(`ironsworn-core/adapter.md`): an **action roll** is",
           "`roll ironsworn-action --stat <value> --adds <N>`; a **progress roll** is",
           "`roll ironsworn-progress --boxes <filled boxes>` on the named track (a legacy-track roll",
           "uses that track's filled boxes the same way). A table a move rolls on is shown in place,",
           f"with the path to roll it. {PATHS_NOTE}", ""]
    for cat in doc.data["moves"].values():
        out += [f"## {cat['name']}", ""]
        for move in cat["contents"].values():
            out += [f"### {move['name']}", "", roll_note(move), "", rules_text(doc, move["text"]), ""]
            # tables the move carries but its text doesn't embed (Ask the Oracle's odds)
            loose = [t for t in move.get("oracles", {}).values() if t["_id"] not in move["text"]]
            if loose:
                out += ["Roll its tables: " + ", ".join(
                    f"{t['name']} `oracles/{oracle_path(t['_id'])}`" for t in loose) + ".", ""]
    put(files, f"{ADAPTER}/rules/moves.md", "\n".join(out).rstrip() + "\n")


# --- assets -----------------------------------------------------------------

def _option(o):
    if o.get("field_type") == "select_value":
        return f"{o['label']} ({' / '.join(c['label'] for c in o['choices'].values())})"
    return o["label"]


def _control(c):
    ft, label = c["field_type"], c["label"]
    if ft == "condition_meter":
        s = f"{label} meter: starts at {c['value']}, max {c['max']}"
        subs = [sc["label"] for sc in (c.get("controls") or {}).values()]
        return s + (f"; can be marked {', '.join(subs)}" if subs else "")
    if ft == "card_flip":
        return f"can be marked {label} (flip the card)"
    if ft == "clock":
        return f"{label}: a {c['max']}-segment clock"
    if ft == "checkbox":
        return f"[ ] {label}"
    if ft == "counter":
        return f"{label}: a counter, starting at {c['value']}"
    raise ValueError(f"unknown asset control type: {ft!r}")


def render_asset(doc, a):
    out = [f"## {a['name']}", ""]
    notes = []
    if a.get("requirement"):
        notes.append(f"*Requirement:* {convert_links(a['requirement'])}")
    if a.get("options"):
        notes.append("*Fill in:* " + "; ".join(_option(o) for o in a["options"].values()))
    for c in (a.get("controls") or {}).values():
        notes.append("*Track:* " + _control(c))
    if a.get("shared"):
        notes.append("*Shared asset.*")
    if a.get("count_as_impact"):
        notes.append("*Counts as an impact.*")
    att = (a.get("attachments") or {}).get("assets")
    if att:
        notes.append("*Attachments:* " + ", ".join(p.split("/")[1].replace("_", " ") + " assets" for p in att))
    for n in notes:
        out += [n + "  "]
    if notes:
        out[-1] = out[-1].rstrip()
        out.append("")
    for ab in a["abilities"]:
        box = "[x]" if ab.get("enabled") else "[ ]"
        body = convert_links(ab["text"]).split("\n")
        out.append(f"- {box} {body[0]}")
        out += [indent(ln) if ln else "" for ln in body[1:]]
        extras = [_option(o) for o in (ab.get("options") or {}).values()]
        if extras:
            out += ["", indent("*Fill in:* " + "; ".join(extras))]
        for c in (ab.get("controls") or {}).values():
            out += ["", indent("*Track:* " + _control(c))]
        for mv in (ab.get("moves") or {}).values():
            out += ["", indent(f"*Asset move:* **{mv['name']}** ({ROLL_TYPES[mv['roll_type']]})")]
            if mv["text"].strip() != ab["text"].strip():   # usually the ability text itself
                out += ["", indent(rules_text(doc, mv["text"]))]
    out.append("")
    return "\n".join(out)


def render_assets(doc, files):
    index = [GENERATED, "# Starforged Assets", "",
             "The full Starforged asset compendium from the SRD, one file per category under",
             "`rules/assets/`. On each card, `[x]` marks an ability you start with and `[ ]` one you",
             "unlock with experience (Advance, `rules/moves.md`).", ""]
    for key, cat in doc.data["assets"].items():
        fname = _slug(key) + ".md"
        out = [GENERATED, f"# {cat['name']}", ""]
        if cat.get("description"):
            out += [convert_links(cat["description"]), ""]
        index += [f"## {cat['name']} (`rules/assets/{fname}`)", ""]
        if cat.get("description"):
            index += [convert_links(cat["description"]), ""]
        names = []
        for a in cat["contents"].values():
            out.append(render_asset(doc, a))
            names.append(a["name"])
        index += [", ".join(names) + ".", ""]
        put(files, f"{ADAPTER}/rules/assets/{fname}", "\n".join(out).rstrip() + "\n")
    put(files, f"{ADAPTER}/rules/assets.md", "\n".join(index).rstrip() + "\n")


# --- oracle index -----------------------------------------------------------

def render_oracle_index(doc, files):
    out = [GENERATED, "# Starforged Oracles", "",
           "Every rollable table this adapter ships, by collection; a table's file also carries",
           f"its summary. {PATHS_NOTE}", ""]

    def walk(coll, depth):
        out.append("#" * depth + f" {coll['name']}")
        out.append("")
        if coll.get("summary") or coll.get("description"):
            out.extend([convert_links(coll.get("description") or coll["summary"]), ""])
        if coll.get("_id") in ONE_ROLL:
            out.append(f"- `oracles/{collection_dir(coll['_id'])[:-1]}.md` — all columns, one roll")
        for t in coll.get("contents", {}).values():
            out.append(f"- `oracles/{oracle_path(t['_id'])}` — {t['name']}")
        if coll.get("contents"):
            out.append("")
        for sub in coll.get("collections", {}).values():
            walk(sub, min(depth + 1, 6))

    out += ["## Oracle collections", ""]
    for coll in doc.data["oracles"].values():
        walk(coll, 3)
    out += ["## Move tables", ""]
    for cat in doc.data["moves"].values():
        for move in cat["contents"].values():
            for t in move.get("oracles", {}).values():
                out.append(f"- `oracles/{oracle_path(t['_id'])}` — {move['name']}: {t['name']}")
    out += ["", "## Setting truths", "", "See `rules/truths.md`.", ""]
    for truth in doc.data["truths"].values():
        out.append(f"- `oracles/{oracle_path(truth['_id'])}` — {truth['name']}")
        for opt in truth["options"]:
            for t in (opt.get("oracles") or {}).values():
                out.append(f"  - `oracles/{oracle_path(t['_id'])}` — {t['name']} ({convert_links(opt['summary'])})")
    put(files, f"{ADAPTER}/rules/oracles.md", "\n".join(out).rstrip() + "\n")


# --- sheet ------------------------------------------------------------------

def _meter(m):
    return f"[{'▰' * m['value'] + '▱' * (m['max'] - m['value'])}] {m['value']}/{m['max']}"


def render_sheet(doc, files):
    rules = doc.data["rules"]
    stats = rules["stats"]
    meters = rules["condition_meters"]
    starship = doc.data["assets"]["command_vehicle"]["contents"]["starship"]
    # A character's sheet is copied from this template, so the marker says to drop it there.
    marker = (f"{MARKER} from {UPSTREAM_REPO}@{UPSTREAM_REF[:7]} ({UPSTREAM_TAG}): the sheet "
              "template. Leave this line out of a character's sheet. -->")
    out = [marker, "# {{name}}", "",
           "**Pronouns:** {{}} · **Callsign:** {{}}  ",
           "**Look / act / wear:** {{}}", "",
           "Fill it in with `rules/character-creation.md`.", "",
           "**Stats** (assign the array 3, 2, 2, 1, 1, as in `ironsworn-core/sheet-template.md`):",
           "- " + " · ".join(f"{k} {{{{}}}}" for k in stats), ""]
    out += [f"  - *{k}:* {v['description']}" for k, v in stats.items()]
    out += ["", "**Condition meters:**"]
    for m in meters.values():
        out.append(f"- {m['label'].capitalize():<8} {_meter(m)}")
    out += ["- Momentum  +2     (max +10; reset +2; impacts lower both: `rules/character-creation.md`, step 8)", "",
            "**Impacts** (mark as the fiction demands):"]
    for group in rules["impacts"].values():
        boxes = " ".join(f"[ ] {i['label']}" for i in group["contents"].values())
        out.append(f"- *{group['label']}:* {boxes}")
    out += ["", "**Legacy tracks** (progress tracks; see Earn Experience in `rules/moves.md`):"]
    for t in rules["special_tracks"].values():
        out.append(f"- {t['label'].capitalize():<11} [▱▱▱▱▱▱▱▱▱▱] 0/10 — {t['description']}")
    out += ["", "**Background vow** (epic): {{vow}} [▱▱▱▱▱▱▱▱▱▱] 0/10", "",
            "**Vows** (progress tracks; rank sets the mark per milestone):",
            "- {{vow}} — {{troublesome | dangerous | formidable | extreme | epic}} [▱▱▱▱▱▱▱▱▱▱] 0/10", "",
            "**Connections** (progress tracks):",
            "- {{name, role}} — {{rank}} [▱▱▱▱▱▱▱▱▱▱] 0/10", "",
            "**Assets** (`rules/assets.md`): STARSHIP {{name}} · {{two paths}} · {{one more}}", "",
            "**Asset tracks** (each card's meters, clocks and counters, at their starting values):"]
    for c in starship["controls"].values():
        out.append(f"- STARSHIP {c['label']} {_meter(c)}")
    out += ["- {{asset}} {{track}} {{value}} (a companion's health, a support vehicle's integrity, …)", "",
            "**Experience:** {{earned}} / {{spent}}", "",
            "**Notes / Inventory:** {{freeform}}"]
    put(files, f"{ADAPTER}/sheet-template.md", "\n".join(out) + "\n")


# --- npcs -------------------------------------------------------------------

# Datasworn's ChallengeRank: 1..5 in the core's rank order.
RANKS = ["troublesome", "dangerous", "formidable", "extreme", "epic"]


def _rank(n):
    return f"{RANKS[n - 1]} ({n})"


def render_npcs(doc, files):
    out = [GENERATED, "# Starforged Encounters", "",
           "The SRD's sample NPCs and foes, with each one's rank (it sets the progress per mark on a",
           "fight or other challenge against them), its variants, and a quest starter.", ""]
    for coll in doc.data.get("npcs", {}).values():
        out += [f"## {coll['name']}", ""]
        for npc in coll["contents"].values():
            out += [f"### {npc['name']}", "",
                    f"*{npc['nature']}* · {convert_links(npc['summary'])} · **Rank:** {_rank(npc['rank'])}", ""]
            for label in ("features", "drives", "tactics"):
                if npc.get(label):
                    out += [f"**{label.capitalize()}:** " + "; ".join(convert_links(x) for x in npc[label]), ""]
            out += [convert_links(npc["description"]), ""]
            for v in (npc.get("variants") or {}).values():
                out += [f"- **{v['name']}** (*{v['nature']}*, {_rank(v['rank'])}): {convert_links(v['description'])}"]
            if npc.get("variants"):
                out.append("")
            if npc.get("quest_starter"):
                out += [f"*Quest starter:* {convert_links(npc['quest_starter'])}", ""]
    put(files, f"{ADAPTER}/rules/encounters.md", "\n".join(out).rstrip() + "\n")


# --- driver -----------------------------------------------------------------

CONVERTED = {"oracles", "moves", "assets", "truths", "rules", "npcs"}
METADATA = {"_id", "type", "datasworn_version", "title", "license", "authors", "date", "url"}


def generate(data):
    """The whole generated tree: {path relative to the plugin root: content}."""
    for key, value in data.items():
        if key not in CONVERTED | METADATA and value:
            raise ValueError(f"upstream section {key!r} has content this tool doesn't convert")
    doc = Doc(data)
    files = {}
    render_oracles(doc, files)
    render_truths(doc, files)
    render_moves(doc, files)
    render_assets(doc, files)
    render_npcs(doc, files)
    render_oracle_index(doc, files)
    render_sheet(doc, files)
    return files


def owned_files(root):
    """The generated files currently in the tree under root: {relpath: content}."""
    found = {}
    adapter = os.path.join(root, ADAPTER)
    for dirpath, _dirs, names in os.walk(adapter):
        for n in names:
            if n.endswith(".md"):
                p = os.path.join(dirpath, n)
                with open(p, encoding="utf-8") as fh:
                    text = fh.read()
                if text.startswith(MARKER):
                    found[os.path.relpath(p, root)] = text
    fixtures = os.path.join(root, FIXTURES)
    for dirpath, _dirs, names in os.walk(fixtures):
        for n in names:
            if n.endswith(".json"):    # not .DS_Store and the like
                p = os.path.join(dirpath, n)
                with open(p, encoding="utf-8") as fh:
                    found[os.path.relpath(p, root)] = fh.read()
    return found


def fetch(url, attempts=3):
    for attempt in range(1, attempts + 1):
        try:
            with urllib.request.urlopen(url, timeout=120) as resp:
                return resp.read()
        except (OSError, http.client.HTTPException) as e:   # URLError, timeouts, IncompleteRead
            if attempt == attempts:
                sys.exit(f"datasworn-import: couldn't fetch {url}: {e}")
            time.sleep(5 * attempt)


def load(json_path, cache_dir=None):
    """The pinned upstream document: from --json, else from the cache dir, else fetched
    (and then cached). Whatever the source, it must hash to the pin."""
    cached = os.path.join(cache_dir, f"{UPSTREAM_SHA256}.json") if cache_dir else None
    if json_path or (cached and os.path.isfile(cached)):
        with open(json_path or cached, "rb") as fh:
            raw = fh.read()
    else:
        raw = fetch(UPSTREAM_URL)
    digest = hashlib.sha256(raw).hexdigest()
    if digest != UPSTREAM_SHA256:
        sys.exit(f"datasworn-import: sha256 {digest} doesn't match the pin {UPSTREAM_SHA256} "
                 f"({UPSTREAM_REPO}@{UPSTREAM_REF}); move the pin deliberately (see --help)")
    if cached and not os.path.isfile(cached):
        os.makedirs(cache_dir, exist_ok=True)
        with open(cached, "wb") as fh:
            fh.write(raw)
    return json.loads(raw)


def write(root, files):
    old = owned_files(root)
    for rel in files:
        p = os.path.join(root, rel)
        if os.path.exists(p) and rel not in old:
            sys.exit(f"datasworn-import: {rel} exists and isn't generated; move it before regenerating")
    for rel in old:
        os.remove(os.path.join(root, rel))
    for rel, text in sorted(files.items()):
        p = os.path.join(root, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(text)
    removed = sorted(set(old) - set(files))
    # Prune only directories a removed file leaves empty, up to (not including) its base.
    for rel in removed:
        base = os.path.join(root, FIXTURES if rel.startswith(FIXTURES + "/") else ADAPTER)
        d = os.path.dirname(os.path.join(root, rel))
        while d != base and os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
            d = os.path.dirname(d)
    print(f"datasworn-import: wrote {len(files)} files" + (f", removed {len(removed)}" if removed else ""))


def check(root, files):
    old = owned_files(root)
    problems = [f"missing   {rel}" for rel in sorted(set(files) - set(old))]
    problems += [f"stale     {rel}" for rel in sorted(set(old) - set(files))]
    problems += [f"differs   {rel}" for rel in sorted(set(files) & set(old)) if files[rel] != old[rel]]
    if problems:
        print("\n".join(problems))
        sys.exit(f"datasworn-import --check: {len(problems)} generated file(s) out of date; re-run datasworn-import")
    print(f"datasworn-import --check: {len(files)} generated files match {UPSTREAM_REPO}@{UPSTREAM_REF[:7]}")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="datasworn-import", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", help="a local copy of the pinned starforged.json (default: fetch it)")
    ap.add_argument("--check", action="store_true", help="diff instead of writing; exit 1 on drift")
    ap.add_argument("--cache", metavar="DIR",
                    help="keep the fetched file in DIR (by its sha256) and reuse it next time")
    ap.add_argument("--root", default=PLUGIN, help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    files = generate(load(a.json, a.cache))
    (check if a.check else write)(a.root, files)


if __name__ == "__main__":
    main()
