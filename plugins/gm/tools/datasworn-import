class Ruleset:
    """One Datasworn ruleset and the adapter it generates."""

    def __init__(self, key, adapter, title, sha256, flat, licenses, special_track, epilogue,
                 unmarked_note=""):
        self.key = key                    # the ruleset segment of every Datasworn id
        self.adapter = adapter            # the adapter dir under adapters/
        self.title = title                # how the generated files name the game
        self.upstream_path = f"datasworn/{key}/{key}.json"
        self.sha256 = sha256
        self.flat = flat                  # the oracle collection whose tables sit at oracles/'s top
        self.licenses = licenses          # {top-level section: the license every object in it carries}
        self.special_track = special_track  # how a move rolling on the special tracks reads
        self.epilogue = epilogue          # the moves intro's note on that roll, as two wrapped lines
        self.unmarked_note = unmarked_note  # the assets index's note on a card with no ability marked
        self.adapter_dir = f"adapters/{adapter}"
        self.fixtures_dir = f"tests/fixtures/oracles/{adapter}"
        self.paths_note = ("Paths are relative to this adapter, so `oracles/<path>` rolls as "
                           f"`roll table ${{CLAUDE_PLUGIN_ROOT}}/adapters/{adapter}/oracles/<path>`.")

    @property
    def url(self):
        return f"https://raw.githubusercontent.com/{UPSTREAM_REPO}/{UPSTREAM_REF}/{self.upstream_path}"


