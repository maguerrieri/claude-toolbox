LINK = re.compile(r"\[([^\]]*)\]\(datasworn:([^)\s]+)\)")
TABLE_TEMPLATE = re.compile(r"\{\{table>([^}]+)\}\}")
TABLE_KINDS = ("oracle_rollable", "move.oracle_rollable", "truth.option.oracle_rollable",
               "asset.ability.oracle_rollable")
