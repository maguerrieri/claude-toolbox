    if doc.base:
        intro = [f"The {len(truths)} setting truths of the {doc.pkg.title}. For each one, pick an option or",
                 "roll its table. Each option carries a quest starter, and each truth ends with",
                 f"prompts for your character and factions to add to the setting. {paths_note(doc.pkg)}"]
    else:
        intro = ["The Forge's 14 setting truths from the Starforged SRD. For each one, pick an option or",
                 "roll its table, then roll any sub-table the chosen option names. Each option carries a",
                 f"quest starter. {paths_note(doc.pkg)}"]
    out = [GENERATED, "# Setting Truths", ""] + intro + [""]
    for truth in truths:
        ref = truth["_id"]
        path = doc.path(ref)
        entries = []
        out += [f"## {truth['name']}", ""]
        if doc.base and truth.get("summary"):
            out += [f"*{doc.links(truth['summary'])}*", ""]
        out += [f"Roll `oracles/{path}` ({truth['dice']}), or choose.", ""]
        for opt in checked_rows(truth["options"], truth["dice"], ref):
            lines = [opt["summary"]] + entry_text(doc, opt["description"]).split("\n")
            if opt.get("quest_starter"):
                lines.append(f"Quest starter: {doc.links(opt['quest_starter'])}")
            entries.append((opt["roll"], lines))
            out += [f"### {_range(opt['roll'])}: {opt['summary']}", "", rules_text(doc, opt["description"]), ""]
            if opt.get("quest_starter"):
                out += [f"*Quest starter:* {doc.links(opt['quest_starter'])}", ""]
        if truth.get("your_character"):
            out += [f"*Your character:* {doc.links(truth['your_character'])}", ""]
        if truth.get("factions"):
            out += ["*Factions:*", ""] + [f"- {doc.links(f['text'])}" for f in truth["factions"]] + [""]
        emit_table(doc, files, path, f"Truth › {truth['name']}", ref, truth["dice"],
                   "Each option: its summary, the truth, then its quest starter.", entries)
    put(files, f"{doc.pkg.adapter}/rules/truths.md", "\n".join(out).rstrip() + "\n")


# --- moves ------------------------------------------------------------------

def roll_note(move):
    kind = ROLL_TYPES[move["roll_type"]]
    track = (move.get("tracks") or {}).get("category")
    return f"*Roll:* {kind}" + (f" ({track} track)" if track else "")


def merged_moves(doc):
    """[(category name, [(move, from the expansion?)])]: the ruleset's move list, with each
    move an expansion replaces swapped for its version, and the expansion's new moves after
    the moves of the category they enhance (or in a category of their own)."""
    if not doc.base:
        return [(cat["name"], [(m, False) for m in cat["contents"].values()]) for cat in doc.data["moves"].values()]
    cats = []
    for cat in doc.base.data["moves"].values():
        moves = [(doc.replaced[m["_id"]], True) if m["_id"] in doc.replaced else (m, False)
                 for m in cat["contents"].values()]
        cats.append((cat["_id"], cat["name"], moves))
    for cat in doc.data["moves"].values():
        new = [(m, True) for m in cat["contents"].values() if not m.get("replaces")]
        if not new:
            continue
        home = next((c for c in cats if c[0] in (cat.get("enhances") or [])), None)
        if home:
            home[2].extend(new)
        else:
            cats.append((cat["_id"], cat["name"], new))
    return [(name, moves) for _id, name, moves in cats]


def render_moves(doc, files):
    pkg = doc.pkg
    if doc.base:
        ours = [m for _n, ms in merged_moves(doc) for m, e in ms if e]
        swapped = sum(1 for m in ours if m.get("replaces"))
        new = len(ours) - swapped
        intro = [f"# {pkg.title} Moves", "",
                 f"The full move list for a {pkg.title} campaign: the {doc.base.pkg.title} moves from its SRD,",
                 f"with the {pkg.title} versions of the {swapped} it replaces in their place (each marked",
                 f"*{pkg.title} version*)" + (f", and {new} new {pkg.title} moves (marked *{pkg.title} move*)." if new else ".")]
    else:
        intro = ["# Starforged Moves", "", "The full Starforged move list from the SRD."]
    intro[-1] += " Rolls go through the `ironsworn-core` engine"
    out = [GENERATED] + intro + [
           "(`ironsworn-core/adapter.md`): an **action roll** is",
           "`roll ironsworn-action --stat <value> --adds <N>`; a **progress roll** is",
           "`roll ironsworn-progress --boxes <filled boxes>` on the named track (a legacy-track roll",
           "uses that track's filled boxes the same way). A table a move rolls on is shown in place,",
           f"with the path to roll it. {paths_note(pkg)}", ""]
    for name, moves in merged_moves(doc):
        out += [f"## {name}", ""]
        for move, ours in moves:
            mark = (f"*{pkg.title} version.* " if move.get("replaces") else f"*{pkg.title} move.* ") if ours else ""
            note = mark + roll_note(move)
            out += [f"### {move['name']}", "", note, "", rules_text(doc, move["text"]), ""]
    put(files, f"{pkg.adapter}/rules/moves.md", "\n".join(out).rstrip() + "\n")


# --- assets -----------------------------------------------------------------

def _option(o):
    if o.get("field_type") == "select_value":
        return f"{o['label']} ({' / '.join(c['label'] for c in o['choices'].values())})"
    return o["label"]


def _control(c):
    ft, label = c["field_type"], c["label"]
    if ft == "condition_meter":
        s = f"{label} meter: starts at {c['value']}, max {c['max']}"
        subs = [sc["label"] for sc in (c.get("controls") or {}).values()]
        return s + (f"; can be marked {', '.join(subs)}" if subs else "")
    if ft == "card_flip":
        return f"can be marked {label} (flip the card)"
    if ft == "clock":
        return f"{label}: a {c['max']}-segment clock"
    if ft == "checkbox":
        return f"[ ] {label}"
    if ft == "counter":
        return f"{label}: a counter, starting at {c['value']}"
    if ft == "select_enhancement":
        return f"{label} ({' / '.join(ch['label'] for ch in c['choices'].values())})"
    raise ValueError(f"unknown asset control type: {ft!r}")


def render_asset(doc, a):
    out = [f"## {a['name']}", ""]
    notes = []
    if a.get("requirement"):
        notes.append(f"*Requirement:* {doc.links(a['requirement'])}")
    if a.get("options"):
        notes.append("*Fill in:* " + "; ".join(_option(o) for o in a["options"].values()))
    for c in (a.get("controls") or {}).values():
        notes.append("*Track:* " + _control(c))
    if a.get("broken"):                     # a module card's "broken" flip, outside its controls
        notes.append("*Track:* " + _control(a["broken"]))
    if a.get("shared"):
        notes.append("*Shared asset.*")
    if a.get("count_as_impact"):
        notes.append("*Counts as an impact.*")
    att = (a.get("attachments") or {}).get("assets")
    if att:
        notes.append("*Attachments:* " + ", ".join(p.split("/")[1].replace("_", " ") + " assets" for p in att))
    for n in notes:
        out += [n + "  "]
    if notes:
        out[-1] = out[-1].rstrip()
        out.append("")
    for ab in a["abilities"]:
        box = "[x]" if ab.get("enabled") else "[ ]"
        body = doc.links(ab["text"]).split("\n")
        out.append(f"- {box} {body[0]}")
        out += [indent(ln) if ln else "" for ln in body[1:]]
        extras = [_option(o) for o in (ab.get("options") or {}).values()]
        if extras:
            out += ["", indent("*Fill in:* " + "; ".join(extras))]
        for c in (ab.get("controls") or {}).values():
            out += ["", indent("*Track:* " + _control(c))]
        for t in (ab.get("oracles") or {}).values():
            out += ["", indent(f"*Asset table:* {t['name']}, `oracles/{doc.path(t['_id'])}`")]
        for mv in (ab.get("moves") or {}).values():
            out += ["", indent(f"*Asset move:* **{mv['name']}** ({ROLL_TYPES[mv['roll_type']]})")]
            if mv["text"].strip() != ab["text"].strip():   # usually the ability text itself
                out += ["", indent(rules_text(doc, mv["text"]))]
    out.append("")
    return "\n".join(out)


def render_assets(doc, files):
    if doc.base:
        return render_expansion_assets(doc, files)
    index = [GENERATED, "# Starforged Assets", "",
             "The full Starforged asset compendium from the SRD, one file per category under",
             "`rules/assets/`. On each card, `[x]` marks an ability you start with and `[ ]` one you",
             "unlock with experience (Advance, `rules/moves.md`).", ""]
    for key, cat in doc.data["assets"].items():
        fname = _slug(key) + ".md"
        out = [GENERATED, f"# {cat['name']}", ""]
        if cat.get("description"):
            out += [doc.links(cat["description"]), ""]
        index += [f"## {cat['name']} (`rules/assets/{fname}`)", ""]
        if cat.get("description"):
            index += [doc.links(cat["description"]), ""]
        names = []
        for a in cat["contents"].values():
            out.append(render_asset(doc, a))
            names.append(a["name"])
        index += [", ".join(names) + ".", ""]
        put(files, f"{doc.pkg.adapter}/rules/assets/{fname}", "\n".join(out).rstrip() + "\n")
    put(files, f"{doc.pkg.adapter}/rules/assets.md", "\n".join(index).rstrip() + "\n")


def render_expansion_assets(doc, files):
    """The expansion's cards in rules/assets/<adapter>/, and an index of every category
    listing its cards and the ruleset's, which still apply."""
    pkg, base = doc.pkg, doc.base.pkg
    sub = f"rules/assets/{pkg.name}"
    index = [GENERATED, f"# {pkg.title} Assets", "",
             f"Every asset card for a {pkg.title} campaign: the {pkg.title} cards, one file per category",
             f"under `{sub}/`, and the {base.title} cards, which remain available, under `rules/assets/`",
             f"(from the {base.name} adapter). On each card, `[x]` marks an ability you start with and",
             "`[ ]` one you unlock with experience (Advance, `rules/moves.md`)."]
    index += ([pkg.deck] if pkg.deck else []) + [""]
    ours = {}
    for key, cat in doc.data["assets"].items():
        for a in cat["contents"].values():
            if a.get("replaces"):
                raise ValueError(f"{a['_id']} replaces an asset card; rules/assets.md has no way to say so yet")
        home = next((c for c in cat.get("enhances") or []), None)
        ours.setdefault(home or cat["_id"], []).append((key, cat))
    order = [(c["_id"], k, c) for k, c in doc.base.data["assets"].items()]
    order += [(cid, None, None) for cid in ours if cid not in {o[0] for o in order}]
    for cid, base_key, base_cat in order:
        mine = ours.get(cid, [])
        index += [f"## {(base_cat or mine[0][1])['name']}", ""]
        for key, cat in mine:
            fname = f"{sub}/{_slug(key)}.md"
            out = [GENERATED, f"# {cat['name']} ({pkg.title})", ""]
            if cat.get("description"):
                out += [doc.links(cat["description"]), ""]
            out += [render_asset(doc, a) for a in cat["contents"].values()]
            put(files, f"{pkg.adapter}/{fname}", "\n".join(out).rstrip() + "\n")
            index.append(f"- {pkg.title} (`{fname}`): " + ", ".join(a["name"] for a in cat["contents"].values()) + ".")
        if base_cat:
            index.append(f"- {base.title} (`rules/assets/{_slug(base_key)}.md`): "
                         + ", ".join(a["name"] for a in base_cat["contents"].values()) + ".")
        index.append("")
    put(files, f"{pkg.adapter}/rules/assets.md", "\n".join(index).rstrip() + "\n")


# --- oracle index -----------------------------------------------------------

def render_oracle_index(doc, files):
    pkg = doc.pkg
    curses = cursed_versions(doc)

    def walk(d, coll, depth, out, keep=lambda ref: True, note=lambda ref: ""):
        out.append("#" * depth + f" {coll['name']}")
        out.append("")
        if coll.get("summary") or coll.get("description"):
            out.extend([d.links(coll.get("description") or coll["summary"]), ""])
        if coll.get("oracle_type") == "table_shared_rolls":
            out.append(f"- `oracles/{collection_dir(coll['_id'], d.path)[:-1]}.md` — all columns, one roll")
        listed = False
        for t in coll.get("contents", {}).values():
            if keep(t["_id"]):
                out.append(f"- `oracles/{d.path(t['_id'])}` — {t['name']}{note(t['_id'])}")
                listed = True
        if listed or coll.get("oracle_type") == "table_shared_rolls":
            out.append("")
        for sub in coll.get("collections", {}).values():
            walk(d, sub, min(depth + 1, 6), out, keep, note)

    def ours_note(ref):
        n = ""
        if ref in doc.in_place_of:
            n += f" (in place of {doc.base.pkg.title}'s {doc.base.tables[doc.in_place_of[ref]][0]['name']})"
        if ref in curses:
            n += f" · cursed: `oracles/{doc.path(curses[ref])}`"
        return n

    if doc.base:
        out = [GENERATED, f"# {pkg.title} Oracles", "",
               f"Every table in force in a {pkg.title} campaign, by collection: the {pkg.title} oracles,",
               f"then the {doc.base.pkg.title} oracles it keeps. A table's file also carries its summary.",
               paths_note(pkg), "", f"## {pkg.title} oracle collections", ""]
        for coll in doc.data["oracles"].values():
            walk(doc, coll, 3, out, note=ours_note)
        out += [f"## {doc.base.pkg.title} oracle collections", "",
                f"The {doc.base.pkg.title} collections {pkg.title} doesn't replace. Where a {pkg.title} table",
                f"takes the same path, that one is in force; the {doc.base.pkg.title} table is still in the",
                f"{doc.base.pkg.name} adapter.", ""]
        mine = set(table_files(doc))
        for coll in doc.base.data["oracles"].values():
            if not _replacement(doc, coll["_id"]):
                walk(doc.base, coll, 3, out, keep=lambda ref: not _replacement(doc, ref),
                     note=lambda ref: f" (shadowed here by the {pkg.title} table at this path)"
                     if doc.base.path(ref) in mine else "")
        moves = [m for _n, ms in merged_moves(doc) for m, _e in ms]
    else:
        out = [GENERATED, "# Starforged Oracles", "",
               "Every rollable table this adapter ships, by collection; a table's file also carries",
               f"its summary. {paths_note(pkg)}", "", "## Oracle collections", ""]
        for coll in doc.data["oracles"].values():
            walk(doc, coll, 3, out)
        moves = [m for cat in doc.data["moves"].values() for m in cat["contents"].values()]
    out += ["## Move tables", ""]
    for move in moves:
        for t in move.get("oracles", {}).values():
            out.append(f"- `oracles/{doc.path(t['_id'])}` — {move['name']}: {t['name']}")
    asset_tables = [(a, t) for cat in doc.data["assets"].values() for a in cat["contents"].values()
                    for ab in a["abilities"] for t in (ab.get("oracles") or {}).values()]
    if asset_tables:
        out += ["", "## Asset tables", ""]
        out += [f"- `oracles/{doc.path(t['_id'])}` — {a['name']}: {t['name']}" for a, t in asset_tables]
    out += ["", "## Setting truths", "", "See `rules/truths.md`.", ""]
    for truth in doc.data["truths"].values():
        out.append(f"- `oracles/{doc.path(truth['_id'])}` — {truth['name']}")
        for opt in truth["options"]:
            for t in (opt.get("oracles") or {}).values():
                out.append(f"  - `oracles/{doc.path(t['_id'])}` — {t['name']} ({opt['summary']})")
    put(files, f"{pkg.adapter}/rules/oracles.md", "\n".join(out).rstrip() + "\n")


