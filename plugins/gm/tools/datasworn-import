def paths_note(pkg):
    root = "${CLAUDE_PLUGIN_ROOT}/" + pkg.adapter
    if not pkg.base:
        return f"Paths are relative to this adapter, so `oracles/<path>` rolls as `roll table {root}/oracles/<path>`."
    base = PACKAGES[pkg.base]
    return (f"Paths are relative to this adapter and resolve along `extends:`: `oracles/<path>` rolls as "
            f"`roll table {root}/oracles/<path>`, or, for a table only {base.title} ships, as "
            f"`roll table ${{CLAUDE_PLUGIN_ROOT}}/{base.adapter}/oracles/<path>`.")


# --- ids and paths ----------------------------------------------------------

def _slug(seg):
    return seg.replace("_", "-")


def _split(ref):
    """'oracle_rollable:starforged/core/action' -> ('oracle_rollable', 'core/action')."""
    kind, _, rest = ref.partition(":")
    ruleset, _, path = rest.partition("/")
    if ruleset not in PACKAGES or not path:
        raise ValueError(f"not an id from a pinned package: {ref!r}")
    return kind, path


def oracle_path(ref):
    """A rollable table's file, relative to the adapter's oracles/ dir.

    Datasworn ids map to nested paths (underscores become hyphens). Two families
    keep the flat names the gm core and the other adapters use: the core oracles
    (action, theme, descriptor, focus) sit at the top, and the Pay the Price
    move's table is pay-the-price.md. Tables inside moves live under moves/,
    tables inside truths under truths/<truth>/, and tables on an asset's ability
    under assets/<asset>/. The path ignores the package, so an expansion table
    whose id mirrors its ruleset's lands at the ruleset table's path.
    """
    kind, path = _split(ref)
    if kind in ("oracle_rollable", "oracle_collection"):
        segs = path.split("/")
        if segs[0] == "core":
            segs = segs[1:]
    elif kind == "move.oracle_rollable":
        move_path, _, key = path.partition(".")
        move = move_path.split("/")[-1]
        if move == "pay_the_price" and key == move:
            return "pay-the-price.md"
        segs = ["moves", move] + ([] if key == move else [key])
    elif kind == "truth.option.oracle_rollable":
        truth, _idx, key = path.split(".")
        segs = ["truths", truth, key]
    elif kind == "truth":
        segs = ["truths", path]
    elif kind == "asset.ability.oracle_rollable":
        asset_path, _idx, key = path.split(".")
        segs = ["assets", asset_path.split("/")[-1], key]
    else:
        raise ValueError(f"not an oracle id: {ref!r}")
    return "/".join(_slug(s) for s in segs) + ".md"


def collection_dir(ref, path=oracle_path):
    """An oracle collection's directory, relative to oracles/ ('' for core)."""
    p = path(ref)[: -len(".md")]
    return p + "/" if p else ""


def asset_category(ref):
    _kind, path = _split(ref)
    return path.split("/")[0].replace("_", " ")


# --- text -------------------------------------------------------------------

class Doc:
    """One parsed upstream file and its table index.

    An expansion's Doc has its ruleset's Doc as base: table lookups fall through to
    it, and replaced maps each ruleset id the expansion replaces to the object that
    replaces it."""

    def __init__(self, pkg, data, base=None):
        self.pkg = pkg
        self.data = data
        self.base = base
        self.rows = []          # collect_tables' output
        self.tables = {}        # ref -> (table, path), this file's own tables
        self.at = {}            # path -> (table, path), the same, by path
        self.paths = {}         # ref -> path, where it isn't oracle_path(ref)
        self.owners = {}        # id -> the ids it sits inside, outermost first
        self.replaced = {}      # base id -> the object replacing it
        self.redirects = {}     # base table path -> (base table ref, its title, the replacement)
        self.in_place_of = {}   # expansion table ref -> the ruleset table whose path it took
        self.files = None       # table_files(), once computed
        self.curses = None      # cursed_versions(), once computed

    def path(self, ref):
        return self.paths.get(ref) or oracle_path(ref)

    def links(self, text):
        return convert_links(text, self.path)

    def table(self, ref):
        """The table a reference reaches. A ruleset table the expansion replaced at the
        same path reaches the expansion's, which is the one a roll of that path finds."""
        if ref in self.tables:
            return self.tables[ref]
        p = self.path(ref)
        if p in self.at:
            return self.at[p]
        if p in self.redirects:
            raise ValueError(f"{ref} is replaced with nothing at oracles/{p}, so it can't be shown in place")
        if self.base:
            return self.base.table(ref)
        raise ValueError(f"reference to an unknown table: {ref!r}")


def convert_links(text, path=oracle_path):
    """Datasworn markdown links -> plain text the GM can act on.

    A table or collection keeps its path so the GM can roll it; a move is just its
    name (they all live in rules/moves.md); an asset names its category.
    """
    def sub(m):
        label, ref = m.group(1), m.group(2)
        kind = ref.partition(":")[0]
        if kind in TABLE_KINDS:
            return f"{label} (`oracles/{path(ref)}`)"
        if kind == "oracle_collection":
            return f"{label} (`oracles/{collection_dir(ref, path)}`)"
        if kind == "move":
            return label
        if kind == "asset":
            return f"{label} ({asset_category(ref)} asset)"
        raise ValueError(f"unknown datasworn link type: {ref!r}")

    out = LINK.sub(sub, text)
    if "datasworn:" in out or "{{" in out:     # a link we didn't parse, or a template
        raise ValueError(f"unconverted datasworn reference or template in: {text!r}")
    return out


def _range(roll):
    if not roll:
        return "—"
    lo, hi = roll["min"], roll["max"]
    return str(lo) if lo == hi else f"{lo}–{hi}"


def _cell(doc, text):
    return doc.links(text or "").replace("|", "\\|").replace("\n", "<br>")


def _columns(t):
    """The text columns a table's rows use: text, then text2 and text3 where any row has them."""
    return ["text"] + [c for c in ("text2", "text3") if any(r.get(c) for r in t["rows"])]


def md_table(doc, ref):
    """A table embedded in rules prose: its path, then its rows as a markdown table."""
    t, path = doc.table(ref)
    labels = t.get("column_labels") or {}
    cols = _columns(t)
    head = [labels.get("roll", "Roll"), labels.get("text", "Result")] + [labels.get(c, "") for c in cols[1:]]
    lines = [f"Roll `oracles/{path}` ({t['dice']}):", "",
             "| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    for r in t["rows"]:
        cells = [_range(r.get("roll"))] + [_cell(doc, r.get(c)) for c in cols]
        lines.append("| " + " | ".join(cells) + " |")
    return "\n".join(lines)


def rules_text(doc, text):
    """Datasworn prose for a rules file: links converted, embedded tables expanded."""
    return doc.links(TABLE_TEMPLATE.sub(lambda m: md_table(doc, m.group(1)), text))


def entry_text(doc, text):
    """Datasworn prose inside a table entry: an embedded table becomes a pointer."""
    return doc.links(TABLE_TEMPLATE.sub(lambda m: f"→ Roll `oracles/{doc.table(m.group(1))[1]}`.", text))


def quote(text):
    """Prose as a blockquote, so no line can read as a table entry (`- `) or continuation."""
    return "\n".join(("> " + line).rstrip() for line in text.split("\n"))


def indent(text, by="  "):
    return "\n".join((by + line).rstrip() for line in text.split("\n"))


def _tag(doc, obj, name):
    """One of this package's own tags on an object (Datasworn namespaces tags by package)."""
    return ((obj.get("tags") or {}).get(doc.pkg.key) or {}).get(name)


# --- oracle tables ----------------------------------------------------------

def _faces(dice):
    m = re.fullmatch(r"1d(\d+)", dice)
    if not m:
        raise ValueError(f"unsupported table dice: {dice!r}")
    return int(m.group(1))


def checked_rows(rows, dice, ref):
    """The rollable rows (a null roll is a result this column can't produce), checked
    to tile 1..faces exactly, so weights reproduce the upstream ranges."""
    live = [r for r in rows if r.get("roll") is not None]
    expect = 1
    for r in live:
        if r["roll"]["min"] != expect or r["roll"]["max"] < expect:
            raise ValueError(f"{ref}: rows don't tile the die at {expect} ({r['roll']})")
        expect = r["roll"]["max"] + 1
    if expect - 1 != _faces(dice):
        raise ValueError(f"{ref}: rows end at {expect - 1}, die is {dice}")
    return live


def row_lines(doc, row, labels=None, three=False):
    """One table row as entry lines: its text (+ second column), then any rolls on
    other tables that the text doesn't already link. In a three-column table (three),
    a row using more than its first column puts each column on its own line, after its
    label (`Rank: Dangerous`)."""
    cols = ("text", "text2", "text3")
    used = [c for c in cols if row.get(c)]
    if three and len(used) > 1:
        lines = []
        for c in used:
            label = (labels or {}).get(c)
            cell = doc.links(row[c])
            lines += (f"{label}: {cell}" if label and label != "Result" else cell).split("\n")
    else:
        text = doc.links(row["text"])
        if row.get("text2"):
            text = f"{text} — {doc.links(row['text2'])}"
        lines = text.split("\n")
    linked = {m.group(2) for m in LINK.finditer("".join(row.get(c) or "" for c in cols))}
    for roll in row.get("oracle_rolls") or []:
        ref = roll.get("oracle")
        if ref and ref not in linked:
            times = roll.get("number_of_rolls") or 1
            lines.append(f"→ Roll `oracles/{doc.path(ref)}`" + (f" ×{times}" if times > 1 else ""))
    return lines


def put(files, rel, text):
    if rel in files:
        raise ValueError(f"two generated files map to {rel}")
    files[rel] = text


def emit_table(doc, files, path, title, ref, dice, summary, entries):
    """Write a rollable table and its golden fixture. entries: [(roll, [line, …])], with
    roll the upstream {min, max}. The table weighs each entry max - min + 1, while the
    fixture keeps the upstream max, so a weight the table gets wrong fails the parity test.
    dice None is a redirect table, which has no die of its own."""
    out = [GENERATED, f"# {title}", ""]
    meta = f"Datasworn `{ref}`" + (f" · {dice}" if dice else "")
    out += [quote(f"{summary}\n\n{meta}" if summary else meta), ""]
    fixture = []
    for roll, lines in entries:
        lines = [ln.strip() for ln in lines if ln.strip()]
        out.append(f"- [{roll['max'] - roll['min'] + 1}] {lines[0]}")
        out += [f"  {ln}" for ln in lines[1:]]
        fixture.append({"max": roll["max"], "result": "\n".join(lines)})
    put(files, f"{doc.pkg.adapter}/oracles/{path}", "\n".join(out) + "\n")
    put(files, f"{doc.pkg.fixtures}/{path[:-3]}.json", fixture_json(ref, dice, fixture))


def fixture_json(ref, dice, rows):
    body = ",\n".join("    " + json.dumps(r, ensure_ascii=False) for r in rows)
    return (f'{{\n  "id": {json.dumps(ref)},\n  "die": {json.dumps(dice)},\n'
            f'  "rows": [\n{body}\n  ]\n}}\n')


def _short(name):
    return name[: -len(" Oracles")] if name.endswith(" Oracles") else name


def collect_tables(doc):
    """Every rollable table as (ref, path, title, table, parent collection) — oracles, move
    tables, truth sub-tables, asset-ability tables — into doc.rows, doc.tables and doc.at,
    and each table's and collection's enclosing ids into doc.owners. Order is the upstream
    file's."""
    found = []

    def walk(coll, trail, owners):
        if "_id" in coll:
            doc.owners[coll["_id"]] = owners
            owners = owners + [coll["_id"]]
        for t in coll.get("contents", {}).values():
            found.append((t["_id"], " › ".join(trail + [t["name"]]), t, coll, owners))
        for sub in coll.get("collections", {}).values():
            walk(sub, trail + [sub["name"]], owners)

    for coll in doc.data["oracles"].values():
        walk(coll, [_short(coll["name"])], [])
    for cat in doc.data["moves"].values():
        for move in cat["contents"].values():
            for key, t in move.get("oracles", {}).items():
                title = move["name"] if key == move["_id"].rsplit("/", 1)[-1] else f"{move['name']} › {t['name']}"
                found.append((t["_id"], title, t, None, [move["_id"]]))
    for truth in doc.data["truths"].values():
        for opt in truth["options"]:
            for t in (opt.get("oracles") or {}).values():
                found.append((t["_id"], f"{truth['name']} › {t['name']}", t, None, [truth["_id"]]))
    for cat in doc.data["assets"].values():
        for a in cat["contents"].values():
            for ab in a["abilities"]:
                for t in (ab.get("oracles") or {}).values():
                    found.append((t["_id"], f"{a['name']} › {t['name']}", t, None, [a["_id"]]))

    seen = {}
    for ref, title, t, parent, owners in found:
        path = doc.path(ref)
        if path in seen:
            raise ValueError(f"{ref} and {seen[path]} both map to oracles/{path}")
        seen[path] = ref
        doc.tables[ref] = doc.at[path] = (t, path)
        doc.owners[ref] = owners
        doc.rows.append((ref, path, title, t, parent))
    return doc.rows


def shared_roll_collections(doc):
    """table_shared_rolls collections: columns read off one roll (a character's given
    name, family name and callsign). Each also gets a combined table, one row per roll."""
    found = []

    def walk(coll, trail):
        if coll.get("oracle_type") == "table_shared_rolls":
            found.append((coll, " › ".join(trail)))
        for sub in coll.get("collections", {}).values():
            walk(sub, trail + [sub["name"]])

    for coll in doc.data["oracles"].values():
        walk(coll, [_short(coll["name"])])
    return found


def table_files(doc):
    """Every table file the package writes, as {path: (ref, title)}: its tables, its
    shared-roll combined tables, and its truths."""
    if doc.files is not None:
        return doc.files
    out = {path: (ref, title) for ref, path, title, _t, _p in doc.rows}
    for coll, title in shared_roll_collections(doc):
        out[collection_dir(coll["_id"], doc.path)[:-1] + ".md"] = (coll["_id"], title)
    for truth in doc.data["truths"].values():
        out[doc.path(truth["_id"])] = (truth["_id"], f"Truth › {truth['name']}")
    doc.files = out
    return out


def cursed_versions(doc):
    """{table ref: its cursed table's ref}, read from both ends of the link: an uncursed
    table's `cursed_by`, and a cursed table's `cursed_version_of`, whose ids may end in a
    `*` wildcard. Each end alone misses tables in this pin (Trademark Weapons has only the
    second). A link from a table to itself is dropped (ship/details_cursed's `cursed_by`,
    and the `cursed_version_of` of inland_cave/feature_cursed and ship/first_look_cursed),
    and so, as the tag's definition says, is a wildcard match on a table with its own
    `cursed_version_of`."""
    if doc.curses is not None:
        return doc.curses
    links = {}

    def link(ref, cursed):
        if ref != cursed and links.setdefault(ref, cursed) != cursed:
            raise ValueError(f"{ref} has two cursed versions, {links[ref]} and {cursed}")

    for ref, (t, _p) in doc.tables.items():
        if target := _tag(doc, t, "cursed_by"):
            link(ref, target)
    for cursed, (t, _p) in doc.tables.items():
        patterns = _tag(doc, t, "cursed_version_of") or []
        for pattern in [patterns] if isinstance(patterns, str) else patterns:
            if pattern.endswith("*"):
                for ref, (u, _q) in doc.tables.items():
                    if ref.startswith(pattern[:-1]) and not _tag(doc, u, "cursed_version_of"):
                        link(ref, cursed)
            elif pattern in doc.tables:
                link(pattern, cursed)
            else:
                raise ValueError(f"{cursed} is the cursed version of {pattern}, which isn't a table here")
    doc.curses = links
    return links


def curse_notes(doc):
    """{table ref: note} for the cursed die. A cursed table's `curse_behavior` says how a
    cursed result reads; without one (ship/details_cursed), the Guidebook's general rule
    applies: read the same roll on the cursed table."""
    notes, bases = {}, {}
    for ref, target in cursed_versions(doc).items():
        cursed, cpath = doc.table(target)
        behavior = _tag(doc, cursed, "curse_behavior") or "replace_result"
        if behavior == "replace_result":
            how = f"read the same roll on `oracles/{cpath}` instead"
        elif behavior == "add_result":
            how = f"also roll `oracles/{cpath}` and combine the two"
        else:
            raise ValueError(f"{target}: unknown curse_behavior {behavior!r}")
        notes[ref] = f"Cursed die: on a 10, {how}."
        bases.setdefault(target, []).append(f"`oracles/{doc.tables[ref][1]}`")
    for target, paths in bases.items():
        notes[target] = "The cursed version of " + ", ".join(paths) + "."
    return notes


def render_oracles(doc, files):
    curses = curse_notes(doc)
    for ref, path, title, t, parent in doc.rows:
        rows = checked_rows(t["rows"], t["dice"], ref)
        summary = t.get("summary")
        if not summary and t.get("oracle_type") in ("column_text", "column_text2"):
            summary = (parent or {}).get("summary")   # a column shares its collection's summary
        summary = doc.links(summary) if summary else ""
        if ref in curses:
            summary = (summary + "\n\n" if summary else "") + curses[ref]
        three = "text3" in _columns(t)
        emit_table(doc, files, path, title, ref, t["dice"], summary,
                   [(r["roll"], row_lines(doc, r, t.get("column_labels"), three)) for r in rows])

    for coll, title in shared_roll_collections(doc):
        ref = coll["_id"]
        cols = list(coll["contents"].values())
        rows = [checked_rows(c["rows"], c["dice"], c["_id"]) for c in cols]
        if len({c["dice"] for c in cols}) != 1 or len({tuple((r["roll"]["min"], r["roll"]["max"]) for r in rs) for rs in rows}) != 1:
            raise ValueError(f"{ref}: shared-roll columns don't share their rolls")
        entries = [(r["roll"], [" · ".join(f"{c['name']}: {doc.links(rs[i]['text'])}"
                                           for c, rs in zip(cols, rows))])
                   for i, r in enumerate(rows[0])]
        path = collection_dir(ref, doc.path)[:-1] + ".md"
        summary = doc.links(coll.get("summary") or "")
        summary = (summary + "\n\n" if summary else "") + (
            "This table reads every column off one roll. To roll a column on its own: "
            + ", ".join(f"`oracles/{doc.path(c['_id'])}`" for c in cols) + ".")
        emit_table(doc, files, path, title, ref, cols[0]["dice"], summary, entries)


# --- an expansion over its ruleset ------------------------------------------

def _objects(node):
    """Every dict in a parsed Datasworn file that has an _id."""
    if isinstance(node, dict):
        if "_id" in node:
            yield node
        for v in node.values():
            yield from _objects(v)
    elif isinstance(node, list):
        for v in node:
            yield from _objects(v)


def apply_errata(key, data):
    """A copy of data with the package's ERRATA rows added (data itself if it has none)."""
    if not ERRATA.get(key):
        return data
    data = json.loads(json.dumps(data))
    tables = {o["_id"]: o for o in _objects(data)}
    for ref, rows in ERRATA[key].items():
        t = tables.get(ref)
        end = t["rows"][-1]["roll"]["max"] if t else None
        if end != rows[0][0] - 1:
            raise ValueError(f"ERRATA for {ref} no longer applies (its rows end at {end}); remove it")
        t["rows"] += [{"roll": {"min": lo, "max": hi}, "text": text} for lo, hi, text in rows]
    return data


def link_expansion(doc):
    """Read the expansion's `replaces` into doc.replaced, and give each table that
    replaces a ruleset table that table's path."""
    base = doc.base
    known = {o["_id"] for o in _objects(base.data)}
    for obj in _objects(doc.data):
        refs, kind = obj.get("replaces") or [], obj["_id"].partition(":")[0]
        if kind == "move" and len(refs) > 1:
            raise ValueError(f"{obj['_id']} replaces {len(refs)} moves, but rules/moves.md can show it in one place")
        took = {}                               # path -> the ruleset table there
        for ref in refs:
            if ref not in known:
                raise ValueError(f"{obj['_id']} replaces {ref}, which {base.pkg.key} doesn't have")
            if ref in doc.replaced:
                raise ValueError(f"{ref} is replaced by both {doc.replaced[ref]['_id']} and {obj['_id']}")
            doc.replaced[ref] = obj
            if ref in base.tables and kind in TABLE_KINDS:
                took[base.tables[ref][1]] = ref
        if len(took) > 1:
            raise ValueError(f"{obj['_id']} replaces tables at two paths: "
                             + ", ".join(f"oracles/{p}" for p in sorted(took)))
        for path, ref in took.items():
            if path != oracle_path(obj["_id"]):
                doc.paths[obj["_id"]] = path
                doc.in_place_of[obj["_id"]] = ref


def _replacement(doc, ref):
    """The expansion object replacing a ruleset table, directly or as part of a
    collection, move or truth it sits in; None if it's still in force."""
    for r in [ref] + doc.base.owners.get(ref, [])[::-1]:
        if r in doc.replaced:
            return doc.replaced[r]
    return None


def check_paths(doc):
    """Every expansion table at a ruleset table's path must replace it (or be a listed
    shadow); every ruleset table it replaces with nothing at that path gets a redirect."""
    ours, theirs = table_files(doc), table_files(doc.base)
    shadows, used = SHADOWS.get(doc.pkg.key, set()), set()
    for path, (ref, _title) in ours.items():
        if path not in theirs or _replacement(doc, theirs[path][0]):
            continue
        if path not in shadows:
            raise ValueError(f"{ref} would hide {theirs[path][0]} at oracles/{path} without replacing it; "
                             "list the path in SHADOWS if that's intended")
        used.add(path)
    if shadows - used:
        raise ValueError(f"SHADOWS lists paths no table shares any more: {sorted(shadows - used)}")
    for coll, _title in shared_roll_collections(doc.base):
        cols = coll["contents"].values()
        if not _replacement(doc, coll["_id"]) and any(_replacement(doc, c["_id"]) or doc.base.path(c["_id"]) in ours
                                                      for c in cols):
            raise ValueError(f"{doc.pkg.key} replaces or shadows a column of {coll['_id']} but not the "
                             "collection, so its combined table would go stale")
    for path, (ref, title) in theirs.items():
        by = _replacement(doc, ref)
        if by and path not in ours:
            doc.redirects[path] = (ref, title, by)


def describe(doc, obj):
    """Where an expansion object is found, for a redirect."""
    ref, kind = obj["_id"], obj["_id"].partition(":")[0]
    if kind in TABLE_KINDS:
        return f"{obj['name']} (`oracles/{doc.path(ref)}`)"
    if kind == "oracle_collection":
        return f"{obj['name']} (`oracles/{collection_dir(ref, doc.path)}`)"
    if kind == "move":
        return f"the {obj['name']} move (`rules/moves.md`)"
    return obj["name"]


def render_redirects(doc, files):
    base = doc.base.pkg.title
    for path, (ref, title, by) in sorted(doc.redirects.items()):
        emit_table(doc, files, path, f"Replaced: {title}", ref, None,
                   f"{doc.pkg.title} replaces this {base} table. Rolling it gives the replacement.",
                   [({"min": 1, "max": 1}, [f"Replaced in {doc.pkg.title}: use {describe(doc, by)}."])])


