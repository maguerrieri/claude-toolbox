LINK = re.compile(r"\[([^\]]*)\]\(datasworn:([^)\s]+)\)")
TABLE_TEMPLATE = re.compile(r"\{\{table>([^}]+)\}\}")
ROLL_TYPES = {
    "action_roll": "action roll",
    "progress_roll": "progress roll",
    "no_roll": "no roll",
}
# Datasworn's ChallengeRank: 1..5 in the core's rank order.
RANKS = {1: "troublesome", 2: "dangerous", 3: "formidable", 4: "extreme", 5: "epic"}


# --- ids and paths ----------------------------------------------------------

def _slug(seg):
    return seg.replace("_", "-")


def _split_any(ref):
    """'oracle_rollable:starforged/core/action' -> ('oracle_rollable', 'starforged', 'core/action'),
    for any ruleset (a link may point outside the ones this tool reads)."""
    kind, _, rest = ref.partition(":")
    ruleset, _, path = rest.partition("/")
    return kind, ruleset, path


def _split(ref):
    """Like _split_any, for a ruleset this tool reads: the ruleset comes back as its Ruleset."""
    kind, ruleset, path = _split_any(ref)
    if ruleset not in RULESETS or not path:
        raise ValueError(f"not a starforged or classic id: {ref!r}")
    return kind, RULESETS[ruleset], path


def oracle_path(ref):
    """A rollable table's file, relative to its adapter's oracles/ dir.

    Datasworn ids map to nested paths (underscores become hyphens). The core oracles
    (the ruleset's `flat` collection: action and theme, and in Starforged descriptor
    and focus) sit at the top, where the gm core looks for its action + theme spark.
    Tables inside moves live under moves/, tables inside truths under truths/<truth>/.
    """
    kind, rs, path = _split(ref)
    if kind in ("oracle_rollable", "oracle_collection"):
        segs = path.split("/")
        if segs[0] == rs.flat:
            segs = segs[1:]
    elif kind == "move.oracle_rollable":
        move_path, _, key = path.partition(".")
        move = move_path.split("/")[-1]
        segs = ["moves", move] + ([] if key == move else [key])
    elif kind == "truth.option.oracle_rollable":
        truth, _idx, key = path.split(".")
        segs = ["truths", truth, key]
    elif kind == "truth":
        segs = ["truths", path]
    else:
        raise ValueError(f"not an oracle id: {ref!r}")
    return "/".join(_slug(s) for s in segs) + ".md"


def collection_dir(ref):
    """An oracle collection's directory, relative to oracles/ ('' for the flat one)."""
    p = oracle_path(ref)[: -len(".md")]
    return p + "/" if p else ""


def asset_category(ref):
    _kind, _rs, path = _split(ref)
    return path.split("/")[0].replace("_", " ")


# --- text -------------------------------------------------------------------

class Doc:
    """The parsed upstream file, its ruleset, and an index from table id to (table, path)."""

    def __init__(self, data, rs):
        self.data = data
        self.rs = rs
        self.tables = {}

    def table(self, ref):
        if ref not in self.tables:
            raise ValueError(f"reference to an unknown table: {ref!r}")
        return self.tables[ref]


def convert_links(text, rs):
    """Datasworn markdown links -> plain text the GM can act on.

    A table or collection keeps its path so the GM can roll it; a move is just its
    name (they all live in rules/moves.md), and so is a region or an NPC for a ruleset
    that ships them (rs.named_kinds: rules/regions.md, rules/encounters.md); an asset names
    its category. A truth or move category named in prose is just its name too. A link
    into another ruleset is an error, except a move, which names its game (an asset
    can point at an expansion's move).
    """
    def sub(m):
        label, ref = m.group(1), m.group(2)
        kind, other, _path = _split_any(ref)
        if other != rs.key:
            if kind == "move":
                return f"{label} ({other.replace('_', ' ').title()} move)"
            raise ValueError(f"link into another ruleset: {ref!r}")
        if kind in ("oracle_rollable", "move.oracle_rollable", "truth.option.oracle_rollable"):
            return f"{label} (`oracles/{oracle_path(ref)}`)"
        if kind == "oracle_collection":
            return f"{label} (`oracles/{collection_dir(ref)}`)"
        if kind in ("move", "move_category", "truth") or kind in rs.named_kinds:
            return label
        if kind == "asset":
            return f"{label} ({asset_category(ref)} asset)"
        raise ValueError(f"unknown datasworn link type: {ref!r}")

    out = LINK.sub(sub, text)
    if "datasworn:" in out or "{{" in out:     # a link we didn't parse, or a template
        raise ValueError(f"unconverted datasworn reference or template in: {text!r}")
    return out


def _range(roll):
    if not roll:
        return "—"
    lo, hi = roll["min"], roll["max"]
    return str(lo) if lo == hi else f"{lo}–{hi}"


def _cell(text, rs):
    return convert_links(text or "", rs).replace("|", "\\|").replace("\n", "<br>")


def md_table(doc, ref):
    """A table embedded in rules prose: its path, then its rows as a markdown table."""
    t, path = doc.table(ref)
    labels = t.get("column_labels") or {}
    has2 = any(r.get("text2") for r in t["rows"])
    head = [labels.get("roll", "Roll"), labels.get("text", "Result")]
    if has2:
        head.append(labels.get("text2", ""))
    lines = [f"Roll `oracles/{path}` ({t['dice']}):", "",
             "| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    for r in t["rows"]:
        cells = [_range(r.get("roll")), _cell(r["text"], doc.rs)]
        if has2:
            cells.append(_cell(r.get("text2"), doc.rs))
        lines.append("| " + " | ".join(cells) + " |")
    return "\n".join(lines)


def rules_text(doc, text):
    """Datasworn prose for a rules file: links converted, embedded tables expanded."""
    return convert_links(TABLE_TEMPLATE.sub(lambda m: md_table(doc, m.group(1)), text), doc.rs)


def entry_text(doc, text):
    """Datasworn prose inside a table entry: an embedded table becomes a pointer."""
    return convert_links(TABLE_TEMPLATE.sub(lambda m: f"→ Roll `oracles/{doc.table(m.group(1))[1]}`.", text),
                         doc.rs)


def quote(text):
    """Prose as a blockquote, so no line can read as a table entry (`- `) or continuation."""
    return "\n".join(("> " + line).rstrip() for line in text.split("\n"))


def indent(text, by="  "):
    return "\n".join((by + line).rstrip() for line in text.split("\n"))


# --- oracle tables ----------------------------------------------------------

def _faces(dice):
    m = re.fullmatch(r"1d(\d+)", dice)
    if not m:
        raise ValueError(f"unsupported table dice: {dice!r}")
    return int(m.group(1))


def checked_rows(rows, dice, ref):
    """The rollable rows (a null roll is a result this column can't produce), checked
    to tile 1..faces exactly, so weights reproduce the upstream ranges."""
    live = [r for r in rows if r.get("roll") is not None]
    expect = 1
    for r in live:
        if r["roll"]["min"] != expect or r["roll"]["max"] < expect:
            raise ValueError(f"{ref}: rows don't tile the die at {expect} ({r['roll']})")
        expect = r["roll"]["max"] + 1
    if expect - 1 != _faces(dice):
        raise ValueError(f"{ref}: rows end at {expect - 1}, die is {dice}")
    return live


def row_lines(row, doc):
    """One table row as entry lines: its text (+ second column), then any rolls on
    other tables, and any tables it suggests next, that the text doesn't already link."""
    rs = doc.rs
    text = convert_links(row["text"], rs)
    if row.get("text2"):
        text = f"{text} — {convert_links(row['text2'], rs)}"
    lines = text.split("\n")
    linked = {m.group(2) for m in LINK.finditer(row["text"] + (row.get("text2") or ""))}
    for roll in row.get("oracle_rolls") or []:
        ref = roll.get("oracle")
        if ref and ref not in linked:
            times = roll.get("number_of_rolls") or 1
            lines.append(f"→ Roll `oracles/{doc.table(ref)[1]}`" + (f" ×{times}" if times > 1 else ""))
            linked.add(ref)
    for ref in row.get("suggestions") or []:
        if ref not in linked:
            if _split(ref)[1] is not rs:
                raise ValueError(f"suggestion in another ruleset: {ref!r}")
            where = collection_dir(ref) if ref.startswith("oracle_collection:") else oracle_path(ref)
            lines.append(f"→ Next, consider `oracles/{where}`")
            linked.add(ref)
    return lines


def put(files, rel, text):
    if rel in files:
        raise ValueError(f"two generated files map to {rel}")
    files[rel] = text


def emit_table(doc, files, path, title, ref, dice, summary, entries):
    """Write a rollable table and its golden fixture. entries: [(roll, [line, …])], with
    roll the upstream {min, max}. The table weighs each entry max - min + 1, while the
    fixture keeps the upstream max, so a weight the table gets wrong fails the parity test."""
    out = [GENERATED, f"# {title}", ""]
    meta = f"Datasworn `{ref}` · {dice}"
    out += [quote(f"{summary}\n\n{meta}" if summary else meta), ""]
    fixture = []
    for roll, lines in entries:
        lines = [ln.strip() for ln in lines if ln.strip()]
        out.append(f"- [{roll['max'] - roll['min'] + 1}] {lines[0]}")
        out += [f"  {ln}" for ln in lines[1:]]
        fixture.append({"max": roll["max"], "result": "\n".join(lines)})
    put(files, f"{doc.rs.adapter_dir}/oracles/{path}", "\n".join(out) + "\n")
    put(files, f"{doc.rs.fixtures_dir}/{path[:-3]}.json", fixture_json(ref, dice, fixture))


def fixture_json(ref, dice, rows):
    body = ",\n".join("    " + json.dumps(r, ensure_ascii=False) for r in rows)
    return (f'{{\n  "id": {json.dumps(ref)},\n  "die": {json.dumps(dice)},\n'
            f'  "rows": [\n{body}\n  ]\n}}\n')


def _short(name):
    return name[: -len(" Oracles")] if name.endswith(" Oracles") else name


def collect_tables(doc):
    """Every rollable table as (ref, path, title, table) — oracles, move tables,
    truth sub-tables — and fill doc.tables. Order is the upstream file's."""
    found = []

    def walk(coll, trail):
        for t in coll.get("contents", {}).values():
            found.append((t["_id"], " › ".join(trail + [t["name"]]), t, coll))
        for sub in coll.get("collections", {}).values():
            walk(sub, trail + [sub["name"]])

    for coll in doc.data["oracles"].values():
        walk(coll, [_short(coll["name"])])
    for cat in doc.data["moves"].values():
        for move in cat["contents"].values():
            for key, t in move.get("oracles", {}).items():
                title = move["name"] if key == move["_id"].rsplit("/", 1)[-1] else f"{move['name']} › {t['name']}"
                found.append((t["_id"], title, t, None))
    for truth in doc.data["truths"].values():
        for opt in truth["options"]:
            for t in (opt.get("oracles") or {}).values():
                found.append((t["_id"], f"{truth['name']} › {t['name']}", t, None))

    out, seen = [], {}
    for ref, title, t, parent in found:
        path = oracle_path(ref)
        if path in seen:
            raise ValueError(f"{ref} and {seen[path]} both map to oracles/{path}")
        seen[path] = ref
        doc.tables[ref] = (t, path)
        out.append((ref, path, title, t, parent))
    return out


# "Given and family names are presented as a pair, so you may roll once for both." No
# classic collection qualifies: Quick Settlement Name rolls its prefix and suffix apart,
# and Other Names lists giants', varou and trolls' names side by side.
ONE_ROLL = {"oracle_collection:starforged/character/name"}


def shared_roll_collections(doc):
    """The table_shared_rolls collections meant to be read off one roll, each of which
    gets a combined table with one row per roll. Sharing rolls only aligns the columns'
    ranges; whether to read them together is in each collection's summary, so it's listed
    in ONE_ROLL rather than inferred (Sector Name says to roll each word separately)."""
    found = []

    def walk(coll, trail):
        if coll.get("oracle_type") == "table_shared_rolls" and coll["_id"] in ONE_ROLL:
            found.append((coll, " › ".join(trail)))
        for sub in coll.get("collections", {}).values():
            walk(sub, trail + [sub["name"]])

    for coll in doc.data["oracles"].values():
        walk(coll, [_short(coll["name"])])
    return found


def render_oracles(doc, files):
    rs = doc.rs
    for ref, path, title, t, parent in collect_tables(doc):
        rows = checked_rows(t["rows"], t["dice"], ref)
        summary = t.get("summary")
        if not summary and t.get("oracle_type") == "column_text":
            summary = (parent or {}).get("summary")   # a column shares its collection's summary
        emit_table(doc, files, path, title, ref, t["dice"], convert_links(summary, rs) if summary else "",
                   [(r["roll"], row_lines(r, doc)) for r in rows])

    for coll, title in shared_roll_collections(doc):
        ref = coll["_id"]
        cols = list(coll["contents"].values())
        rows = [checked_rows(c["rows"], c["dice"], c["_id"]) for c in cols]
        if len({c["dice"] for c in cols}) != 1 or len({tuple((r["roll"]["min"], r["roll"]["max"]) for r in rs_)
                                                         for rs_ in rows}) != 1:
            raise ValueError(f"{ref}: shared-roll columns don't share their rolls")
        entries = [(r["roll"], [" · ".join(f"{c['name']}: {convert_links(col[i]['text'], rs)}"
                                           for c, col in zip(cols, rows))])
                   for i, r in enumerate(rows[0])]
        path = collection_dir(ref)[:-1] + ".md"
        summary = convert_links(coll.get("summary") or "", rs)
        summary = (summary + "\n\n" if summary else "") + (
            "This table reads every column off one roll. To roll a column on its own: "
            + ", ".join(f"`oracles/{oracle_path(c['_id'])}`" for c in cols) + ".")
        emit_table(doc, files, path, title, ref, cols[0]["dice"], summary, entries)


# --- truths -----------------------------------------------------------------

def render_truths(doc, files):
    rs = doc.rs
    truths = doc.data["truths"]
    title, intro, entry_note = rs.truths_intro
    out = [GENERATED, f"# {title}", ""]
    out += [line.format(n=len(truths), paths_note=rs.paths_note) for line in intro] + [""]
    for truth in truths.values():
        ref = truth["_id"]
        path = oracle_path(ref)
        entries = []
        out += [f"## {truth['name']}", "", f"Roll `oracles/{path}` ({truth['dice']}), or choose.", ""]
        for opt in checked_rows(truth["options"], truth["dice"], ref):
            summary = convert_links(opt["summary"], rs) if opt.get("summary") else None
            lines = ([summary] if summary else []) + entry_text(doc, opt["description"]).split("\n")
            if opt.get("quest_starter"):
                lines.append(f"Quest starter: {convert_links(opt['quest_starter'], rs)}")
            entries.append((opt["roll"], lines))
            out += [f"### {_range(opt['roll'])}" + (f": {summary}" if summary else ""), "",
                    rules_text(doc, opt["description"]), ""]
            if opt.get("quest_starter"):
                out += [f"*Quest starter:* {convert_links(opt['quest_starter'], rs)}", ""]
        if truth.get("your_character"):
            out += [f"*Your character:* {convert_links(truth['your_character'], rs)}", ""]
        emit_table(doc, files, path, f"Truth › {truth['name']}", ref, truth["dice"], entry_note, entries)
    put(files, f"{rs.adapter_dir}/rules/truths.md", "\n".join(out).rstrip() + "\n")


# --- moves ------------------------------------------------------------------

def roll_kind(roll_type, rs):
    return rs.special_track if roll_type == "special_track" else ROLL_TYPES[roll_type]


def roll_note(move, rs):
    kind = roll_kind(move["roll_type"], rs)
    track = (move.get("tracks") or {}).get("category")
    return f"*Roll:* {kind}" + (f" ({track} track)" if track else "")


def render_moves(doc, files):
    rs = doc.rs
    first, rest = rs.epilogue
    out = [GENERATED, f"# {rs.title} Moves", "",
           f"The full {rs.title} move list from the SRD. Rolls go through the `ironsworn-core` engine",
           "(`ironsworn-core/adapter.md`): an **action roll** is",
           "`roll ironsworn-action --stat <value> --adds <N>`; a **progress roll** is",
           f"`roll ironsworn-progress --boxes <filled boxes>` on the named track ({first}",
           f"{rest} the same way). A table a move rolls on is shown in place,",
           f"with the path to roll it. {rs.paths_note}", ""]
    for cat in doc.data["moves"].values():
        out += [f"## {cat['name']}", ""]
        for move in cat["contents"].values():
            out += [f"### {move['name']}", "", roll_note(move, rs), "", rules_text(doc, move["text"]), ""]
            # tables the move carries but its text doesn't embed (Ask the Oracle's odds)
            loose = [t for t in move.get("oracles", {}).values() if t["_id"] not in move["text"]]
            if loose:
                out += ["Roll its tables: " + ", ".join(
                    f"{t['name']} `oracles/{oracle_path(t['_id'])}`" for t in loose) + ".", ""]
    put(files, f"{rs.adapter_dir}/rules/moves.md", "\n".join(out).rstrip() + "\n")


# --- assets -----------------------------------------------------------------

def _option(o):
    if o.get("field_type") == "select_value":
        return f"{o['label']} ({' / '.join(c['label'] for c in o['choices'].values())})"
    return o["label"]


def _control(c):
    ft, label = c["field_type"], c["label"]
    if ft == "condition_meter":
        s = f"{label} meter: starts at {c['value']}, max {c['max']}"
        subs = [sc["label"] for sc in (c.get("controls") or {}).values()]
        return s + (f"; can be marked {', '.join(subs)}" if subs else "")
    if ft == "card_flip":
        return f"can be marked {label} (flip the card)"
    if ft == "clock":
        return f"{label}: a {c['max']}-segment clock"
    if ft == "checkbox":
        return f"[ ] {label}"
    if ft == "counter":
        return f"{label}: a counter, starting at {c['value']}"
    if ft == "select_enhancement":
        return f"{label}: {' / '.join(ch['label'] for ch in c['choices'].values())}"
    raise ValueError(f"unknown asset control type: {ft!r}")


def _control_note(c):
    return ("*Choose:* " if c["field_type"] == "select_enhancement" else "*Track:* ") + _control(c)


def render_asset(doc, a):
    rs = doc.rs
    out = [f"## {a['name']}", ""]
    notes = []
    if a.get("requirement"):
        notes.append(f"*Requirement:* {convert_links(a['requirement'], rs)}")
    if a.get("options"):
        notes.append("*Fill in:* " + "; ".join(_option(o) for o in a["options"].values()))
    for c in (a.get("controls") or {}).values():
        notes.append(_control_note(c))
    if a.get("shared"):
        notes.append("*Shared asset.*")
    if a.get("count_as_impact"):
        notes.append("*Counts as an impact.*")
    att = (a.get("attachments") or {}).get("assets")
    if att:
        notes.append("*Attachments:* " + ", ".join(p.split("/")[1].replace("_", " ") + " assets" for p in att))
    for n in notes:
        out += [n + "  "]
    if notes:
        out[-1] = out[-1].rstrip()
        out.append("")
    for ab in a["abilities"]:
        box = "[x]" if ab.get("enabled") else "[ ]"
        body = convert_links(ab["text"], rs).split("\n")
        name = f"**{ab['name']}:** " if ab.get("name") else ""
        out.append(f"- {box} {name}{body[0]}")
        out += [indent(ln) if ln else "" for ln in body[1:]]
        extras = [_option(o) for o in (ab.get("options") or {}).values()]
        if extras:
            out += ["", indent("*Fill in:* " + "; ".join(extras))]
        for c in (ab.get("controls") or {}).values():
            out += ["", indent(_control_note(c))]
        for mv in (ab.get("moves") or {}).values():
            out += ["", indent(f"*Asset move:* **{mv['name']}** ({roll_kind(mv['roll_type'], rs)})")]
            if mv["text"].strip() != ab["text"].strip():   # usually the ability text itself
                out += ["", indent(rules_text(doc, mv["text"]))]
    out.append("")
    return "\n".join(out)


def render_assets(doc, files):
    rs = doc.rs
    index = [GENERATED, f"# {rs.title} Assets", "",
             f"The full {rs.title} asset compendium from the SRD, one file per category under",
             "`rules/assets/`. On each card, `[x]` marks an ability you start with and `[ ]` one you",
             "unlock with experience (Advance, `rules/moves.md`)." + rs.unmarked_note, ""]
    for key, cat in doc.data["assets"].items():
        fname = _slug(key) + ".md"
        out = [GENERATED, f"# {cat['name']}", ""]
        if cat.get("description"):
            out += [convert_links(cat["description"], rs), ""]
        index += [f"## {cat['name']} (`rules/assets/{fname}`)", ""]
        if cat.get("description"):
            index += [convert_links(cat["description"], rs), ""]
        names = []
        for a in cat["contents"].values():
            out.append(render_asset(doc, a))
            names.append(a["name"])
        index += [", ".join(names) + ".", ""]
        put(files, f"{rs.adapter_dir}/rules/assets/{fname}", "\n".join(out).rstrip() + "\n")
    put(files, f"{rs.adapter_dir}/rules/assets.md", "\n".join(index).rstrip() + "\n")


# --- oracle index -----------------------------------------------------------

def render_oracle_index(doc, files):
    rs = doc.rs
    out = [GENERATED, f"# {rs.title} Oracles", "",
           "Every rollable table this adapter ships, by collection; a table's file also carries",
           f"its summary. {rs.paths_note}", ""]

    def walk(coll, depth):
        out.append("#" * depth + f" {coll['name']}")
        out.append("")
        if coll.get("summary") or coll.get("description"):
            out.extend([convert_links(coll.get("description") or coll["summary"], rs), ""])
        if coll.get("_id") in ONE_ROLL:
            out.append(f"- `oracles/{collection_dir(coll['_id'])[:-1]}.md` — all columns, one roll")
        for t in coll.get("contents", {}).values():
            out.append(f"- `oracles/{oracle_path(t['_id'])}` — {t['name']}")
        if coll.get("contents"):
            out.append("")
        for sub in coll.get("collections", {}).values():
            walk(sub, min(depth + 1, 6))

    out += ["## Oracle collections", ""]
    for coll in doc.data["oracles"].values():
        walk(coll, 3)
    out += ["## Move tables", ""]
    for cat in doc.data["moves"].values():
        for move in cat["contents"].values():
            for t in move.get("oracles", {}).values():
                out.append(f"- `oracles/{oracle_path(t['_id'])}` — {move['name']}: {t['name']}")
    out += ["", "## Setting truths", "", "See `rules/truths.md`.", ""]
    for truth in doc.data["truths"].values():
        out.append(f"- `oracles/{oracle_path(truth['_id'])}` — {truth['name']}")
        for opt in truth["options"]:
            for t in (opt.get("oracles") or {}).values():
                out.append(f"  - `oracles/{oracle_path(t['_id'])}` — {t['name']} ({convert_links(opt['summary'], rs) if opt.get('summary') else _range(opt['roll'])})")
    put(files, f"{rs.adapter_dir}/rules/oracles.md", "\n".join(out).rstrip() + "\n")


# --- npcs and regions -------------------------------------------------------------

def _list(label, items, rs):
    return f"*{label}:* " + "; ".join(convert_links(i, rs) for i in items) + "."


def _rank(n):
    return f"{RANKS[n]} ({n})"


def render_npcs(doc, files):
    rs = doc.rs
    title, intro = rs.encounters_intro
    out = [GENERATED, f"# {title}", ""] + intro + [""]
    for coll in doc.data.get("npcs", {}).values():
        if coll.get("collections"):
            raise ValueError(f"{coll['_id']}: nested NPC collections aren't rendered yet")
        out += [f"## {coll['name']}", ""]
        if coll.get("description"):
            out += [convert_links(coll["description"], rs), ""]
        for npc in coll["contents"].values():
            summary = f" · {convert_links(npc['summary'], rs)}" if npc.get("summary") else ""
            out += [f"### {npc['name']}", "", f"*{npc['nature']}*{summary} · **Rank:** {_rank(npc['rank'])}", ""]
            for label in ("features", "drives", "tactics"):
                if npc.get(label):
                    out += [f"**{label.capitalize()}:** " + "; ".join(convert_links(x, rs) for x in npc[label]), ""]
            out += [convert_links(npc["description"], rs), ""]
            for v in (npc.get("variants") or {}).values():
                out += [f"- **{v['name']}** (*{v['nature']}*, {_rank(v['rank'])}): {convert_links(v['description'], rs)}"]
            if npc.get("variants"):
                out.append("")
            if npc.get("quest_starter"):
                out += [f"*Quest starter:* {convert_links(npc['quest_starter'], rs)}", ""]
            if npc.get("your_truth"):
                out += [f"*Your truth:* {convert_links(npc['your_truth'], rs)}", ""]
    put(files, f"{rs.adapter_dir}/rules/encounters.md", "\n".join(out).rstrip() + "\n")


def render_regions(doc, files):
    rs = doc.rs
    region = doc.table(f"oracle_rollable:{rs.key}/place/region")[1]
    out = [GENERATED, "# Regions of the Ironlands", ""]
    for atlas in doc.data["atlas"].values():
        out += [convert_links(atlas["summary"], rs), "",
                f"Roll a region with `oracles/{region}`; the Undertake a Journey move",
                "(`rules/moves.md`) covers travel between them.", ""]
        if atlas.get("collections"):
            raise ValueError(f"{atlas['_id']}: nested atlas collections aren't rendered yet")
        for entry in atlas["contents"].values():
            out += [f"## {entry['name']}", "", convert_links(entry["summary"], rs), "",
                    _list("Features", entry["features"], rs), "",
                    convert_links(entry["description"], rs), ""]
            if entry.get("quest_starter"):
                out += [f"*Quest starter:* {convert_links(entry['quest_starter'], rs)}", ""]
    put(files, f"{rs.adapter_dir}/rules/regions.md", "\n".join(out).rstrip() + "\n")


# --- sheets -----------------------------------------------------------------

def _meter(m):
    return f"[{'▰' * m['value'] + '▱' * (m['max'] - m['value'])}] {m['value']}/{m['max']}"


def sheet_lines(data, rs):
    """The lines the hand-written sheet-template.md must carry verbatim: every part of
    the sheet that comes from the data."""
    rules = data["rules"]
    lines = ["- " + " · ".join(f"{k} {{{{}}}}" for k in rules["stats"])]
    lines += [f"  - *{k}:* {v['description']}" for k, v in rules["stats"].items()]
    lines += [f"- {m['label'].capitalize():<8} {_meter(m)}" for m in rules["condition_meters"].values()]
    lines += [f"- *{g['label']}:* " + " ".join(f"[ ] {i['label']}" for i in g["contents"].values())
              for g in rules["impacts"].values()]
    lines += [f"- {t['label'].capitalize():<11} [▱▱▱▱▱▱▱▱▱▱] 0/10 — {t['description']}"
              for t in rules["special_tracks"].values()]
    if rs.sheet_asset:
        cat, key, label = rs.sheet_asset
        asset = data["assets"][cat]["contents"][key]
        lines += [f"- {label} {c['label']} {_meter(c)}" for c in asset["controls"].values()]
    return lines


def check_sheet(root, data, rs):
    """Problems with the hand-written sheet: each data line it lacks, as a --check line."""
    p = os.path.join(root, rs.sheet)
    if not os.path.isfile(p):
        return [f"missing   {rs.sheet} (hand-written; see sheet_lines())"]
    with open(p, encoding="utf-8") as fh:
        have = set(fh.read().split("\n"))
    return [f"sheet     {rs.sheet} lacks the data line: {line}" for line in sheet_lines(data, rs) if line not in have]


# --- driver -----------------------------------------------------------------

def check_licenses(data, rs):
    """No object in a section this tool renders carries a license other than the one
    rs.licenses (and so the adapter's SOURCE.md) records for that section. A section
    with no tagged objects falls under the file's own license."""
    for section in rs.licenses:
        found = set()

        def walk(node):
            if isinstance(node, dict):
                if isinstance(node.get("_source"), dict):
                    found.add(node["_source"].get("license"))
                for v in node.values():
                    walk(v)
            elif isinstance(node, list):
                for v in node:
                    walk(v)

        walk(data.get(section) or {})
        if not found and data.get("license"):
            found = {data["license"]}
        if found - {rs.licenses[section]}:
            raise ValueError(f"{rs.key} {section}: licensed {sorted(map(str, found))}, "
                             f"expected {rs.licenses[section]}; update RULESETS and SOURCE.md")


def apply_errata(data, rs):
    if not ERRATA.get(rs.key):
        return data
    data = copy.deepcopy(data)
    for path, old, new, _why in ERRATA.get(rs.key, []):
        node = data
        try:
            for key in path[:-1]:
                node = node[key]
            found = node[path[-1]]
        except (KeyError, IndexError, TypeError):
            raise ValueError(f"{rs.key} erratum at {path}: upstream has no such value; "
                             "drop the erratum if the pin fixed it") from None
        if found != old:
            raise ValueError(f"{rs.key} erratum at {path}: upstream is {found!r}, not {old!r}; "
                             "drop the erratum if the pin fixed it")
        node[path[-1]] = new
    return data


# What each ruleset renders beyond the oracles, truths, moves, assets and index.
RENDERERS = {
    "starforged": [render_npcs],
    "classic": [render_npcs, render_regions],
}
METADATA = {"_id", "type", "datasworn_version", "title", "license", "authors", "date", "url"}


def generate(data, rs):
    """The whole generated tree for one ruleset: {path relative to the plugin root: content}."""
    for key, value in data.items():     # the sections a ruleset renders are the ones it licenses
        if key not in set(rs.licenses) | METADATA and value:
            raise ValueError(f"{rs.key}: upstream section {key!r} has content this tool doesn't convert")
    check_licenses(data, rs)
    doc = Doc(apply_errata(data, rs), rs)
    files = {}
    render_oracles(doc, files)
    render_truths(doc, files)
    render_moves(doc, files)
    render_assets(doc, files)
    render_oracle_index(doc, files)
    for render in RENDERERS[rs.key]:
        render(doc, files)
    for rel, text in files.items():
        if not rel.startswith((rs.adapter_dir + "/", rs.fixtures_dir + "/")):
            raise ValueError(f"{rel} is outside {rs.adapter_dir} and {rs.fixtures_dir}")
        if "datasworn:" in text or "{{table>" in text:     # a field rendered without convert_links
            raise ValueError(f"{rel}: unconverted datasworn reference or template")
    return files


def owned_files(root, rs):
    """The generated files currently in the tree under root for rs: {relpath: content}."""
    found = {}
    adapter = os.path.join(root, rs.adapter_dir)
    for dirpath, _dirs, names in os.walk(adapter):
        for n in names:
            if n.endswith(".md"):
                p = os.path.join(dirpath, n)
                with open(p, encoding="utf-8") as fh:
                    text = fh.read()
                if text.startswith(MARKER):
                    found[os.path.relpath(p, root)] = text
    fixtures = os.path.join(root, rs.fixtures_dir)
    for dirpath, _dirs, names in os.walk(fixtures):
        for n in names:
            if n.endswith(".json"):    # not .DS_Store and the like
                p = os.path.join(dirpath, n)
                with open(p, encoding="utf-8") as fh:
                    found[os.path.relpath(p, root)] = fh.read()
    return found


def fetch(url, attempts=3):
    for attempt in range(1, attempts + 1):
        try:
            with urllib.request.urlopen(url, timeout=120) as resp:
                return resp.read()
        except (OSError, http.client.HTTPException) as e:   # URLError, timeouts, IncompleteRead
            if attempt == attempts:
                sys.exit(f"datasworn-import: couldn't fetch {url}: {e}")
            time.sleep(5 * attempt)


def load(json_path, rs, cache_dir=None):
    """rs's pinned upstream document: from --json, else from the cache dir, else fetched
    (and then cached). Whatever the source, it must hash to the pin."""
    cached = os.path.join(cache_dir, f"{rs.sha256}.json") if cache_dir else None
    if json_path or (cached and os.path.isfile(cached)):
        with open(json_path or cached, "rb") as fh:
            raw = fh.read()
    else:
        raw = fetch(rs.url)
    digest = hashlib.sha256(raw).hexdigest()
    if digest != rs.sha256:
        sys.exit(f"datasworn-import: {rs.upstream_path} sha256 {digest} doesn't match the pin {rs.sha256} "
                 f"({UPSTREAM_REPO}@{UPSTREAM_REF}); move the pin deliberately (see --help)")
    if cached and not os.path.isfile(cached):
        os.makedirs(cache_dir, exist_ok=True)
        with open(cached, "wb") as fh:
            fh.write(raw)
    return json.loads(raw)


def clashes(root, files, rs):
    """The generated paths that would overwrite a file the tool didn't write."""
    old = owned_files(root, rs)
    return [rel for rel in sorted(files) if os.path.exists(os.path.join(root, rel)) and rel not in old]


def write(root, files, rs):
    old = owned_files(root, rs)
    for rel in clashes(root, files, rs):
        sys.exit(f"datasworn-import: {rel} exists and isn't generated; move it before regenerating")
    for rel in old:
        os.remove(os.path.join(root, rel))
    for rel, text in sorted(files.items()):
        p = os.path.join(root, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(text)
    removed = sorted(set(old) - set(files))
    # Prune only directories a removed file leaves empty, up to (not including) its base.
    for rel in removed:
        base = os.path.join(root, rs.fixtures_dir if rel.startswith(rs.fixtures_dir + "/") else rs.adapter_dir)
        d = os.path.dirname(os.path.join(root, rel))
        while d != base and os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
            d = os.path.dirname(d)
    print(f"datasworn-import: {rs.key}: wrote {len(files)} files" + (f", removed {len(removed)}" if removed else ""))


def check(root, files, rs, sheet_problems=()):
    """Print how the tree differs from files for rs (and the sheet's missing data lines),
    and return the problems ([] when in sync)."""
    old = owned_files(root, rs)
    problems = [f"missing   {rel}" for rel in sorted(set(files) - set(old))]
    problems += [f"stale     {rel}" for rel in sorted(set(old) - set(files))]
    problems += [f"differs   {rel}" for rel in sorted(set(files) & set(old)) if files[rel] != old[rel]]
    problems += list(sheet_problems)
    if problems:
        print("\n".join(problems))
        print(f"datasworn-import --check: {rs.key}: {len(problems)} problem(s): generated files out of "
              "date or sheet lines missing")
    else:
        print(f"datasworn-import --check: {rs.key}: {len(files)} generated files and the sheet's data lines "
              f"match {UPSTREAM_REPO}@{UPSTREAM_REF[:7]}")
    return problems


def main(argv=None):
    ap = argparse.ArgumentParser(prog="datasworn-import", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--ruleset", choices=sorted(RULESETS), help="just this ruleset (default: all of them)")
    ap.add_argument("--json", help="a local copy of the ruleset's pinned file (default: fetch it); needs --ruleset")
    ap.add_argument("--check", action="store_true", help="diff instead of writing; exit 1 on drift")
    ap.add_argument("--cache", metavar="DIR",
                    help="keep each fetched file in DIR (by its sha256) and reuse it next time")
    ap.add_argument("--root", default=PLUGIN, help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    if a.json and not a.ruleset:
        ap.error("--json needs --ruleset")
    # Load and generate every ruleset first, so a bad pin or fetch writes nothing.
    trees = []
    for key in [a.ruleset] if a.ruleset else sorted(RULESETS):
        rs = RULESETS[key]
        data = load(a.json, rs, a.cache)
        trees.append((rs, generate(data, rs), check_sheet(a.root, data, rs)))
    if a.check:
        if sum(len(check(a.root, files, rs, sheet)) for rs, files, sheet in trees):
            sys.exit("datasworn-import --check: out of date; re-run datasworn-import, fix a sheet by hand")
        return
    for rs, files, _sheet in trees:     # every clash first, so one ruleset's can't stop a half-done write
        for rel in clashes(a.root, files, rs):
            sys.exit(f"datasworn-import: {rel} exists and isn't generated; move it before regenerating")
    for rs, files, _sheet in trees:
        write(a.root, files, rs)
    missing = [line for _rs, _files, sheet in trees for line in sheet]
    if missing:                      # regenerated, but a hand-written sheet needs a fix
        print("\n".join(missing))
        sys.exit(f"datasworn-import: a sheet is missing {len(missing)} data line(s); edit it by hand")


if __name__ == "__main__":
    main()
