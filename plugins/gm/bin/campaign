#!/usr/bin/env python3
"""gm campaign git manager — versioned saves in the player's own space.

  campaign init <dir> [--author NAME] [--email EMAIL]
  campaign checkpoint <dir> [--label TEXT]
  campaign log <dir>
  campaign rewind <dir> --to <ref>
  campaign backup <dir>

  campaign gm-clock <dir> <id> [--segments N] [--advance N] [--set N]
  campaign gm-seal <dir> <id> [text | --from FILE]   # text from arg, FILE (consumed), or stdin
  campaign gm-reveal <dir> [id]
  campaign gm-list <dir>
  campaign gm-migrate <dir>                 # seal any plaintext left under .gm/

  campaign bind <dir> [--session ID]        # autosave this session's play into <dir>
  campaign unbind [--session ID]
  campaign unwrapped <dir>                  # raw play not yet summarized by /gm:wrap
  campaign mark-wrapped <dir> <log-file>
  campaign hook-session-start               # plugin hooks (payload on stdin)
  campaign hook-autosave

A campaign dir gets its own dedicated git repo (marked by a .gm-campaign file),
UNLESS it is already inside another repo (e.g. an Obsidian vault under git) — then
gm DEFERS and never commits, leaving history to your existing setup. Checkpoints are
ordinary commits; rewind restores a past checkpoint as a new (reversible) commit.

Autosave: once a session is bound to a campaign (`bind`, run by /gm:play and
/gm:new-campaign), the plugin's Stop hook appends each turn's player prompt and GM
narration to <dir>/log/raw/ and checkpoints it, so the play record never depends on
the model remembering /gm:wrap or on Claude Code keeping its transcript.

The gm-* subcommands keep hidden GM state (secret clocks, sealed answers) in a .gm/
dir, SEALED at rest (lib/gm_screen.py: zlib + base64 — noise to a glance, not
encryption). Claude Code shows a diff of every file a Bash command changes, so a
plaintext .gm/ would spoil the player on every write; sealed, the diff is noise. Writes
print a neutral confirmation, never the value; gm-reveal surfaces a secret when the
fiction earns it. A secret's text must never be in a command either: the gm:screen
subagent composes it and seals it (`gm-seal --from <draft>`), out of the player's view.
"""
import argparse
import contextlib
import datetime
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
import traceback

try:
    import fcntl
except ImportError:
    fcntl = None

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import gm_screen  # noqa: E402

MARKER = ".gm-campaign"


def git(d, *args, check=True, capture=True):
    return subprocess.run(["git", "-C", d, *args], text=True,
                          capture_output=capture, check=check)


def toplevel(d):
    r = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                       text=True, capture_output=True)
    return r.stdout.strip() if r.returncode == 0 else None


def is_managed(d):
    return os.path.isfile(os.path.join(d, MARKER))


def _staged_changes(d):
    return git(d, "diff", "--cached", "--quiet", check=False).returncode != 0


def cmd_init(a):
    os.makedirs(a.dir, exist_ok=True)
    top = toplevel(a.dir)
    if top:
        if os.path.realpath(top) != os.path.realpath(a.dir):
            print(f"deferred: {a.dir} is inside an existing git repo at {top}; "
                  f"gm will not manage git here (your own setup owns history)")
            return
        if not is_managed(a.dir):
            print(f"refusing: {a.dir} is already a git repo gm did not create; "
                  f"gm will not commit here. Use a fresh directory for a gm-managed campaign.")
            return
        print(f"already a gm campaign repo: {a.dir}")
        return
    git(a.dir, "init", "-q")
    git(a.dir, "config", "user.name", a.author or "gm")
    git(a.dir, "config", "user.email", a.email or "gm@localhost")
    git(a.dir, "config", "commit.gpgsign", "false")  # never block play on a signing prompt
    with open(os.path.join(a.dir, MARKER), "w") as f:
        f.write("gm campaign\n")
    git(a.dir, "add", "-A")
    git(a.dir, "commit", "-q", "-m", "gm: start campaign")
    print(f"initialised gm campaign repo: {a.dir}")


def _require_managed(d):
    if not is_managed(d):
        print(f"not a gm-managed repo (deferred or uninitialised): {d}")
        sys.exit(0)  # deferred is a normal state, not an error


def _stage_all(d):
    """Stage everything but the gm:screen subagent's drafts (plaintext, and gone once
    sealed: never history) and the screen's lock, which .gm/.gitignore leaves out."""
    gm_screen.ignore_drafts(os.path.join(d, gm_screen.SCREEN_DIR))
    git(d, "add", "-A")


def _commit_all(d, label):
    """Stage everything and commit it; False when there was nothing to commit."""
    _stage_all(d)
    if not _staged_changes(d):
        return False
    git(d, "commit", "-q", "-m", label)
    return True


def cmd_checkpoint(a):
    _require_managed(a.dir)
    if not _commit_all(a.dir, a.label or "checkpoint"):
        print("nothing to checkpoint")
        return
    print(f"checkpoint: {a.label or 'checkpoint'}")


def cmd_log(a):
    _require_managed(a.dir)
    print(git(a.dir, "log", "--oneline", "-20").stdout, end="")


def cmd_rewind(a):
    _require_managed(a.dir)
    if git(a.dir, "rev-parse", "--verify", "--quiet", f"{a.to}^{{commit}}", check=False).returncode != 0:
        print(f"no such checkpoint: {a.to}")
        return
    _commit_all(a.dir, "checkpoint before rewind")
    # make the index + working tree match the target EXACTLY (removes files added since),
    # without moving HEAD — so the rewind lands as a new, reversible commit.
    git(a.dir, "read-tree", "-u", "--reset", a.to)
    # A checkpoint from before sealing restores a plaintext .gm/: seal it within this
    # same command, so the Bash edit-diff shows noise rather than the restored secrets.
    gm_screen.sweep(a.dir)
    _stage_all(a.dir)
    if not _staged_changes(a.dir):
        print(f"already at {a.to}; nothing to rewind")
        return
    git(a.dir, "commit", "-q", "-m", f"rewind to {a.to}")
    print(f"rewound to {a.to}")


def cmd_backup(a):
    _require_managed(a.dir)
    if not git(a.dir, "remote").stdout.strip():
        print("no remote configured; add one with: "
              f"git -C {a.dir} remote add origin <url>")
        return
    git(a.dir, "push", check=False, capture=False)
    print("backup pushed")


# ---- GM screen: hidden state under a sealed .gm/ dir -------------------------
# Every file under .gm/ is sealed at rest (lib/gm_screen.py), so the Bash edit-diff
# view, `cat` or an editor shows noise; reads accept legacy plaintext, and the next
# write (or `gm-migrate`, or the hooks' sweep) seals it. Writers hold the screen's
# lock (gm_screen.locked), so the sweep never races a write. Independent of git
# management: works in deferred campaigns too; a managed campaign commits .gm/ with
# the next checkpoint.

GM_DIR = gm_screen.SCREEN_DIR


def _gm_state_path(d):
    return os.path.join(d, GM_DIR, "state.json")


def _gm_load(d):
    p = _gm_state_path(d)
    state = json.loads(gm_screen.read(p)) if os.path.isfile(p) else {}
    state.setdefault("clocks", {})
    state.setdefault("secrets", {})
    return state


def _gm_save(d, state):
    gm_screen.write(_gm_state_path(d), json.dumps(state, indent=2, sort_keys=True) + "\n")


def _gm_screen(d):
    return os.path.join(d, GM_DIR)


def cmd_gm_clock(a):
    with gm_screen.locked(_gm_screen(a.dir)):
        state = _gm_load(a.dir)
        clocks = state["clocks"]
        created = a.id not in clocks
        c = clocks.setdefault(a.id, {"filled": 0, "segments": a.segments or 4})
        if a.segments is not None:
            c["segments"] = a.segments
        if a.set is not None:
            c["filled"] = a.set
        if a.advance is not None:
            c["filled"] += a.advance
        c["filled"] = max(0, min(c["filled"], c["segments"]))
        _gm_save(a.dir, state)
    # Neutral confirmation — never the fill value. Completion IS surfaced: the GM
    # must know a hidden clock just filled (it's about to act on the fiction).
    status = " (complete)" if c["filled"] >= c["segments"] else ""
    print(f"gm: clock '{a.id}' {'sealed' if created else 'updated'}{status}")


def cmd_gm_seal(a):
    if a.text is not None and a.from_file is not None:
        sys.exit("campaign: gm-seal takes the text as an argument or --from FILE, not both")
    text = a.text if a.text is not None or a.from_file is not None else sys.stdin.read()
    with gm_screen.locked(_gm_screen(a.dir)):
        if a.from_file is not None:
            # The gm:screen subagent's draft: read it (sealed or not), seal it, delete
            # it, so its plaintext never outlives this command.
            text = gm_screen.read(a.from_file)
        state = _gm_load(a.dir)
        state["secrets"][a.id] = text.rstrip("\n")
        _gm_save(a.dir, state)
        if a.from_file is not None:
            os.remove(a.from_file)
    print(f"gm: '{a.id}' sealed")


def cmd_gm_reveal(a):
    state = _gm_load(a.dir)
    if a.id is not None:
        if a.id in state["secrets"]:
            print(state["secrets"][a.id])
        elif a.id in state["clocks"]:
            c = state["clocks"][a.id]
            print(f"clock '{a.id}': {c['filled']}/{c['segments']}")
        else:
            print(f"gm: nothing sealed under '{a.id}'")
        return
    if not state["clocks"] and not state["secrets"]:
        print("gm: nothing sealed")
        return
    for cid, c in sorted(state["clocks"].items()):
        print(f"clock '{cid}': {c['filled']}/{c['segments']}")
    for sid, text in sorted(state["secrets"].items()):
        print(f"secret '{sid}': {text}")


def cmd_gm_migrate(a):
    n, dropped = gm_screen.sweep(a.dir)
    done = []
    if n:
        done.append(f"sealed {n} plaintext file{'' if n == 1 else 's'} behind the screen")
    if dropped:
        done.append(f"dropped {dropped} stale draft{'' if dropped == 1 else 's'}")
    print("gm: " + "; ".join(done) if done else "gm: nothing to seal — the screen is already sealed")


def cmd_gm_list(a):
    state = _gm_load(a.dir)
    items = ([("clock", k) for k in sorted(state["clocks"])]
             + [("secret", k) for k in sorted(state["secrets"])])
    if not items:
        print("gm: nothing sealed")
        return
    for kind, k in items:
        print(f"{kind}: {k}")


# ---- Autosave: raw play log + per-turn checkpoint ---------------------------
# The plugin's Stop hook (hooks/hooks.json -> hook-autosave) appends each turn's
# player prompts and GM narration to <campaign>/log/raw/ and checkpoints them. A
# session opts in by binding (`bind`, run by /gm:play and /gm:new-campaign). The
# binding is keyed by session id under the plugin's data dir, because play often
# runs from a parent directory, so the hook can't infer the campaign from its cwd.

RAW_DIR = os.path.join("log", "raw")
WRAP_MARK = "<!-- gm:wrapped {} -->"
WRAP_RE = re.compile(r"^<!-- gm:wrapped .*-->[ \t]*$")
SESSION_RE = re.compile(r"^[A-Za-z0-9_-][A-Za-z0-9._-]*$")
BINDING_TTL_DAYS = 30


def _data_dir():
    # Hooks see CLAUDE_PLUGIN_DATA; the Bash tool doesn't, so hook-session-start
    # exports the same dir to it as GM_DATA_DIR.
    d = os.environ.get("GM_DATA_DIR") or os.environ.get("CLAUDE_PLUGIN_DATA")
    if d:
        return d
    config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    return os.path.join(config, "plugins", "data", "gm")


def _valid_session(sid):
    # Session ids become file names: nothing that could traverse out of sessions/.
    return isinstance(sid, str) and bool(SESSION_RE.match(sid)) and ".." not in sid


def _binding_path(sid):
    return os.path.join(_data_dir(), "sessions", sid + ".json")


def _load_binding(sid):
    try:
        with open(_binding_path(sid), encoding="utf-8") as f:
            b = json.load(f)
    except (OSError, ValueError):
        return None
    return b if isinstance(b, dict) else None


def _save_binding(sid, binding):
    p = _binding_path(sid)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(binding, f, indent=2, sort_keys=True)
            f.write("\n")
        os.replace(tmp, p)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _now_utc():
    return datetime.datetime.now(datetime.timezone.utc)


def _parse_time(ts):
    try:
        t = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return None
    return t if t.tzinfo else None


AUTOSAVE_UNAVAILABLE = ("gm: autosave unavailable — the gm plugin's SessionStart hook hasn't "
                        "run in this session (no GM_SESSION_ID / GM_DATA_DIR); /gm:wrap still "
                        "saves the story")


def _cli_session(explicit):
    """This session's id for the Bash-side commands, or None when a binding couldn't
    reach the Stop hook. Only gm's own SessionStart export counts: it brings the data
    dir along (GM_DATA_DIR), and the fallback in _data_dir() is not the dir Claude
    Code assigns the plugin (<plugin>-<marketplace>) — nor would another plugin's
    CLAUDE_SESSION_ID come with one."""
    sid = explicit or os.environ.get("GM_SESSION_ID")
    if _valid_session(sid) and (os.environ.get("GM_DATA_DIR") or os.environ.get("CLAUDE_PLUGIN_DATA")):
        return sid
    return None


def _campaign_path(d):
    """The canonical form a binding stores, so `~/rpg/x` (quoted) and symlinks compare equal."""
    return os.path.realpath(os.path.expanduser(d))


def cmd_bind(a):
    sid = _cli_session(a.session)
    if not sid:
        print(AUTOSAVE_UNAVAILABLE)
        return
    d = _campaign_path(a.dir)
    if not os.path.isfile(os.path.join(d, "campaign.md")):
        sys.exit(f"campaign: {d} has no campaign.md — not a gm campaign")
    binding = _load_binding(sid) or {}
    # Rebinding keeps the transcript offset, so switching campaigns mid-session
    # doesn't re-log earlier turns into the new one.
    binding.update(campaign=d, bound_at=_now_utc().isoformat())
    _save_binding(sid, binding)
    how = ("logged to log/raw/ and checkpointed" if is_managed(d)
           else "logged to log/raw/ (saves deferred: no commits)")
    print(f"gm: autosave on for {d} — each turn {how}")


def cmd_unbind(a):
    sid = _cli_session(a.session)
    if not sid:
        print(AUTOSAVE_UNAVAILABLE)
        return
    try:
        os.remove(_binding_path(sid))
    except FileNotFoundError:
        print("gm: autosave was not on for this session")
        return
    print("gm: autosave off for this session")


# -- reading the transcript: what the player saw, never tool traffic --

_REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
_COMMAND_RE = re.compile(r"<command-name>(.*?)</command-name>", re.S)
_ARGS_RE = re.compile(r"<command-args>(.*?)</command-args>", re.S)
# Harness traffic arriving as a user message is wholly wrapped in hyphenated tags
# (<task-notification>, <local-command-stdout>, <bash-input>, ...). A player's own
# markup (<ooc>…</ooc>, <i>…</i>) has no hyphen, so it stays a prompt.
_TAGGED_ONLY_RE = re.compile(r"\s*(?:<([A-Za-z]\w*(?:-\w+)+)\b[^>]*>.*?</\1>\s*)+", re.S)


def _prompt_text(content):
    """The player's words in a user message, or None for harness traffic."""
    if isinstance(content, list):
        parts = []
        for b in content:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_result":
                return None
            if b.get("type") == "text":
                parts.append(_REMINDER_RE.sub("", b.get("text") or "").strip())
            elif b.get("type") == "image":
                parts.append("[image]")
        text = "\n\n".join(p for p in parts if p)
    elif isinstance(content, str):
        text = _REMINDER_RE.sub("", content).strip()
    else:
        return None
    command = _COMMAND_RE.search(text)
    if command:  # a slash command: log what the player typed, not the wrapper
        name = command.group(1).strip()
        if not name.startswith("/gm:"):
            return None  # /compact, /model, another plugin's command: not play
        args = _ARGS_RE.search(text)
        return " ".join(s for s in (name, args.group(1).strip() if args else "") if s)
    if not text or text.startswith("[Request interrupted"):
        return None
    if text.startswith("<") and _TAGGED_ONLY_RE.fullmatch(text):
        return None
    return text


def _turn_block(e):
    """("Player"|"GM", text) for a transcript entry the player saw, else None.

    GM blocks are the assistant's text only: thinking, tool calls, and tool results
    never reach the raw log, so nothing written behind the GM screen leaks into it."""
    if not isinstance(e, dict) or e.get("isSidechain") or e.get("isMeta"):
        return None
    kind = e.get("type")
    if kind == "user" and not e.get("isCompactSummary"):
        text = _prompt_text((e.get("message") or {}).get("content"))
        return ("Player", text) if text else None
    if kind == "attachment":
        at = e.get("attachment") or {}
        # A prompt typed while the GM is mid-turn is recorded only as this attachment.
        if (at.get("type") == "queued_command" and not at.get("isMeta")
                and (at.get("origin") or {}).get("kind", "human") == "human"
                and at.get("commandMode", "prompt") == "prompt"):
            text = _prompt_text(at.get("prompt"))
            return ("Player", text) if text else None
        return None
    if kind == "assistant" and not e.get("isApiErrorMessage"):
        msg = e.get("message") or {}
        if msg.get("model") == "<synthetic>":
            return None
        content = msg.get("content")
        if isinstance(content, str):
            texts = [content]
        elif isinstance(content, list):
            texts = [b.get("text") or "" for b in content
                     if isinstance(b, dict) and b.get("type") == "text"]
        else:
            return None
        text = "\n\n".join(t.strip() for t in texts if t.strip())
        return ("GM", text) if text else None
    return None


def _parse_line(line):
    try:
        return json.loads(line)
    except ValueError:
        return None


def _entry_time(line):
    e = _parse_line(line)
    return _parse_time(e.get("timestamp")) if isinstance(e, dict) else None


def _start_index(lines, binding):
    """Where to start reading `lines` (a whole transcript) when there's no usable offset."""
    through = _parse_time(binding.get("logged_through"))
    if through:
        # The session's transcript moved or was rewritten (a new path, or shorter than
        # the offset): pick up after the last entry already logged, not from the bind.
        for i, line in enumerate(lines):
            ts = _entry_time(line)
            if ts and ts > through:
                return i
        return len(lines)
    # First autosave: the prompt of the turn that bound the session (the last prompt
    # at or before the bind), else the latest prompt.
    bound_at = _parse_time(binding.get("bound_at"))
    latest = before_bind = None
    for i, line in enumerate(lines):
        e = _parse_line(line)
        if isinstance(e, dict) and e.get("type") == "user" and _turn_block(e):
            latest = i
            ts = _parse_time(e.get("timestamp"))
            if ts and bound_at and ts <= bound_at:
                before_bind = i
    return before_bind if before_bind is not None else (latest or 0)


def _read_new_blocks(transcript, binding):
    """The blocks appended since the binding's last read, plus the progress to record.

    Only complete lines count: one still being written waits for the next run, as does
    narration that isn't in the file yet (see _await_turn_end) — it lands with the next
    turn or SessionEnd."""
    offset = binding.get("offset") if binding.get("transcript") == transcript else None
    if not isinstance(offset, int) or isinstance(offset, bool) or offset < 0:
        offset = None
    with open(transcript, "rb") as f:
        size = f.seek(0, os.SEEK_END)
        if offset is not None and offset > size:
            offset = None
        base = offset or 0
        f.seek(base)
        data = f.read()
    data = data[:data.rfind(b"\n") + 1]
    lines = data.splitlines(keepends=True)
    start = 0 if offset is not None else _start_index(lines, binding)
    blocks = [b for b in (_turn_block(_parse_line(ln)) for ln in lines[start:]) if b]
    progress = {"transcript": transcript, "offset": base + len(data)}
    through = next((ts for ts in map(_entry_time, reversed(lines)) if ts), None)
    if through:
        progress["logged_through"] = through.isoformat()
    return blocks, progress


TURN_END_WAIT = 2.0  # seconds a Stop hook waits for the turn's closing message to land


def _turn_ended(transcript):
    """Whether the transcript's last message is the assistant's closing one: text, no
    tool call. Claude Code can fire Stop before it writes that message."""
    with open(transcript, "rb") as f:
        size = f.seek(0, os.SEEK_END)
        f.seek(max(0, size - 1024 * 1024))
        tail = f.read()
    for line in reversed(tail.splitlines()):
        e = _parse_line(line)
        if isinstance(e, dict) and e.get("type") in ("user", "assistant") and not e.get("isSidechain"):
            content = (e.get("message") or {}).get("content")
            kinds = {b.get("type") for b in content if isinstance(b, dict)} if isinstance(content, list) else {"text"}
            return e["type"] == "assistant" and "text" in kinds and "tool_use" not in kinds
    return True  # nothing recognizable to wait for


def _await_turn_end(transcript):
    deadline = time.monotonic() + TURN_END_WAIT
    while not _turn_ended(transcript) and time.monotonic() < deadline:
        time.sleep(0.1)


def _render(blocks):
    merged = []
    for role, text in blocks:
        if merged and merged[-1][0] == role:
            merged[-1][1].append(text)
        else:
            merged.append((role, [text]))
    return "".join(f"### {role}\n\n" + "\n\n".join(texts) + "\n\n" for role, texts in merged)


def _append_raw(d, sid, text, now):
    p = os.path.join(d, RAW_DIR, f"{now:%Y-%m-%d}-{sid[:8]}.md")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    fresh = not os.path.exists(p)
    with open(p, "a", encoding="utf-8") as f:
        if fresh:
            f.write(f"# Raw play log — {now:%Y-%m-%d} (session {sid[:8]})\n\n"
                    "<!-- Written by gm's Stop hook after every turn: the player's prompts and "
                    "the GM's narration, never tool calls or their output. /gm:wrap summarizes "
                    "it into log/NNNN-<title>.md. -->\n\n")
        f.write(text)
    return p


def _autosave_label(blocks):
    """`autosave: <the turn's prompt>` — the latest one when a run catches up several."""
    prompts = [text for role, text in blocks if role == "Player"]
    if not prompts:
        return "autosave: (narration)"
    latest = prompts[-1].strip().splitlines()[0].strip()
    return "autosave: " + (latest if len(latest) <= 60 else latest[:59].rstrip() + "…")


@contextlib.contextmanager
def _campaign_lock(d):
    """One autosave at a time per campaign: Stop and SessionEnd can overlap, and so can
    two sessions bound to one campaign (one git index between them)."""
    if fcntl is None:  # not POSIX: autosaves just aren't serialized
        yield
        return
    locks = os.path.join(_data_dir(), "locks")
    os.makedirs(locks, exist_ok=True)
    name = hashlib.sha256(d.encode("utf-8")).hexdigest()[:16] + ".lock"
    with open(os.path.join(locks, name), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def _autosave(payload):
    sid = payload.get("session_id")
    if not _valid_session(sid):
        return
    binding = _load_binding(sid)
    if not binding:
        return  # unbound session: strict no-op
    d = binding.get("campaign")
    transcript = payload.get("transcript_path")
    if not (isinstance(d, str) and os.path.isfile(os.path.join(d, "campaign.md"))):
        raise RuntimeError(f"bound campaign has no campaign.md: {d}")
    if not (isinstance(transcript, str) and os.path.isfile(transcript)):
        raise RuntimeError(f"no transcript at {transcript}")
    if payload.get("hook_event_name") == "Stop":
        _await_turn_end(transcript)
    with _campaign_lock(d):
        # Re-read under the lock: an overlapping run may have advanced the offset.
        binding = _load_binding(sid)
        if not binding or binding.get("campaign") != d:
            return
        blocks, progress = _read_new_blocks(transcript, binding)
        if blocks:
            _append_raw(d, sid, _render(blocks), datetime.datetime.now())
        swept = _sweep_screen(d, "hook-autosave")
        wrap = binding.pop("wrap_pending", None)
        remarked = []
        if isinstance(wrap, dict) and wrap.get("campaign") == d:
            # /gm:wrap ran this turn: its marker went in mid-turn, and the wrap turn
            # itself was just logged below it. Mark again so it isn't left unwrapped.
            remarked = _mark_wrapped([p for p in _raw_logs(d) if _own_raw_log(p, sid)],
                                     str(wrap.get("label")))
        # Record progress before committing: a failed commit must not re-log the turn
        # (the next turn's checkpoint picks the log up anyway).
        binding.update(progress)
        _save_binding(sid, binding)
        if (blocks or remarked or swept) and is_managed(d):  # deferred saves: log, never commit
            _commit_all(d, _autosave_label(blocks) if blocks or remarked else "gm: seal the screen")


def _hook_payload():
    try:
        p = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return {}
    return p if isinstance(p, dict) else {}


def _log_hook_error(where):
    """Hook failures go to <data>/autosave.log, never to the turn."""
    try:
        p = os.path.join(_data_dir(), "autosave.log")
        os.makedirs(os.path.dirname(p), exist_ok=True)
        if os.path.isfile(p) and os.path.getsize(p) > 256 * 1024:
            os.replace(p, p + ".1")
        with open(p, "a", encoding="utf-8") as f:
            f.write(f"--- {datetime.datetime.now().isoformat(timespec='seconds')} {where}\n"
                    f"{traceback.format_exc()}")
    except Exception:
        pass


def _sweep_screen(d, where):
    """Seal any plaintext left under <d>/.gm/ from an older version, and drop a draft a
    crashed gm:screen subagent left (lib/gm_screen.py: sweep). Hooks run outside every
    tool call, so no diff view shows the plaintext going away. Returns how many files
    were sealed; a failure is logged and never costs the turn."""
    try:
        return gm_screen.sweep(d)[0]
    except Exception:
        _log_hook_error(where + " (sealing .gm/)")
        return 0


def cmd_hook_autosave(a):
    # Stop (every turn) and SessionEnd. Never fails or blocks the turn: always exit 0
    # and print nothing, since a Stop hook's stdout can be read as a decision.
    try:
        _autosave(_hook_payload())
    except Exception:
        _log_hook_error("hook-autosave")


def _gc_bindings(keep):
    sessions = os.path.join(_data_dir(), "sessions")
    if os.path.isfile(keep):
        os.utime(keep)  # a live session's binding never ages out under it
    cutoff = time.time() - BINDING_TTL_DAYS * 86400
    try:
        names = os.listdir(sessions)
    except OSError:
        return
    for n in names:
        p = os.path.join(sessions, n)
        try:
            if n.endswith(".json") and os.path.getmtime(p) < cutoff:
                os.remove(p)
        except OSError:
            pass


def cmd_hook_session_start(a):
    # Hands the session id (and the data dir, which only hooks know) to the Bash tool
    # so `campaign bind` can key the binding the Stop hook will look up. /clear starts
    # a new session id with no binding (the model forgot the game too; /gm:play binds
    # it again). For a bound session (resume, compaction) also re-names the active
    # campaign as context.
    try:
        payload = _hook_payload()
        sid = payload.get("session_id")
        if not _valid_session(sid):
            return
        env_file = os.environ.get("CLAUDE_ENV_FILE")
        if env_file:
            with open(env_file, "a", encoding="utf-8") as f:
                f.write(f"export GM_SESSION_ID={shlex.quote(sid)}\n"
                        f"export GM_DATA_DIR={shlex.quote(_data_dir())}\n")
        _gc_bindings(_binding_path(sid))
        binding = _load_binding(sid)
        if binding and isinstance(binding.get("campaign"), str):
            d = binding["campaign"]
            if os.path.isdir(d):
                _sweep_screen(d, "hook-session-start")
            print(f"gm autosave: this session is bound to the campaign at {d} — every turn's "
                  f"player prompt and GM narration is logged to {os.path.join(d, RAW_DIR)}/ "
                  f"automatically. It is the active campaign for /gm:wrap, /gm:checkpoint, "
                  f"and /gm:rewind.")
    except Exception:
        _log_hook_error("hook-session-start")


# -- /gm:wrap: what the raw log holds that no session log summarizes yet --

def _raw_logs(d):
    rd = os.path.join(d, RAW_DIR)
    try:
        names = sorted(n for n in os.listdir(rd) if n.endswith(".md"))
    except OSError:
        return []
    return [os.path.join(rd, n) for n in names]


def _unwrapped_range(p):
    """1-based (first, last) lines after the file's last wrap marker, if any play is there."""
    with open(p, encoding="utf-8") as f:
        lines = f.read().splitlines()
    start = 0
    for i, line in enumerate(lines):
        if WRAP_RE.match(line):
            start = i + 1
    if not any(line.startswith("### ") for line in lines[start:]):
        return None
    return start + 1, len(lines)


def cmd_unwrapped(a):
    found = False
    for p in _raw_logs(os.path.expanduser(a.dir)):
        r = _unwrapped_range(p)
        if r:
            found = True
            print(f"{p}:{r[0]}-{r[1]}")
    if not found:
        print("gm: no unwrapped play in log/raw/")


def _own_raw_log(p, sid):
    return os.path.basename(p).endswith(f"-{sid[:8]}.md")


def _mark_wrapped(paths, label):
    marked = []
    for p in paths:
        if _unwrapped_range(p):
            with open(p, "a", encoding="utf-8") as f:
                f.write(WRAP_MARK.format(label) + "\n\n")
            marked.append(os.path.basename(p))
    return marked


def cmd_mark_wrapped(a):
    label = " ".join(a.log.split()).replace("-->", "")  # keep the marker one well-formed line
    # Mark now, so the wrap's named checkpoint (taken later this turn) carries the marker.
    marked = _mark_wrapped(_raw_logs(os.path.expanduser(a.dir)), label)
    sid = _cli_session(None)
    binding = _load_binding(sid) if sid else None
    d = _campaign_path(a.dir)
    note = ""
    if binding and binding.get("campaign") == d:
        # This turn — the wrap itself — reaches the raw log only when the Stop hook runs,
        # below this marker. Have the hook mark again after it, so the wrap turn isn't
        # left over as play no session log covers.
        binding["wrap_pending"] = {"campaign": d, "label": label}
        _save_binding(sid, binding)
        note = "; this turn is marked too once it's saved"
    if marked:
        print(f"gm: marked wrapped into {label}: {', '.join(marked)}{note}")
    else:
        print(f"gm: nothing to mark — no unwrapped play in log/raw/{note}")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="campaign")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init"); p.add_argument("dir"); p.add_argument("--author"); p.add_argument("--email")
    p = sub.add_parser("checkpoint"); p.add_argument("dir"); p.add_argument("--label")
    p = sub.add_parser("log"); p.add_argument("dir")
    p = sub.add_parser("rewind"); p.add_argument("dir"); p.add_argument("--to", required=True)
    p = sub.add_parser("backup"); p.add_argument("dir")
    p = sub.add_parser("gm-clock"); p.add_argument("dir"); p.add_argument("id")
    p.add_argument("--segments", type=int); p.add_argument("--advance", type=int); p.add_argument("--set", type=int)
    p = sub.add_parser("gm-seal"); p.add_argument("dir"); p.add_argument("id"); p.add_argument("text", nargs="?")
    p.add_argument("--from", dest="from_file", metavar="FILE")
    p = sub.add_parser("gm-reveal"); p.add_argument("dir"); p.add_argument("id", nargs="?")
    p = sub.add_parser("gm-list"); p.add_argument("dir")
    p = sub.add_parser("gm-migrate"); p.add_argument("dir")
    p = sub.add_parser("bind"); p.add_argument("dir"); p.add_argument("--session")
    p = sub.add_parser("unbind"); p.add_argument("--session")
    p = sub.add_parser("unwrapped"); p.add_argument("dir")
    p = sub.add_parser("mark-wrapped"); p.add_argument("dir"); p.add_argument("log")
    sub.add_parser("hook-session-start")
    sub.add_parser("hook-autosave")
    a = ap.parse_args(argv)
    try:
        {"init": cmd_init, "checkpoint": cmd_checkpoint, "log": cmd_log,
         "rewind": cmd_rewind, "backup": cmd_backup,
         "gm-clock": cmd_gm_clock, "gm-seal": cmd_gm_seal,
         "gm-reveal": cmd_gm_reveal, "gm-list": cmd_gm_list, "gm-migrate": cmd_gm_migrate,
         "bind": cmd_bind, "unbind": cmd_unbind,
         "unwrapped": cmd_unwrapped, "mark-wrapped": cmd_mark_wrapped,
         "hook-session-start": cmd_hook_session_start,
         "hook-autosave": cmd_hook_autosave}[a.cmd](a)
    except subprocess.CalledProcessError as e:
        sys.exit(f"campaign: git command failed: {' '.join(e.cmd)}")
    except FileNotFoundError as e:
        sys.exit(f"campaign: {e}")
    except ValueError as e:  # a corrupt sealed file
        sys.exit(f"campaign: {e}")


if __name__ == "__main__":
    main()
