#!/usr/bin/env python3
"""gm forge — harvest a generate reservoir into a rollable table.

  forge harvest [--consume] [--sealed] <reservoir-file> <table-file>

Reads the markdown under the reservoir's `## Reservoir` heading (the diverse pool
`generate` produced) and writes it to <table-file> as a foundation table — one
`- ` entry per candidate, block-rule continuations preserved. The reservoir is
scratch; the table is the durable, rollable artifact.

A table under a campaign's .gm/ (the one next to its campaign.md) is SEALED on disk
(lib/gm_screen.py), so the Bash edit-diff view shows noise, not the entries; `roll
table` reads it all the same. A sealed forge
runs inside the gm:screen subagent with its reservoir drafted under .gm/forge/ and
harvested with --consume, which deletes the reservoir once the table is written — no
plaintext pool outlives the command.
"""
import argparse
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import gm_screen  # noqa: E402

HEADING = re.compile(r"^##\s+", )
RESERVOIR = re.compile(r"^##\s+Reservoir\b", re.I)


def reservoir_block(text):
    """Lines under `## Reservoir`, up to the next `## ` heading, blank-trimmed."""
    out, in_res = [], False
    for line in text.splitlines():
        if RESERVOIR.match(line):
            in_res = True
            continue
        if in_res and HEADING.match(line):
            break
        if in_res:
            out.append(line.rstrip())
    while out and not out[0].strip():
        out.pop(0)
    while out and not out[-1].strip():
        out.pop()
    return out


def cmd_harvest(a):
    if a.consume:
        gm_screen.refuse_link(a.reservoir, "the reservoir")
    if a.consume and os.path.realpath(a.reservoir) == os.path.realpath(a.table):
        sys.exit("forge: --consume would delete the table it just wrote (reservoir and table are one file)")
    block = reservoir_block(gm_screen.read(a.reservoir))
    if not any(line.startswith("- ") for line in block):
        sys.exit(f"forge: no '## Reservoir' entries in {a.reservoir}")
    title = os.path.splitext(os.path.basename(a.table))[0]
    text = f"# {title}\n" + "\n".join(block) + "\n"
    screen = gm_screen.screen_of(a.table)
    if a.sealed and not screen:
        sys.exit(f"forge: --sealed, but {a.table} isn't inside a campaign's .gm/ (the one next "
                 f"to its campaign.md); refusing to write the table in plaintext")
    if screen:
        with gm_screen.locked(screen):  # never while the hooks' sweep is at it
            gm_screen.write(a.table, text)
            if a.consume:
                os.remove(a.reservoir)
    else:
        os.makedirs(os.path.dirname(os.path.abspath(a.table)), exist_ok=True)
        with open(a.table, "w", encoding="utf-8") as f:
            f.write(text)
        if a.consume:
            os.remove(a.reservoir)
    n = sum(1 for line in block if line.startswith("- "))
    print(f"forge: harvested {n} entries -> {a.table}{' (sealed)' if screen else ''}")
    if screen and not a.consume and not gm_screen.screen_of(a.reservoir):
        print(f"forge: warning — the reservoir {a.reservoir} is outside the GM screen and "
              f"still holds the pool in plaintext; delete it (or harvest with --consume)",
              file=sys.stderr)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="forge")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("harvest"); p.add_argument("reservoir"); p.add_argument("table")
    p.add_argument("--sealed", action="store_true",
                   help="refuse unless the table is inside a campaign's .gm/ (sealed forges)")
    p.add_argument("--consume", action="store_true",
                   help="delete the reservoir once the table is written (sealed forges)")
    a = ap.parse_args(argv)
    try:
        {"harvest": cmd_harvest}[a.cmd](a)
    except (OSError, ValueError) as e:
        sys.exit(f"forge: {e}")


if __name__ == "__main__":
    main()
